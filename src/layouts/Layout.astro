---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import {
  SITE_URL,
  SITE_NAME,
  SITE_TAGLINE,
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  SUPPORT_EMAIL,
  SUPPORT_PHONE,
  TECH_SUPPORT_PHONE,
  BOOK_CONSULTATION_URL,
  SOCIAL_LINKS,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Path this page canonically lives at (defaults to the current URL path). */
  canonicalPath?: string;
  /** Path to a social share image (defaults to the shared site preview). */
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}

const {
  title = `${SITE_NAME} — ${SITE_TAGLINE} | Perfex CRM & SaaS Solutions`,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  ogImage = DEFAULT_OG_IMAGE,
  type = 'website',
  jsonLd = [],
} = Astro.props;

// Normalizing canonical URL without trailing slash (unless root)
const normalizedPath = canonicalPath === '/' ? '' : canonicalPath.replace(/\/+$/, '');
const canonicalUrl = `${SITE_URL}${normalizedPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;

const defaultSchemas: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${SITE_URL}/#organization`,
    "name": SITE_NAME,
    "alternateName": ["Rakebig", "Rakebig Technologies", "Rakebig Services AI"],
    "url": SITE_URL,
    "logo": {
      "@type": "ImageObject",
      "url": `${SITE_URL}/favicon.svg`,
      "width": "512",
      "height": "512"
    },
    "image": ogImageUrl,
    "description": DEFAULT_DESCRIPTION,
    "telephone": SUPPORT_PHONE,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": SUPPORT_PHONE,
        "contactType": "sales",
        "areaServed": "Global"
      },
      {
        "@type": "ContactPoint",
        "telephone": TECH_SUPPORT_PHONE,
        "contactType": "technical support",
        "areaServed": "Global"
      }
    ],
    "email": SUPPORT_EMAIL,
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1st Floor, Tech Park, Malviya Nagar",
      "addressLocality": "Jaipur",
      "addressRegion": "Rajasthan",
      "postalCode": "302017",
      "addressCountry": "IN"
    },
    "areaServed": ["Global", "India", "United States", "United Kingdom", "United Arab Emirates", "Europe"],
    "sameAs": [
      BOOK_CONSULTATION_URL,
      "https://crm.rakebig.com",
      "https://aiwidget.rakebig.com",
      SOCIAL_LINKS.facebook,
      SOCIAL_LINKS.instagram,
      SOCIAL_LINKS.linkedin,
      SOCIAL_LINKS.youtube,
      SOCIAL_LINKS.twitter,
      SOCIAL_LINKS.github
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    "url": SITE_URL,
    "name": SITE_NAME,
    "description": DEFAULT_DESCRIPTION,
    "publisher": {
      "@id": `${SITE_URL}/#organization`
    },
    "inLanguage": "en-US"
  }
];

const allSchemas = [...defaultSchemas, ...jsonLd];
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rakebig Services" />
    <meta name="publisher" content="Rakebig Services" />
    <meta name="theme-color" content="#080e1a" />
    <meta name="color-scheme" content="dark light" />
    
    <!-- Crawlers & AI Indexing Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="help" type="text/plain" title="LLMs & AI Context" href="/llms.txt" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rakebigservices" />
    <meta name="twitter:creator" content="@rakebigservices" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data for Google & AI Overviews -->
    {allSchemas.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Performance & Font Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/tobias-trial-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script is:inline>
      // Gate scroll-reveal styles on JS + motion preference so content is never
      // hidden without a way to reveal it. Runs before <body> paints (no FOUC).
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-reveal");
      }
    </script>
  </head>
  <body class="bg-background text-foreground font-body antialiased">
    <slot />
  </body>
</html>

<script>
  // Lenis smooth scrolling (eased inertia). Skipped when reduced motion is preferred.
  import Lenis from "lenis";
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }
</script>

<script>
  // Reusable cursor-follow glow.
  const initGlowFollow = () => {
    document.querySelectorAll<HTMLElement>(".glow-follow").forEach((el) => {
      if (el.dataset.glowReady) return;
      el.dataset.glowReady = "true";

      const restSide = el.dataset.glowRest ?? "center";
      let raf = 0;
      let gx = 0;
      let gy = 0;

      const apply = () => {
        raf = 0;
        el.style.setProperty("--gx", `${gx}px`);
        el.style.setProperty("--gy", `${gy}px`);
      };
      const schedule = () => {
        if (!raf) raf = requestAnimationFrame(apply);
      };
      const rest = () => {
        const w = el.getBoundingClientRect().width;
        gx = restSide === "right" ? w / 2 : restSide === "left" ? -w / 2 : 0;
        gy = 0;
        schedule();
      };

      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        gx = e.clientX - (r.left + r.width / 2);
        gy = e.clientY - (r.top + r.height / 2);
        schedule();
      });
      el.addEventListener("pointerleave", rest);
      rest();
    });
  };

  initGlowFollow();
  document.addEventListener("astro:after-swap", initGlowFollow);
</script>

<script>
  // Scroll reveal: fade + rise elements as they enter the viewport.
  const initReveal = () => {
    if (!document.documentElement.classList.contains("js-reveal")) return;
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>(".reveal, .reveal-stagger")
    ).filter((el) => !el.dataset.revealReady);

    if (!targets.length) return;

    targets.forEach((el) => {
      el.dataset.revealReady = "true";
      if (el.classList.contains("reveal-stagger")) {
        Array.from(el.children).forEach((child, i) => {
          (child as HTMLElement).style.transitionDelay = `${Math.min(i, 8) * 90}ms`;
        });
      }
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 }
    );
    targets.forEach((el) => io.observe(el));
  };

  initReveal();
  document.addEventListener("astro:after-swap", initReveal);
</script>
