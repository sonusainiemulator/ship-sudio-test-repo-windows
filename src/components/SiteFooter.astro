<script>
  // Copy AI prompt to clipboard
  const copyBtn = document.getElementById('footer-copy-ai-prompt');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const prompt = copyBtn.getAttribute('data-prompt') || '';
      try {
        await navigator.clipboard.writeText(prompt);
        copyBtn.classList.add('is-copied');
        const textSpan = copyBtn.querySelector('.site-footer__copy-text');
        if (textSpan) textSpan.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (textSpan) textSpan.textContent = 'Copy prompt';
        }, 2200);
      } catch (err) {
        console.error('Failed to copy AI prompt:', err);
      }
    });
  }

  // Newsletter submission interaction
  const newsletterForm = document.getElementById('footer-newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = newsletterForm.querySelector('button[type="submit"]');
      const input = newsletterForm.querySelector('input[type="email"]');
      if (btn && input && input.value) {
        const originalText = btn.textContent;
        btn.textContent = 'Subscribed!';
        input.value = '';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 3000);
      }
    });
  }
</script>
