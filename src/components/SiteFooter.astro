---
// Shared site footer — premium enterprise design inspired by InfinitieTech (https://infinitietech.com/)
// Features ambient top aura glow, 4-column responsive layout, address & direct support contacts,
// curated Services and Company links, interactive Newsletter pill form, brand social circles,
// WhatsApp Community banner, Google Preferred Source pill, accepted payment badges,
// and the iconic giant submerged "RAKEBIG" typography crop.
import { BOOK_CONSULTATION_URL, SUPPORT_EMAIL, SUPPORT_PHONE, TECH_SUPPORT_PHONE, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();

const brand = {
  name: "Rakebig",
  tagline:
    "Explore our ready-to-launch software marketplace & Perfex CRM modules, or hire our dedicated team for custom web, mobile, AI workflow, and reskinning solutions.",
};

const contacts = {
  email: SUPPORT_EMAIL,
  phone: SUPPORT_PHONE,
  supportPhone: TECH_SUPPORT_PHONE,
  supportTiming: "Tech support · Mon–Sat, 10–7 (GMT+5:30)",
  address: "Ward No.25, near Bsnl Office, Saini Mohalla, Bhadra, Rajasthan 335501",
  addressMapUrl: "https://maps.google.com/?q=Ward+No.25,+near+Bsnl+Office,+Saini+Mohalla,+Bhadra,+Rajasthan+335501",
  ukAddress: "Rakebig LTD · 7 Barnard Road, Enfield EN1 3QA, London",
};

const serviceLinks = [
  { label: "Perfex CRM Modules & Fixes", href: "/gigs/customize-perfex-crm-modules-development" },
  { label: "AI Automation & Chatbots", href: "/solutions/ai-assistants-chatbots" },
  { label: "Web & SaaS Development", href: "/services/web-application-development" },
  { label: "Flutter Mobile Apps (Android & iOS)", href: "/services/mobile-app-development" },
  { label: "Nextcloud & Enterprise VPS", href: "/open-source/nextcloud" },
  { label: "WhatsApp AI Marketing", href: "/whatsapp-marketing" },
  { label: "Gigs Marketplace", href: "/gigs" },
];

const companyLinks = [
  { label: "About Us", href: "/about" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Careers & Positions", href: "/careers" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Open Source Solutions", href: "/open-source" },
  { label: "Contact Us", href: "/contact" },
  { label: "Sitemap", href: "/sitemap-index.xml" },
];

const policyLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms & Conditions", href: "/terms" },
  { label: "Refund Policy", href: "/refund" },
  { label: "Installation Policy", href: "/terms#electronic-delivery" },
];

// Partner / Verification Credentials
const partnerBadges = [
  {
    name: "Google Partner",
    img: "/assets/partners/google-partner.svg",
    href: "https://www.google.com/partners/",
    alt: "Google Partner - Certified Agency",
    modifier: "google",
  },
  {
    name: "Shopify Partner",
    img: "/assets/partners/shopify-partner.png",
    href: "/gigs/design-lucrative-black-friday-shopify-store-dropshipping",
    alt: "Shopify Partner Agency",
    modifier: "shopify",
  },
  {
    name: "Upwork Agency",
    img: "/assets/partners/upwork-badge.png",
    href: "https://www.upwork.com/",
    alt: "Upwork Agency Partner",
    modifier: "upwork",
  },
  {
    name: "Fiverr Pro Seller",
    img: "/assets/partners/fiverr-badge.webp",
    href: "/gigs",
    alt: "Fiverr Verified Seller",
    modifier: "fiverr",
  },
];

// Ask AI Prompt & Engine Links (GEO Module)
const AI_PROMPT =
  "As a business owner, I want to know what makes Rakebig (rakebig.com) the best choice for Perfex CRM development, AI automation, and custom software, and when I should launch my project if I find the right fit. Does Rakebig offer support from experienced technical experts who can help me ensure I choose the best strategy for my unique needs? Why should I develop my website, CRM modules, and AI workflows through Rakebig? Why should I trust them?";

const encodedPrompt = encodeURIComponent(AI_PROMPT);

const aiProviders = [
  {
    id: "chatgpt",
    name: "ChatGPT",
    icon: "/assets/ai/chatgpt-logo.svg",
    href: `https://chatgpt.com/?prompt=${encodedPrompt}`,
    tooltip: "Ask ChatGPT",
  },
  {
    id: "claude",
    name: "Claude",
    icon: "/assets/ai/claude-logo.svg",
    href: `https://claude.ai/new?q=${encodedPrompt}`,
    tooltip: "Ask Claude",
  },
  {
    id: "gemini",
    name: "Google Gemini",
    icon: "/assets/ai/gemini-logo.svg",
    href: `https://www.google.com/search?udm=50&aep=11&q=${encodedPrompt}`,
    tooltip: "Ask Google AI (Gemini)",
  },
  {
    id: "grok",
    name: "Grok",
    icon: "/assets/ai/grok-logo.svg",
    href: `https://grok.com/?q=${encodedPrompt}`,
    tooltip: "Ask Grok",
  },
  {
    id: "perplexity",
    name: "Perplexity",
    icon: "/assets/ai/perplexity-logo.svg",
    href: `https://www.perplexity.ai/?q=${encodedPrompt}`,
    tooltip: "Ask Perplexity",
  },
];
---

<footer class="site-footer">
  <!-- Top Ambient Glow (matching InfinitieTech) -->
  <div class="site-footer__ambient-glow" aria-hidden="true"></div>

  <div class="site-footer__container">
    <!-- Partner Credentials & Ask AI Strip -->
    <div class="site-footer__top-strip">
      <div class="site-footer__partner-row" aria-label="Partner and Verification Credentials">
        {partnerBadges.map((b) => (
          <a
            href={b.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`site-footer__partner-badge site-footer__partner-badge--${b.modifier}`}
            aria-label={b.alt}
            title={b.name}
          >
            <img src={b.img} alt={b.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>

      <div class="site-footer__ask-ai-block">
        <p class="site-footer__ask-ai-title">
          Ask AI why Rakebig is the best choice for Perfex CRM development, AI automation, and custom software
        </p>

        <div class="site-footer__ai-buttons-row">
          {aiProviders.map((ai) => (
            <a
              href={ai.href}
              target="_blank"
              rel="noopener noreferrer"
              class="site-footer__ai-btn"
              data-ai={ai.id}
              title={ai.tooltip}
              aria-label={ai.tooltip}
            >
              <img src={ai.icon} alt={ai.name} width="40" height="40" loading="lazy" decoding="async" />
            </a>
          ))}

          <!-- Copy Prompt Action Button -->
          <button
            type="button"
            class="site-footer__copy-prompt-btn"
            id="footer-copy-ai-prompt"
            data-prompt={AI_PROMPT}
            title="Copy prompt text to clipboard"
            aria-label="Copy AI Prompt"
          >
            <svg class="site-footer__copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="site-footer__check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="site-footer__copy-text">Copy prompt</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main 4-Column Grid (InfinitieTech layout) -->
    <div class="site-footer__grid">
      <!-- Column 1: Brand & Contacts -->
      <div class="site-footer__col-brand">
        <a href="/" class="site-footer__logo" aria-label="Rakebig Home">
          <svg class="site-footer__logo-mark" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="9" cy="18" r="4.5" stroke="#3b82f6" stroke-width="2.2" fill="#1e3a8a" />
            <circle cx="9" cy="18" r="2" fill="#60a5fa" />
            <circle cx="27" cy="9" r="3.5" stroke="#3b82f6" stroke-width="2.2" fill="#1e3a8a" />
            <circle cx="27" cy="9" r="1.5" fill="#60a5fa" />
            <circle cx="27" cy="27" r="3.5" stroke="#3b82f6" stroke-width="2.2" fill="#1e3a8a" />
            <circle cx="27" cy="27" r="1.5" fill="#60a5fa" />
            <path d="M13.5 18H19C20.5 18 22 17 22.5 15.5L24 11" stroke="#3b82f6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M13.5 18H19C20.5 18 22 19 22.5 20.5L24 25" stroke="#3b82f6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="19" cy="18" r="1.5" fill="#93c5fd" />
          </svg>
          <span class="site-footer__logo-text">Rakebig</span>
        </a>

        <p class="site-footer__tagline">{brand.tagline}</p>

        <!-- Direct Contact Details with clean icons -->
        <address class="site-footer__address-list">
          <!-- Google Maps Address -->
          <a href={contacts.addressMapUrl} target="_blank" rel="noopener noreferrer" class="site-footer__contact-line" aria-label="Open location in Google Maps">
            <svg class="site-footer__line-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span class="site-footer__line-text">{contacts.address}</span>
          </a>

          <!-- Main Phone -->
          <div class="site-footer__contact-line">
            <svg class="site-footer__line-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <a href={`tel:${contacts.phone.replace(/[^0-9+]/g, '')}`} class="site-footer__line-link">{contacts.phone}</a>
          </div>

          <!-- Tech Support Line -->
          <div class="site-footer__contact-line site-footer__contact-line--support">
            <svg class="site-footer__line-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
            </svg>
            <div class="site-footer__support-wrap">
              <a href={`tel:${contacts.supportPhone.replace(/[^0-9+]/g, '')}`} class="site-footer__line-link">{contacts.supportPhone}</a>
              <span class="site-footer__support-timing">{contacts.supportTiming}</span>
            </div>
          </div>

          <!-- Email -->
          <div class="site-footer__contact-line">
            <svg class="site-footer__line-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${contacts.email}`} class="site-footer__line-link">{contacts.email}</a>
          </div>

          <!-- UK Branch -->
          <div class="site-footer__contact-line site-footer__contact-line--uk">
            <svg class="site-footer__line-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253" />
            </svg>
            <span class="site-footer__line-text">{contacts.ukAddress}</span>
          </div>
        </address>
      </div>

      <!-- Column 2: Services -->
      <div class="site-footer__col">
        <h3 class="site-footer__col-heading">Services</h3>
        <ul class="site-footer__nav-list">
          {serviceLinks.map((link) => (
            <li><a href={link.href} class="site-footer__nav-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="site-footer__col">
        <h3 class="site-footer__col-heading">Company</h3>
        <ul class="site-footer__nav-list">
          {companyLinks.map((link) => (
            <li><a href={link.href} class="site-footer__nav-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Stay Connected & Community (matching InfinitieTech) -->
      <div class="site-footer__col-connected">
        <h3 class="site-footer__col-heading">Stay Connected</h3>
        <h4 class="site-footer__newsletter-title">Subscribe to Our Newsletter</h4>
        <p class="site-footer__newsletter-desc">
          Get product releases, architectural insights, and agency updates delivered to your inbox.
        </p>

        <!-- Newsletter Pill Input -->
        <form id="footer-newsletter-form" class="site-footer__newsletter-form" novalidate>
          <div class="site-footer__pill-input-box">
            <label for="footer-email-input" class="sr-only">Email address</label>
            <input
              id="footer-email-input"
              type="email"
              placeholder="Enter your email"
              required
              class="site-footer__pill-input"
            />
            <button type="submit" class="site-footer__pill-submit-btn">Subscribe</button>
          </div>
          <p class="site-footer__newsletter-disclaimer">
            By subscribing, you agree to receive product releases and updates. Unsubscribe anytime.
          </p>
          <div class="site-footer__shield-notice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="site-footer__shield-icon" aria-hidden="true">
              <path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06" />
              <path d="m15 19 2 2 4-4" />
            </svg>
            <span>Protected by human verification.</span>
          </div>
        </form>

        <!-- Circular Social Media Icons Row -->
        <div class="site-footer__social-circles">
          <a href="https://codecanyon.net/user/rakebig" target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--envato" title="Rakebig on CodeCanyon" aria-label="CodeCanyon">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.98 2.02c-.37-.02-.87.21-1.6.72-2.12 1.48-5.32 4.45-6.84 8.76-.7-1.34-1.63-2.61-2.82-3.69-.99-.91-2.13-1.64-3.41-2.02-.38-.11-.71.18-.62.56.77 3.25 2.61 6.13 5.16 8.16 1.4 1.11 3.01 1.95 4.75 2.45.19.06.39-.08.39-.28v-.15c0-1.84.44-3.77 1.48-5.5 1.54-2.58 3.51-4.79 5.25-6.93.59-.72.93-1.4.73-1.8-.13-.18-.3-.27-.47-.28z" />
            </svg>
          </a>
          <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--linkedin" title="Connect on LinkedIn" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.87 0-1.57.7-1.57 1.57s.7 1.57 1.57 1.57 1.57-.7 1.57-1.57-.7-1.57-1.57-1.57z" />
            </svg>
          </a>
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--instagram" title="Follow on Instagram" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a href={`https://api.whatsapp.com/send?phone=${contacts.phone.replace(/[^0-9]/g, '')}&text=Hello%20Rakebig,%20I%20am%20inquiring%20from%20your%20website.`} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--whatsapp" title="Message on WhatsApp" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
            </svg>
          </a>
          <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--youtube" title="Watch on YouTube" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
          <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--x" title="Follow on X" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="site-footer__social-circle site-footer__social-circle--github" title="Rakebig on GitHub" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </div>

        <!-- Join WhatsApp Community Box (matching InfinitieTech) -->
        <a href={`https://api.whatsapp.com/send?phone=${contacts.phone.replace(/[^0-9]/g, '')}&text=Hello,%20I%20would%20like%20to%20join%20the%20Rakebig%20WhatsApp%20Community.`} target="_blank" rel="noopener noreferrer" class="site-footer__community-box">
          <span class="site-footer__community-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="site-footer__community-icon" aria-hidden="true">
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
            </svg>
          </span>
          <span class="site-footer__community-text-wrap">
