---
// Shared "LobeHub-style" list mega menu used by Products, Solutions, Clone Apps, and Open Source.
// Renders labelled groups of icon + title + description rows plus an optional footer link.
interface MegaItem {
  title: string;
  body: string;
  href: string;
  icon: string;
  tint: string;
  color: string;
  external?: boolean;
  isNew?: boolean;
  badge?: string;
}

interface Props {
  groups: { label: string; items: MegaItem[] }[];
  footerLabel?: string;
  footerHref?: string;
  cols?: number;
}

const { groups, footerLabel, footerHref, cols = 2 } = Astro.props;
---

<div class="pm">
  <div class="pm__groups" style={`--mega-cols: ${cols}`}>
    {groups.map((group) => (
      <div class="pm__group">
        <p class="pm__label">{group.label}</p>
        <ul class="pm__list">
          {group.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="pm__row"
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                <span class="pm__icon" style={`background:${item.tint};color:${item.color}`}>
                  {item.icon === "crm" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 3.5l7.5 4.25L12 12 4.5 7.75 12 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M4.5 12L12 16.25 19.5 12" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M4.5 16.25L12 20.5l7.5-4.25" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "web" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M3.5 9.5h17M7 7h.01M10 7h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === "mobile" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="7" y="3.5" width="10" height="17" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M11 18h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === "cloud" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7.5 18h9a4 4 0 00.4-8 5.5 5.5 0 00-10.7 1.6A3.5 3.5 0 007.5 18z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "ai" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 3l1.2 4.2L17.5 8.5 13.2 9.8 12 14l-1.2-4.2L6.5 8.5l4.3-1.3L12 3zM18.5 14l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3zM6 15.5l.5 1.7 1.7.5-1.7.5L6 20l-.5-1.8-1.7-.5 1.7-.5L6 15.5z" fill="currentColor" />
                    </svg>
                  )}
                  {item.icon === "team" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M16 19v-1.5a3.5 3.5 0 00-3.5-3.5h-5A3.5 3.5 0 004 17.5V19M17.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM9 11a3 3 0 100-6 3 3 0 000 6z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "launch" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "chat" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M21 11.5a7.5 7.5 0 01-7.5 7.5H5l-2 2.5V12a7.5 7.5 0 0113.5-4.6A7.4 7.4 0 0121 11.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "doc" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 3.5h7l4 4V20.5H7V3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M14 3.5v4h4M10 13h5M10 16.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "bolt" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M13 3 5 13.5h5L10 21l8-10.5h-5L13 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "workflow" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="5" cy="5" r="2" stroke="currentColor" stroke-width="1.7" />
                      <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.7" />
                      <circle cx="5" cy="19" r="2" stroke="currentColor" stroke-width="1.7" />
                      <path d="M6.8 6.3l10.3 4.5M6.8 17.7l10.3-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === "chip" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.7" />
                      <rect x="10.5" y="10.5" width="3" height="3" rx="0.6" stroke="currentColor" stroke-width="1.3" />
                      <path d="M12 7V4M12 20v-3M7 12H4M20 12h-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === "bag" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6.5 8.5h11l-.9 10.4a2 2 0 0 1-2 1.8H9.4a2 2 0 0 1-2-1.8L6.5 8.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                      <path d="M9 8V6.7A3 3 0 0 1 12 3.8a3 3 0 0 1 3 2.9V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === "car" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 15.2l1.3-3.2a2.2 2.2 0 0 1 2-1.3h7.4a2.2 2.2 0 0 1 2 1.3L19 15.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M5 15.2h14V17a1.5 1.5 0 0 1-1.5 1.5H6.5A1.5 1.5 0 0 1 5 17v-1.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <circle cx="8" cy="18.5" r="1.6" stroke="currentColor" stroke-width="1.5" />
                      <circle cx="16" cy="18.5" r="1.6" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                  {item.icon === "home" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M4 10.5 12 4l8 6.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M6 20V12.2L12 7l6 5.2V20" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                      <path d="M6 20h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                      <path d="M10.2 20v-3.4h3.6V20" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                  {item.icon === "heart" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 20.3C6.4 16.3 4 12.9 4 9.8 4 7.1 6 5.2 8.3 5.2c1.4 0 2.8.7 3.7 1.9.9-1.2 2.3-1.9 3.7-1.9C18 5.2 20 7.1 20 9.8c0 3.1-2.4 6.5-8 10.5z" fill="currentColor" />
                    </svg>
                  )}
                  {item.icon === "note" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="8.5" cy="17" r="3" stroke="currentColor" stroke-width="1.7" />
                      <path d="M11.5 16.7V4.8L18.5 3v12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      <circle cx="16.5" cy="15.5" r="2.4" stroke="currentColor" stroke-width="1.7" />
                    </svg>
                  )}
                  {item.icon === "screen" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3.5" y="5" width="17" height="13.5" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M10.2 9.2l4.6 2.5-4.6 2.5V9.2z" fill="currentColor" />
                    </svg>
                  )}
                  {item.icon === "cam" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3" y="7" width="13" height="10" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M16 11.6l5-2.9v6.6l-5-2.9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "wrench" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M14.7 6.3a4.5 4.5 0 00-5.9 5.9L3 18l3 3 5.8-5.8a4.5 4.5 0 005.9-5.9l-2.5 2.5-2.5-2.5 2.5-2.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "code" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M8 8L4 12l4 4M16 8l4 4-4 4M13 5l-2 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "install" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 3v10m0 0l-3.5-3.5M12 13l3.5-3.5M5 17.5V19a2 2 0 002 2h10a2 2 0 002-2v-1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "mail" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3.5" y="5" width="17" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === "link" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </span>
                <span class="pm__copy">
                  <strong>
                    {item.title}
                    {item.external && (
                      <svg class="pm__ext" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M6 3h7v7M13 3L5 11M10 13H3V6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {item.isNew && <span class="pm__badge">NEW</span>}
                    {item.badge && <span class={`pm__badge ${item.badge === "SOON" || item.badge === "UPCOMING" ? "pm__badge--soon" : ""}`}>{item.badge}</span>}
                  </strong>
                  <span>{item.body}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {footerLabel && footerHref && (
    <a href={footerHref} class="pm__footer">
      <span>{footerLabel}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  )}
</div>

<style>
  .pm {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pm__groups {
    display: grid;
    grid-template-columns: repeat(var(--mega-cols, 2), minmax(0, 1fr));
    gap: 4px 18px;
  }

  .pm__group + .pm__group {
    border-left: 1px solid #eef2f7;
    padding-left: 18px;
  }

  .pm__label {
    margin: 0 0 6px;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  .pm__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .pm__row {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    align-items: start;
    padding: 10px;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .pm__row:hover {
    background: #f5f8fc;
  }

  .pm__icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pm__icon svg {
    width: 18px;
    height: 18px;
  }

  .pm__copy {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .pm__copy strong {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #0f172a;
    flex-wrap: wrap;
  }

  .pm__ext {
    width: 13px;
    height: 13px;
    color: #94a3b8;
    flex-shrink: 0;
  }

  .pm__row:hover .pm__ext {
    color: #2F6BFF;
  }

  .pm__badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: #eff6ff;
    color: #2563eb;
    border: 1px solid #dbeafe;
    flex-shrink: 0;
  }

  .pm__badge--soon {
    background: #fff7ed;
    color: #ea580c;
    border-color: #ffedd5;
  }

  .pm__copy span {
    font-size: 12.5px;
    line-height: 1.45;
    color: #64748b;
  }

  .pm__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 10px 2px;
    border-top: 1px solid #eef2f7;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .pm__footer svg {
    width: 15px;
    height: 15px;
  }

  .pm__footer:hover {
    color: #2F6BFF;
  }

  @media (max-width: 1280px) and (min-width: 961px) {
    .pm__groups {
      grid-template-columns: repeat(min(var(--mega-cols, 2), 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .pm__groups {
      grid-template-columns: 1fr !important;
      gap: 16px;
    }

    .pm__group + .pm__group {
      border-left: 0;
      padding-left: 0;
      padding-top: 14px;
      border-top: 1px solid #eef2f7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm__row,
    .pm__footer {
      transition: none;
    }
  }
</style>

