<script>
  function initSiteHeader() {
    const root = document.querySelector<HTMLElement>("[data-site-header]");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-menu]"));
    const burger = root.querySelector<HTMLButtonElement>("[data-burger]");
    const links = root.querySelector<HTMLElement>("[data-nav-links]");
    const mq = window.matchMedia("(max-width: 960px)");
    let closeTimer: number | undefined;

    const closeAll = () => {
      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>("[data-menu-trigger]");
        const panel = item.querySelector<HTMLElement>("[data-menu-panel]");
        item.classList.remove("is-open");
        trigger?.setAttribute("aria-expanded", "false");
        if (panel) panel.hidden = true;
      });
    };

    const openItem = (item: HTMLElement) => {
      closeAll();
      const trigger = item.querySelector<HTMLButtonElement>("[data-menu-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-menu-panel]");
      item.classList.add("is-open");
      trigger?.setAttribute("aria-expanded", "true");
      if (panel) panel.hidden = false;
    };

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-menu-trigger]");
      trigger?.addEventListener("click", (e) => {
        e.preventDefault();
        if (item.classList.contains("is-open")) closeAll();
        else openItem(item);
      });

      item.addEventListener("mouseenter", () => {
        if (mq.matches) return;
        window.clearTimeout(closeTimer);
        openItem(item);
      });
      item.addEventListener("mouseleave", () => {
        if (mq.matches) return;
        closeTimer = window.setTimeout(closeAll, 120);
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAll();
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) closeAll();
    });

    burger?.addEventListener("click", () => {
      const open = root.classList.toggle("is-mobile-open");
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (links) links.toggleAttribute("data-open", open);
      if (!open) closeAll();
    });
  }

  initSiteHeader();
  document.addEventListener("astro:after-swap", () => {
    const prev = document.querySelector<HTMLElement>("[data-site-header]");
    if (prev) delete prev.dataset.bound;
    initSiteHeader();
  });
</script>

