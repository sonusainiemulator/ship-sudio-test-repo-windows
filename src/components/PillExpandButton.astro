---
// Pill expand — Super Interactions
// Single file: save as PillExpandButton.astro and use <PillExpandButton /> anywhere.
// Customize via the CSS variables on the root class (--primary, --label-color, --duration, --ease, --bounce). The remaining rules are layout-critical — leave them intact.
---
<button class="pill-expand-btn">
  <svg class="icon" aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <path d="M2.5 8h11M9.5 3.5 14 8l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="label"><span class="label-text">View more</span></span>
</button>

<style is:global>
.pill-expand-btn {
  --primary: #111111;
  --label-color: #ffffff;
  --duration: 420ms;
  --ease: cubic-bezier(0.34, 1.56, 0.64, 1);
  --bounce: 1;

  display: inline-grid;
  grid-template-columns: auto 0fr;
  align-items: center;
  height: 56px;
  padding: 0 19px;
  border: none;
  border-radius: 999px;
  background: var(--primary);
  color: var(--label-color);
  font: inherit;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transform: scale(1);
  transition:
    grid-template-columns var(--duration) var(--ease),
    transform calc(var(--duration) * 1.25) cubic-bezier(0.3, 3.6, 0.3, 1);
}

.pill-expand-btn .icon {
  width: 18px;
  height: 18px;
}

.pill-expand-btn .label {
  overflow: hidden;
  min-width: 0;
}

.pill-expand-btn .label-text {
  display: inline-block;
  padding: 0 4px 0 10px;
  white-space: nowrap;
  opacity: 0;
  transition: opacity calc(var(--duration) * 0.45) ease-out;
}

.pill-expand-btn:hover,
.pill-expand-btn:focus-visible {
  grid-template-columns: auto 1fr;
  transform: scale(calc(1 + 0.08 * var(--bounce)));
}

.pill-expand-btn:hover .label-text,
.pill-expand-btn:focus-visible .label-text {
  opacity: 1;
  transition-delay: calc(var(--duration) * 0.3);
}
</style>
