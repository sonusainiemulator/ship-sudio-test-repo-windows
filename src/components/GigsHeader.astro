---
import { GIGS_NAVIGATION_CATEGORIES, type GigsCategoryConfig } from "../data/gigs";
import { BOOK_CONSULTATION_URL, SUPPORT_PHONE } from "../consts";

interface Props {
  activeCategory?: string;
}

const { activeCategory = "all" } = Astro.props;

const categories = GIGS_NAVIGATION_CATEGORIES;
const whatsappPhoneClean = SUPPORT_PHONE.replace(/[^0-9]/g, "");
---

<header class="gh-wrapper" data-gigs-header>
  <!-- Top Primary Bar matching Fiverr header -->
  <div class="gh-topbar">
    <div class="container gh-topbar__inner">
      <!-- Desktop & Mobile Row 1 Brand / Home / Actions -->
      <div class="gh-topbar__brand-wrap">
        <a href="/" class="gh-topbar__back-home" title="Back to Rakebig Main Site">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
          </svg>
          <span>Rakebig.com</span>
        </a>
        <a href="/gigs" class="gh-brand" aria-label="Rakebig Gigs Marketplace">
          <span class="gh-brand__logo">rakebig</span>
          <span class="gh-brand__dot">.</span>
          <span class="gh-brand__sub">gigs</span>
        </a>
      </div>

      <!-- Search bar matching Fiverr (Desktop & Mobile) -->
      <div class="gh-search" role="search">
        <div class="gh-search__box">
          <span class="gh-search__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="text"
            id="gigs-search-input"
            class="gh-search__input"
            placeholder="What service are you looking for today?"
            aria-label="Search services or gigs"
            autocomplete="off"
          />
        </div>
        <button type="button" class="gh-search__submit" id="gigs-search-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>

      <!-- Actions (Desktop matching screenshot: Notification, Message, Heart, Orders, Profile Avatar, Balance) -->
      <div class="gh-topbar__actions">
        <!-- Quick WhatsApp AI pill -->
        <a href="/whatsapp-marketing" class="gh-pill-highlight" title="WhatsApp Marketing Automation">
          <span class="gh-pill-pulse"></span>
          <span>WhatsApp AI</span>
        </a>

        <!-- Fiverr Header Icons -->
        <div class="gh-user-tools">
          <!-- Notification Bell with Alert Dot -->
          <button type="button" class="gh-tool-icon" aria-label="Notifications" title="Notifications">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="gh-badge-dot" aria-hidden="true"></span>
          </button>

          <!-- Messages / Mail -->
          <button type="button" class="gh-tool-icon" aria-label="Messages" title="Messages">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </button>

          <!-- Wishlist / Heart -->
          <a href="/gigs" class="gh-tool-icon" aria-label="Saved Gigs" title="Saved Gigs">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            </svg>
          </a>

          <!-- Orders Link -->
          <a href="/gigs" class="gh-orders-link" title="My Orders">
            Orders
          </a>

          <!-- Avatar & Balance Badge -->
          <div class="gh-avatar-badge" title="Rakebig Pro Verified Client">
            <div class="gh-avatar-wrap">
              <img
                src="https://fiverr-res.cloudinary.com/t_profile_thumb,q_auto,f_auto/attachments/profile/photo/89f2bd03308a2cd79cc607a6e5e79c0e-1790498805453/a9fb6dde-8730-4051-ac24-5e08ad6638b7.png"
                alt="Account"
                class="gh-avatar-img"
                width="32"
                height="32"
              />
              <span class="gh-online-dot"></span>
            </div>
            <span class="gh-balance-val">$24</span>
          </div>
        </div>

        <a href={`https://wa.me/${whatsappPhoneClean}?text=Hi%20Rakebig,%20I%20want%20to%20request%20a%20custom%20gig`} target="_blank" rel="noopener noreferrer" class="gh-btn-request">
          Request Offer
        </a>
      </div>

      <!-- Mobile Right Controls (WhatsApp + Burger) -->
      <div class="gh-topbar__mobile-controls">
        <a href="/whatsapp-marketing" class="gh-pill-highlight gh-pill-highlight--mobile" aria-label="WhatsApp AI">
          <span class="gh-pill-pulse"></span>
          <span>AI</span>
        </a>
        <button type="button" class="gh-burger-btn" id="gh-burger-toggle" aria-label="Open Marketplace Menu" aria-expanded="false" data-gigs-burger>
          <span class="gh-burger-line gh-burger-line--top"></span>
          <span class="gh-burger-line gh-burger-line--mid"></span>
          <span class="gh-burger-line gh-burger-line--bot"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Secondary Category Sub-Nav with Scroll Buttons & Mega Menu -->
  <nav class="gh-catnav" aria-label="Gigs Marketplace Categories" data-catnav-root>
    <div class="container gh-catnav__inner">
      <!-- Left scroll button -->
      <button type="button" class="gh-catnav__scroll-btn gh-catnav__scroll-btn--left" id="gh-scroll-left" aria-label="Scroll categories left">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
        </svg>
      </button>

      <ul class="gh-catnav__list" id="gh-catnav-list">
        <!-- Quick All Categories trigger on mobile -->
        <li class="gh-catnav__item gh-catnav__item--all-trigger">
          <button type="button" class="gh-catnav__all-btn" id="gh-catnav-all-btn" aria-label="Explore all categories" data-open-drawer-btn>
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
            </svg>
            <span>Categories</span>
          </button>
        </li>

        {categories.map((cat) => {
          const isActive = activeCategory === cat.id;
          return (
            <li class={`gh-catnav__item ${cat.hasSubmenu ? "gh-catnav__item--has-sub" : ""}`} data-cat-id={cat.id}>
              <a
                href={cat.id === "trending" ? "#gigs-grid" : `/gigs?cat=${cat.id}`}
                data-category-trigger={cat.id}
                data-category-filter={cat.id}
                class={`gh-catnav__link ${cat.isTrending ? "gh-catnav__link--trending" : ""} ${isActive ? "gh-catnav__link--active" : ""}`}
              >
                <span>{cat.name}</span>
                {cat.hasSubmenu && (
                  <svg class="gh-catnav__caret gh-catnav__caret--desktop" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M2.5 4.5L6 8l3.5-3.5"/>
                  </svg>
                )}
              </a>
              {cat.hasSubmenu && (
                <button
                  type="button"
                  class="gh-catnav__caret-mobile-btn"
                  data-open-cat-drawer={cat.id}
                  aria-label={`Open ${cat.name} subcategories`}
                  title={`Open ${cat.name} subcategories`}
                >
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M2.5 4.5L6 8l3.5-3.5"/>
                  </svg>
                </button>
              )}
            </li>
          );
        })}
      </ul>

      <!-- Right scroll button -->
      <button type="button" class="gh-catnav__scroll-btn gh-catnav__scroll-btn--right" id="gh-scroll-right" aria-label="Scroll categories right">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
        </svg>
      </button>
    </div>

    <!-- Mega Menu Floating Panels (Rendered outside the scrollable UL for Desktop Viewports) -->
    <div class="gh-mega-overlay" id="gh-mega-overlay">
      <div class="container gh-mega-container">
        {categories.filter(c => c.hasSubmenu).map((cat) => {
          const isAi = cat.id === "ai-services";
          return (
            <div
              class={`gh-mega-panel ${isAi ? "gh-mega-panel--ai" : ""}`}
              data-mega-panel={cat.id}
              role="region"
              aria-label={`${cat.name} Menu`}
            >
              <div class="gh-mega-columns">
                {cat.groups.map((group) => (
                  <div class="gh-mega-group">
                    <h4 class="gh-mega-group__title">{group.title}</h4>
                    <ul class="gh-mega-group__list">
                      {group.items.map((item) => (
                        <li>
                          <a href={item.href || `/gigs?filter=${item.slug}`} class="gh-mega-item">
                            <span class="gh-mega-item__label">{item.name}</span>
                            {item.tag && (
                              <span class={`gh-tag-pill ${item.tag === "NEW" ? "gh-tag-pill--new" : item.tag === "HOT" ? "gh-tag-pill--hot" : "gh-tag-pill--popular"}`}>
                                {item.tag}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>

                    {group.footerAction && (
                      <a href={group.footerAction.href} class="gh-mega-action-link">
                        <span>{group.footerAction.text}</span>
                        <svg class="gh-wand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M15 4V2m0 16v-2m6-6h-2m-16 0H1m15.5-7.5l-1.5 1.5M4 18l1.5-1.5m10 0l1.5 1.5M4 6l1.5 1.5M8 12l9-9 3 3-9 9-4 1 1-4z"/>
                        </svg>
                      </a>
                    )}
                  </div>
                ))}
              </div>

              {cat.bottomBanner && (
                <div class="gh-mega-bottom-banner">
                  <div class="gh-mega-bottom-banner__left">
                    <span class="gh-mega-bottom-banner__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                    </span>
                    <div>
                      <strong>{cat.bottomBanner.title}</strong>
                      <p>{cat.bottomBanner.desc}</p>
                    </div>
                  </div>
                  <a href={cat.bottomBanner.ctaHref} class="gh-mega-bottom-banner__btn">
                    {cat.bottomBanner.ctaText}
                  </a>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </nav>

  <!-- Mobile Slide-In Marketplace Drawer -->
  <div class="gh-drawer" id="gh-mobile-drawer" data-gigs-drawer aria-hidden="true">
    <div class="gh-drawer__header">
      <a href="/gigs" class="gh-brand" aria-label="Rakebig Gigs">
        <span class="gh-brand__logo">rakebig</span>
        <span class="gh-brand__dot">.</span>
        <span class="gh-brand__sub">gigs</span>
      </a>
      <button type="button" class="gh-drawer__close" id="gh-drawer-close-btn" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Quick CTAs inside drawer -->
    <div class="gh-drawer__actions">
      <a href="/gigs/discover-ai-agents" class="gh-drawer__ai-btn">
        <span class="gh-pill-pulse"></span>
        <span>Discover AI Agents 🤖</span>
      </a>
      <a href={`https://wa.me/${whatsappPhoneClean}?text=Hi%20Rakebig,%20I%20want%20to%20request%20a%20custom%20gig`} target="_blank" rel="noopener noreferrer" class="gh-drawer__cta-btn">
        Request Custom Offer
      </a>
    </div>

    <!-- Live Filter inside drawer -->
    <div class="gh-drawer__search-box">
      <svg class="gh-drawer__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="gh-drawer-search-input"
        class="gh-drawer__search-input"
        placeholder="Filter services & subcategories..."
        aria-label="Filter services in menu"
        autocomplete="off"
      />
      <button type="button" id="gh-drawer-search-clear" class="gh-drawer__search-clear" aria-label="Clear filter" style="display: none;">✕</button>
    </div>

    <!-- Accordion Category List -->
    <div class="gh-drawer__menu">
      <div class="gh-drawer__menu-header-row">
        <p class="gh-drawer__menu-label">Marketplace Categories</p>
        <span class="gh-drawer__cat-count">{categories.length} Categories</span>
      </div>
      <div class="gh-drawer__accordion">
        {categories.map((cat) => {
          const isCurrentActive = activeCategory === cat.id;
          if (!cat.hasSubmenu) {
            return (
              <div class="gh-drawer__acc-item" data-acc-group data-drawer-cat={cat.id}>
                <a href="#gigs-grid" data-category-filter={cat.id} class="gh-drawer__item-single">
                  <span class="gh-drawer__item-single-name">{cat.name}</span>
                  <span class="gh-drawer__arrow">→</span>
                </a>
              </div>
            );
          }

          const totalItems = cat.groups.reduce((acc, g) => acc + g.items.length, 0);

          return (
            <div class={`gh-drawer__acc-item ${isCurrentActive ? "is-expanded is-current-category" : ""}`} data-acc-group data-drawer-cat={cat.id}>
              <button
                type="button"
                class="gh-drawer__acc-trigger"
                data-acc-trigger
                aria-expanded={isCurrentActive ? "true" : "false"}
              >
                <div class="gh-drawer__acc-trigger-left">
                  <span class="gh-drawer__acc-name">{cat.name}</span>
                  {totalItems > 0 && (
                    <span class="gh-drawer__acc-badge">{totalItems}</span>
                  )}
                </div>
                <svg class="gh-drawer__caret" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M2.5 4.5L6 8l3.5-3.5"/>
                </svg>
              </button>
              <div class="gh-drawer__acc-panel" data-acc-panel hidden={!isCurrentActive}>
                {cat.groups.map((group) => (
                  <div class="gh-drawer__subgroup" data-drawer-subgroup>
                    <h5 class="gh-drawer__subgroup-title">{group.title}</h5>
                    <ul class="gh-drawer__subgroup-list">
                      {group.items.map((item) => (
                        <li data-drawer-item>
                          <a href={item.href || `/gigs?filter=${item.slug}`} class="gh-drawer__sub-link">
                            <span class="gh-drawer__sub-name">{item.name}</span>
                            {item.tag && (
                              <span class={`gh-tag-pill ${item.tag === "NEW" ? "gh-tag-pill--new" : item.tag === "HOT" ? "gh-tag-pill--hot" : "gh-tag-pill--popular"}`}>
                                {item.tag}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>

                    {group.footerAction && (
                      <a href={group.footerAction.href} class="gh-drawer__action-sublink">
                        <span>{group.footerAction.text}</span>
                        <svg viewBox="0 0 16 16" fill="currentColor" width="12" height="12" aria-hidden="true">
                          <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                        </svg>
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Drawer Footer Links -->
    <div class="gh-drawer__footer">
      <a href={BOOK_CONSULTATION_URL} target="_blank" rel="noopener noreferrer" class="gh-drawer__foot-link">
        Book a Consultation →
      </a>
      <a href="/" class="gh-drawer__foot-link gh-drawer__foot-link--dim">
        ← Back to Rakebig.com Main Site
      </a>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div class="gh-backdrop" id="gh-drawer-backdrop" aria-hidden="true"></div>
</header>

<script is:inline>
  function initGigsHeader() {
    const header = document.querySelector('[data-gigs-header]');
    if (!header || header.dataset.gigsInit === '1') return;
    header.dataset.gigsInit = '1';

    // 1. Mega Menu Desktop Hover Bridge (strictly > 1024px)
    const catNav = header.querySelector('[data-catnav-root]');
    const triggerLinks = header.querySelectorAll('[data-category-trigger]');
    const overlay = document.getElementById('gh-mega-overlay');
    const panels = header.querySelectorAll('[data-mega-panel]');
    let closeTimeout = null;
    let activeCatId = null;

    function isDesktop() {
      return window.innerWidth > 1024;
    }

    function showMegaPanel(catId) {
      if (!isDesktop()) return; // Never show floating mega overlay on tablet / mobile
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      activeCatId = catId;

      triggerLinks.forEach((link) => {
        const id = link.getAttribute('data-category-trigger');
        if (id === catId) {
          link.classList.add('gh-catnav__link--hovered');
        } else {
          link.classList.remove('gh-catnav__link--hovered');
        }
      });

      let found = false;
      panels.forEach((p) => {
        if (p.getAttribute('data-mega-panel') === catId) {
          p.classList.add('is-active');
          found = true;
        } else {
          p.classList.remove('is-active');
        }
      });

      if (found && overlay) {
        overlay.classList.add('is-open');
      } else if (overlay) {
        overlay.classList.remove('is-open');
      }
    }

    function scheduleCloseMega() {
      if (closeTimeout) clearTimeout(closeTimeout);
      closeTimeout = setTimeout(() => {
        triggerLinks.forEach((link) => link.classList.remove('gh-catnav__link--hovered'));
        panels.forEach((p) => p.classList.remove('is-active'));
        if (overlay) overlay.classList.remove('is-open');
        activeCatId = null;
      }, 150);
    }

    triggerLinks.forEach((link) => {
      const catId = link.getAttribute('data-category-trigger');
      link.addEventListener('mouseenter', () => {
        if (isDesktop()) showMegaPanel(catId);
      });
      link.addEventListener('focus', () => {
        if (isDesktop()) showMegaPanel(catId);
      });
    });

    if (catNav) {
      catNav.addEventListener('mouseleave', () => {
        if (isDesktop()) scheduleCloseMega();
      });
    }

    if (overlay) {
      overlay.addEventListener('mouseenter', () => {
        if (closeTimeout) {
          clearTimeout(closeTimeout);
          closeTimeout = null;
        }
      });
      overlay.addEventListener('mouseleave', () => {
        if (isDesktop()) scheduleCloseMega();
      });
    }

    // Dismiss mega panel when clicking outside on desktop
    document.addEventListener('click', (e) => {
      if (overlay?.classList.contains('is-open')) {
        const target = e.target;
        if (!catNav?.contains(target) && !overlay?.contains(target)) {
          scheduleCloseMega();
        }
      }
    });

    // 2. Category Filter Clicks
    const filterLinks = header.querySelectorAll('[data-category-filter]');
    filterLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const cat = link.getAttribute('data-category-filter');
        if (cat) {
          window.dispatchEvent(new CustomEvent('gigCategoryFilter', { detail: { category: cat } }));
          header.querySelectorAll('.gh-catnav__link').forEach((l) => {
            l.classList.toggle('gh-catnav__link--active', l.getAttribute('data-category-filter') === cat);
          });
          closeMobileDrawer();
        }
      });
    });

    // 3. Search Box Handlers
    const searchInput = document.getElementById('gigs-search-input');
    const searchBtn = document.getElementById('gigs-search-btn');
    const dispatchSearch = () => {
      const q = searchInput ? searchInput.value.trim() : '';
      window.dispatchEvent(new CustomEvent('gigSearchQuery', { detail: { query: q } }));
    };

    if (searchInput) {
      searchInput.addEventListener('input', dispatchSearch);
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          dispatchSearch();
          const grid = document.getElementById('gigs-grid') || document.getElementById('automate-services');
          if (grid) grid.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
    if (searchBtn) {
      searchBtn.addEventListener('click', (e) => {
        e.preventDefault();
        dispatchSearch();
        const grid = document.getElementById('gigs-grid') || document.getElementById('automate-services');
        if (grid) grid.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // 4. Category Horizontal Scroll with Buttons
    const catList = document.getElementById('gh-catnav-list');
    const scrollLeftBtn = document.getElementById('gh-scroll-left');
    const scrollRightBtn = document.getElementById('gh-scroll-right');

    const updateScrollButtons = () => {
      if (!catList || !scrollLeftBtn || !scrollRightBtn) return;
      if (window.innerWidth <= 768) {
        scrollLeftBtn.classList.add('is-hidden');
        scrollRightBtn.classList.add('is-hidden');
        return;
      }
      const atStart = catList.scrollLeft <= 5;
      const atEnd = catList.scrollLeft + catList.clientWidth >= catList.scrollWidth - 5;
      scrollLeftBtn.classList.toggle('is-hidden', atStart);
      scrollRightBtn.classList.toggle('is-hidden', atEnd);
    };

    if (scrollLeftBtn && catList) {
      scrollLeftBtn.addEventListener('click', () => {
        catList.scrollBy({ left: -260, behavior: 'smooth' });
      });
    }
    if (scrollRightBtn && catList) {
      scrollRightBtn.addEventListener('click', () => {
        catList.scrollBy({ left: 260, behavior: 'smooth' });
      });
    }
    if (catList) {
      catList.addEventListener('scroll', updateScrollButtons, { passive: true });
      window.addEventListener('resize', updateScrollButtons, { passive: true });
      setTimeout(updateScrollButtons, 100);
    }

    // 5. Mobile Drawer Open / Close
    const burgerToggle = document.getElementById('gh-burger-toggle');
    const drawerCloseBtn = document.getElementById('gh-drawer-close-btn');
    const drawer = document.getElementById('gh-mobile-drawer');
    const backdrop = document.getElementById('gh-drawer-backdrop');

    function openMobileDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      burgerToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      // Auto-focus drawer search input on mobile open after short delay
      setTimeout(() => {
        const dSearch = document.getElementById('gh-drawer-search-input');
        if (dSearch && window.innerWidth > 600) dSearch.focus();
      }, 300);
    }

    function closeMobileDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      burgerToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    burgerToggle?.addEventListener('click', () => {
      if (drawer?.classList.contains('is-open')) closeMobileDrawer();
      else openMobileDrawer();
    });

    // Support "Categories" trigger button in catnav
    const openDrawerBtns = header.querySelectorAll('[data-open-drawer-btn]');
    openDrawerBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openMobileDrawer();
      });
    });

    drawerCloseBtn?.addEventListener('click', closeMobileDrawer);
    backdrop?.addEventListener('click', closeMobileDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (drawer?.classList.contains('is-open')) closeMobileDrawer();
        scheduleCloseMega();
      }
    });

    // 6. Expand Drawer Category from mobile caret buttons
    function expandDrawerCategory(catId) {
      if (!drawer) return;
      const targetItem = drawer.querySelector(`[data-drawer-cat="${catId}"]`);
      if (!targetItem) return;
      const trig = targetItem.querySelector('[data-acc-trigger]');
      const panel = targetItem.querySelector('[data-acc-panel]');

      header.querySelectorAll('[data-acc-group]').forEach((item) => {
        if (item !== targetItem) {
          item.classList.remove('is-expanded');
          item.querySelector('[data-acc-trigger]')?.setAttribute('aria-expanded', 'false');
          const p = item.querySelector('[data-acc-panel]');
          if (p) p.hidden = true;
        }
      });

      targetItem.classList.add('is-expanded');
      trig?.setAttribute('aria-expanded', 'true');
      if (panel) panel.hidden = false;

      setTimeout(() => {
        targetItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 250);
    }

    const openCatDrawerBtns = header.querySelectorAll('[data-open-cat-drawer]');
    openCatDrawerBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const catId = btn.getAttribute('data-open-cat-drawer');
        openMobileDrawer();
        if (catId) {
          expandDrawerCategory(catId);
        }
      });
    });

    // 7. Drawer Accordion Submenus
    const accTriggers = header.querySelectorAll('[data-acc-trigger]');
    accTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-acc-group]');
        const panel = item?.querySelector('[data-acc-panel]');
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        accTriggers.forEach((otherTrig) => {
          if (otherTrig !== trigger) {
            otherTrig.setAttribute('aria-expanded', 'false');
            const otherItem = otherTrig.closest('[data-acc-group]');
            const otherPanel = otherItem?.querySelector('[data-acc-panel]');
            if (otherPanel) otherPanel.hidden = true;
            otherItem?.classList.remove('is-expanded');
          }
        });

        trigger.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        if (panel) panel.hidden = isExpanded;
        item?.classList.toggle('is-expanded', !isExpanded);
      });
    });

    // 8. Drawer Real-Time Search Filter
    const drawerSearch = document.getElementById('gh-drawer-search-input');
    const drawerClear = document.getElementById('gh-drawer-search-clear');
    if (drawerSearch) {
      drawerSearch.addEventListener('input', () => {
        const query = drawerSearch.value.trim().toLowerCase();
        if (drawerClear) drawerClear.style.display = query ? 'flex' : 'none';

        const accItems = drawer?.querySelectorAll('[data-acc-group]');
        accItems?.forEach((catItem) => {
          const singleLink = catItem.querySelector('.gh-drawer__item-single');
          if (singleLink) {
            const matchesSingle = !query || singleLink.textContent?.toLowerCase().includes(query);
            catItem.style.display = matchesSingle ? '' : 'none';
            return;
          }

          let catHasMatch = false;
          const subGroups = catItem.querySelectorAll('[data-drawer-subgroup]');
          subGroups.forEach((group) => {
            let groupHasMatch = false;
            const items = group.querySelectorAll('[data-drawer-item]');
            items.forEach((item) => {
              const text = item.textContent?.toLowerCase() || '';
              if (!query || text.includes(query)) {
                item.style.display = '';
                groupHasMatch = true;
                catHasMatch = true;
              } else {
                item.style.display = 'none';
              }
            });
            group.style.display = (!query || groupHasMatch) ? '' : 'none';
          });

          if (query) {
            if (catHasMatch) {
              catItem.style.display = '';
              catItem.classList.add('is-expanded');
              catItem.querySelector('[data-acc-trigger]')?.setAttribute('aria-expanded', 'true');
              const panel = catItem.querySelector('[data-acc-panel]');
              if (panel) panel.hidden = false;
            } else {
              catItem.style.display = 'none';
            }
          } else {
            catItem.style.display = '';
            // Reset to default collapsed state
            const isInitialActive = catItem.classList.contains('is-current-category');
            catItem.classList.toggle('is-expanded', isInitialActive);
            catItem.querySelector('[data-acc-trigger]')?.setAttribute('aria-expanded', isInitialActive ? 'true' : 'false');
            const panel = catItem.querySelector('[data-acc-panel]');
            if (panel) panel.hidden = !isInitialActive;
          }
        });
      });

      drawerClear?.addEventListener('click', () => {
        drawerSearch.value = '';
        drawerSearch.dispatchEvent(new Event('input'));
        drawerSearch.focus();
      });
    }

    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileDrawer();
      });
    });
  }

  initGigsHeader();
  document.addEventListener('astro:after-swap', () => {
    document.body.style.overflow = '';
    const h = document.querySelector('[data-gigs-header]');
    if (h) delete h.dataset.gigsInit;
    initGigsHeader();
  });
</script>

