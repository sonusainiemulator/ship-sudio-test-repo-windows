<script is:inline>
  // Tab Switcher Logic for Right Order Card
  const tabs = document.querySelectorAll('.gd-tab');
  const panels = {
    basic: document.getElementById('panel-basic'),
    standard: document.getElementById('panel-standard'),
    premium: document.getElementById('panel-premium'),
  };

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-target-tab');
      tabs.forEach(t => t.classList.remove('gd-tab--active'));
      tab.classList.add('gd-tab--active');

      Object.keys(panels).forEach(key => {
        if (panels[key]) {
          panels[key].style.display = key === target ? 'block' : 'none';
        }
      });
    });
  });
</script>

