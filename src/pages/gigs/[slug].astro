---
import Layout from "../../layouts/Layout.astro";
import GigsHeader from "../../components/GigsHeader.astro";
import GigCard from "../../components/GigCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { GIGS_CATALOG, type GigItem } from "../../data/gigs";
import { SITE_NAME, SITE_URL, SUPPORT_PHONE, BOOK_CONSULTATION_URL } from "../../consts";

export function getStaticPaths() {
  return GIGS_CATALOG.map((gig) => ({
    params: { slug: gig.slug },
    props: { gig },
  }));
}

interface Props {
  gig: GigItem;
}

const { gig } = Astro.props;

const cleanPhone = SUPPORT_PHONE.replace(/[^0-9]/g, "");
const whatsappMessage = (pkgName: string, priceInr: number) =>
  encodeURIComponent(
    `Hi Rakebig, I want to order the "${pkgName}" package (₹${priceInr.toLocaleString()}) for Gig: "${gig.title}". Please confirm details.`
  );

const pageTitle = `${gig.title} | ${SITE_NAME} Gigs`;
const pageDescription = gig.shortDescription;

const defaultFaqs = [
  {
    question: "How does the ordering and milestone delivery process work?",
    answer: "After selecting your package tier (Basic, Standard, or Premium), you provide your technical requirements. We kick off development within 24 hours, provide live staging previews at milestones, and deliver 100% production-ready source code upon approval."
  },
  {
    question: "Do I get full intellectual property and source code ownership?",
    answer: "Yes, absolutely! 100% full source code ownership, GitHub/GitLab repository transfer, deployment playbooks, and commercial intellectual property rights belong entirely to you."
  },
  {
    question: "What post-delivery support and bug-fix warranty is included?",
    answer: "Every gig includes an SLA-backed bug-fix warranty (ranging from 30 to 90 days depending on package tier) with dedicated direct communication with senior engineers on WhatsApp, Slack, or email."
  },
  {
    question: "Can I request custom modifications beyond the standard package scope?",
    answer: "Yes. You can contact our lead developers directly on WhatsApp (+91 78274 08866) or book a 1-on-1 consultation call to receive a custom tailored proposal for complex enterprise requirements."
  }
];

const gigFaqs = gig.faqs && gig.faqs.length > 0 ? gig.faqs : defaultFaqs;
const relatedGigs = GIGS_CATALOG
  .filter((g) => g.slug !== gig.slug)
  .slice(0, 4);

const keywords = gig.seoKeywords && gig.seoKeywords.length > 0
  ? gig.seoKeywords.join(", ")
  : `${gig.title}, ${gig.subcategory}, ${gig.category}, Rakebig Services, Fiverr Pro, Upwork Agency`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  canonicalPath={`/gigs/${gig.slug}`}
  ogImage={gig.thumbnail}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Product",
      name: gig.title,
      image: `${SITE_URL}${gig.thumbnail}`,
      description: gig.shortDescription,
      sku: gig.id,
      mpn: gig.id,
      brand: {
        "@type": "Brand",
        name: SITE_NAME,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: gig.rating.toString(),
        reviewCount: gig.reviewsCount.toString(),
        bestRating: "5",
        worstRating: "1",
      },
      offers: [
        {
          "@type": "Offer",
          name: `${gig.packages.basic.title} (Basic)`,
          price: gig.packages.basic.priceInr.toString(),
          priceCurrency: "INR",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          priceValidUntil: "2027-12-31",
          url: `${SITE_URL}/gigs/${gig.slug}`,
          seller: {
            "@type": "Organization",
            name: SITE_NAME,
          },
        },
        {
          "@type": "Offer",
          name: `${gig.packages.standard.title} (Standard)`,
          price: gig.packages.standard.priceInr.toString(),
          priceCurrency: "INR",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          priceValidUntil: "2027-12-31",
          url: `${SITE_URL}/gigs/${gig.slug}`,
          seller: {
            "@type": "Organization",
            name: SITE_NAME,
          },
        },
        {
          "@type": "Offer",
          name: `${gig.packages.premium.title} (Premium)`,
          price: gig.packages.premium.priceInr.toString(),
          priceCurrency: "INR",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          priceValidUntil: "2027-12-31",
          url: `${SITE_URL}/gigs/${gig.slug}`,
          seller: {
            "@type": "Organization",
            name: SITE_NAME,
          },
        },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: gigFaqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      name: gig.title,
      serviceType: gig.subcategory,
      provider: {
        "@type": "Organization",
        name: SITE_NAME,
        url: SITE_URL,
      },
      areaServed: "Global",
      description: gig.shortDescription,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: SITE_URL,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Gigs Marketplace",
          item: `${SITE_URL}/gigs`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: gig.subcategory,
          item: `${SITE_URL}/gigs?cat=${gig.category}`,
        },
        {
          "@type": "ListItem",
          position: 4,
          name: gig.title,
          item: `${SITE_URL}/gigs/${gig.slug}`,
        },
      ],
    },
  ]}
>
  <!-- Font Awesome CDN for Fiverr Action Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Fiverr-style Header & Subnav -->
  <GigsHeader activeCategory={gig.category} />

  <main class="gd-main">
    <div class="container gd-container">
      
      <!-- Top Breadcrumbs Row with Action Icons -->
      <div class="gd-top-nav">
        <nav class="gd-breadcrumbs" aria-label="Breadcrumb">
          <a href="/"><i class="fa-solid fa-house"></i></a>
          <span>/</span>
          <a href="/gigs">Gigs</a>
          <span>/</span>
          <a href={`/gigs?cat=${gig.category}`}>{gig.category.replace("-", " ").toUpperCase()}</a>
          <span>/</span>
          <span class="gd-breadcrumbs__current">{gig.subcategory}</span>
        </nav>

        <div class="gd-top-actions">
          <button type="button" class="gd-icon-btn" title="Save to Wishlist">
            <i class="fa-regular fa-heart"></i>
          </button>
          <button type="button" class="gd-icon-btn" title="Share Gig">
            <i class="fa-solid fa-arrow-up-from-bracket"></i>
          </button>
          <button type="button" class="gd-icon-btn" title="More Options">
            <i class="fa-solid fa-ellipsis"></i>
          </button>
        </div>
      </div>

      <!-- Main 2-Column Fiverr Gig Detail Layout -->
      <div class="gd-grid">
        
        <!-- LEFT COLUMN: Content, Gallery, Description, Reviews -->
        <div class="gd-left">
          
          <!-- Gig Main Title -->
          <h1 class="gd-title">{gig.title}</h1>

          <!-- Seller Header Line -->
          <div class="gd-seller-bar">
            <img src={gig.seller.avatar} alt={gig.seller.name} class="gd-seller-avatar" width="48" height="48" />
            <div class="gd-seller-meta">
              <div class="gd-seller-name-row">
                <span class="gd-seller-name">{gig.seller.name}</span>
                <span class="gd-seller-badge">{gig.seller.badge}</span>
              </div>
              <div class="gd-seller-rating">
                <span class="gd-star">★</span>
                <strong>{gig.rating.toFixed(1)}</strong>
                <span class="gd-reviews">({gig.reviewsCount} reviews)</span>
                <span class="gd-queue-tag"><i class="fa-solid fa-bolt text-amber-500 mr-1"></i>{gig.ordersInQueue} orders in queue</span>
              </div>
            </div>
          </div>

          <!-- Main Image Gallery Display -->
          <div class="gd-gallery">
            <div class="gd-gallery__main">
              <img id="main-gig-image" src={gig.thumbnail} alt={gig.title} class="gd-gallery__img" />
              {gig.badge && <span class="gd-gallery__badge">{gig.badge}</span>}
            </div>
            <div class="gd-gallery__thumbs">
              <button type="button" class="gd-thumb gd-thumb--active" onclick={`document.getElementById('main-gig-image').src='${gig.thumbnail}'`}>
                <img src={gig.thumbnail} alt="Thumbnail 1" />
              </button>
              <button type="button" class="gd-thumb" onclick={`document.getElementById('main-gig-image').src='${gig.thumbnail}'`}>
                <img src={gig.thumbnail} alt="Thumbnail 2" />
              </button>
            </div>
          </div>

          <!-- About This Gig Section -->
          <section class="gd-section">
            <h2 class="gd-section-title">About This Gig</h2>
            <div class="gd-prose">
              <p class="gd-lead-text">{gig.shortDescription}</p>
              
              <h3 class="gd-subtitle">Why Choose Rakebig Engineering Squad?</h3>
              <ul class="gd-check-list">
                <li><i class="fa-solid fa-check text-emerald-500 mr-2"></i> <strong>Production-Grade Quality:</strong> Built according to core platform standards with clean, maintainable code.</li>
                <li><i class="fa-solid fa-check text-emerald-500 mr-2"></i> <strong>100% Source Code Ownership:</strong> You get full repository access and IP rights.</li>
                <li><i class="fa-solid fa-check text-emerald-500 mr-2"></i> <strong>Dedicated Support & SLA:</strong> Guaranteed post-delivery warranty and bug-fix SLA.</li>
                <li><i class="fa-solid fa-check text-emerald-500 mr-2"></i> <strong>Direct Developer Communication:</strong> Work directly with senior software architects and project leads.</li>
              </ul>

              <h3 class="gd-subtitle">Technologies &amp; Frameworks Included</h3>
              <div class="gd-tech-pills">
                {gig.technologies.map((tech) => (
                  <span class="gd-tech-pill"><i class="fa-solid fa-code text-blue-500 mr-1.5"></i>{tech}</span>
                ))}
              </div>
            </div>
          </section>

          <!-- Compare Packages Matrix Table -->
          <section class="gd-section">
            <h2 class="gd-section-title">Compare Packages</h2>
            <div class="gd-matrix-scroll-hint">
              <i class="fa-solid fa-arrows-left-right"></i>
              <span>Swipe table horizontally to compare all packages</span>
            </div>
            <div class="gd-matrix-table-wrap">
              <table class="gd-matrix-table">
                <thead>
                  <tr>
                    <th class="gd-matrix-th-label">Package</th>
                    <th>
                      <div class="gd-matrix-pkg-title">Basic</div>
                      <div class="gd-matrix-pkg-price">₹{gig.packages.basic.priceInr.toLocaleString()}</div>
                      <div class="gd-matrix-pkg-usd">(${gig.packages.basic.priceUsd})</div>
                    </th>
                    <th class="gd-matrix-highlight">
                      <div class="gd-matrix-popular-badge">RECOMMENDED</div>
                      <div class="gd-matrix-pkg-title">Standard</div>
                      <div class="gd-matrix-pkg-price">₹{gig.packages.standard.priceInr.toLocaleString()}</div>
                      <div class="gd-matrix-pkg-usd">(${gig.packages.standard.priceUsd})</div>
                    </th>
                    <th>
                      <div class="gd-matrix-pkg-title">Premium</div>
                      <div class="gd-matrix-pkg-price">₹{gig.packages.premium.priceInr.toLocaleString()}</div>
                      <div class="gd-matrix-pkg-usd">(${gig.packages.premium.priceUsd})</div>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="gd-matrix-label">Package Name</td>
                    <td>{gig.packages.basic.title}</td>
                    <td class="gd-matrix-highlight"><strong>{gig.packages.standard.title}</strong></td>
                    <td>{gig.packages.premium.title}</td>
                  </tr>
                  <tr>
                    <td class="gd-matrix-label">Description</td>
                    <td>{gig.packages.basic.description}</td>
                    <td class="gd-matrix-highlight">{gig.packages.standard.description}</td>
                    <td>{gig.packages.premium.description}</td>
                  </tr>
                  <tr>
                    <td class="gd-matrix-label">Delivery Time</td>
                    <td><i class="fa-regular fa-clock mr-1"></i>{gig.packages.basic.deliveryDays} Days</td>
                    <td class="gd-matrix-highlight"><strong><i class="fa-regular fa-clock mr-1"></i>{gig.packages.standard.deliveryDays} Days</strong></td>
                    <td><i class="fa-regular fa-clock mr-1"></i>{gig.packages.premium.deliveryDays} Days</td>
                  </tr>
                  <tr>
                    <td class="gd-matrix-label">Revisions</td>
                    <td>{gig.packages.basic.revisions}</td>
                    <td class="gd-matrix-highlight"><strong>{gig.packages.standard.revisions}</strong></td>
                    <td>{gig.packages.premium.revisions}</td>
                  </tr>
                  <tr>
                    <td class="gd-matrix-label">Select Tier</td>
                    <td>
                      <a href={`https://wa.me/${cleanPhone}?text=${whatsappMessage("Basic", gig.packages.basic.priceInr)}`} target="_blank" class="gd-btn-tier-select">Select Basic</a>
                    </td>
                    <td class="gd-matrix-highlight">
                      <a href={`https://wa.me/${cleanPhone}?text=${whatsappMessage("Standard", gig.packages.standard.priceInr)}`} target="_blank" class="gd-btn-tier-select gd-btn-tier-select--primary">Select Standard</a>
                    </td>
                    <td>
                      <a href={`https://wa.me/${cleanPhone}?text=${whatsappMessage("Premium", gig.packages.premium.priceInr)}`} target="_blank" class="gd-btn-tier-select">Select Premium</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- Seller Profile Card -->
          <section class="gd-section gd-seller-profile-card">
            <h2 class="gd-section-title">Get to Know the Developer</h2>
            <div class="gd-seller-card-inner">
              <img src={gig.seller.avatar} alt={gig.seller.name} class="gd-seller-card-avatar" width="72" height="72" />
              <div class="gd-seller-card-info">
                <h3>{gig.seller.name}</h3>
                <p class="gd-seller-card-role">{gig.seller.role}</p>
                <div class="gd-seller-card-stats">
                  <div><strong>From:</strong> India</div>
                  <div><strong>Avg. Response:</strong> 1 hour</div>
                  <div><strong>Member since:</strong> 2021</div>
                  <div><strong>Last Delivery:</strong> 4 hours ago</div>
                </div>
                <a href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent(`Hi ${gig.seller.name}, I have a question regarding your gig "${gig.title}".`)}`} target="_blank" class="gd-btn-contact-seller">
                  <i class="fa-brands fa-whatsapp text-emerald-500 mr-2 text-base"></i> Contact Seller
                </a>
              </div>
            </div>
          </section>

          <!-- FREE VIDEO CONSULTATION SECTION (Google Meet / Zoom Banner) -->
          <section class="gd-consult-banner" id="consultation-section">
            <div class="gd-consult-banner__ambient-glow" aria-hidden="true"></div>
            <div class="gd-consult-banner__content">
              <div class="gd-consult-banner__badge">
                <span class="gd-consult-pulse"></span>
                <span>100% Free Discovery Call</span>
              </div>
              <h2 class="gd-consult-banner__title">Let's Discuss Your Project on Google Meet or Zoom</h2>
              <p class="gd-consult-banner__desc">
                Have custom architecture requirements, high-volume needs, or want to review your roadmap face-to-face? Book a free 30-minute video session directly with our senior engineering and AI leads.
              </p>

              <!-- Video Platforms supported -->
              <div class="gd-consult-banner__platforms">
                <div class="gd-platform-chip gd-platform-chip--meet">
                  <svg class="gd-platform-chip__icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
                  </svg>
                  <span>Google Meet</span>
                </div>
                <div class="gd-platform-chip gd-platform-chip--zoom">
                  <svg class="gd-platform-chip__icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2.586l4.707-4.707A1 1 0 0 1 22 4.586v14.828a1 1 0 0 1-1.293.957L16 15.414V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6z"/>
                  </svg>
                  <span>Zoom HD Video</span>
                </div>
                <div class="gd-platform-chip gd-platform-chip--screen">
                  <svg class="gd-platform-chip__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                  <span>Live Screen Share</span>
                </div>
              </div>

              <!-- Perks Grid -->
              <div class="gd-consult-banner__perks">
                <div class="gd-consult-perk-card">
                  <div class="gd-consult-perk-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </div>
                  <div>
                    <strong>30 Minutes Free</strong>
                    <span>Full technical scoping with zero pitch pressure</span>
                  </div>
                </div>

                <div class="gd-consult-perk-card">
                  <div class="gd-consult-perk-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  </div>
                  <div>
                    <strong>Fixed-Price Quotation</strong>
                    <span>Receive detailed milestones within 2 hours</span>
                  </div>
                </div>

                <div class="gd-consult-perk-card">
                  <div class="gd-consult-perk-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  </div>
                  <div>
                    <strong>NDA & IP Protected</strong>
                    <span>100% confidential discussion and code ownership</span>
                  </div>
                </div>
              </div>

              <!-- CTA Buttons -->
              <div class="gd-consult-banner__actions">
                <a href={BOOK_CONSULTATION_URL} target="_blank" rel="noopener noreferrer" class="gd-consult-btn-primary">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>Book Free Consultation Call</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a
                  href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent(`Hi Rakebig, I want to book a free Google Meet or Zoom consultation for "${gig.title}". What slots are open?`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="gd-consult-btn-wa"
                >
                  <i class="fa-brands fa-whatsapp text-emerald-400 text-lg"></i>
                  <span>Book via WhatsApp Concierge</span>
                </a>
              </div>
            </div>
          </section>

          <!-- FAQ Accordions -->
          <section class="gd-section">
            <h2 class="gd-section-title">Frequently Asked Questions</h2>
            <div class="gd-faq-list">
              {gigFaqs.map((faq) => (
                <details class="gd-faq-item">
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>

        </div>

        <!-- RIGHT COLUMN: Sticky Fiverr Order Box -->
        <div class="gd-right">
          <div class="gd-sticky-box" id="fiverr-order-box">
            
            <!-- Package Tabs (Basic | Standard | Premium) -->
            <div class="gd-tabs">
              <button type="button" class="gd-tab gd-tab--active" data-target-tab="basic">Basic</button>
              <button type="button" class="gd-tab" data-target-tab="standard">Standard</button>
              <button type="button" class="gd-tab" data-target-tab="premium">Premium</button>
            </div>

            <!-- Basic Tab Panel -->
            <div class="gd-tab-panel" id="panel-basic">
              <div class="gd-pkg-header">
                <div class="gd-pkg-title-row">
                  <span class="gd-pkg-title">{gig.packages.basic.title}</span>
                  <span class="gd-pkg-price">₹{gig.packages.basic.priceInr.toLocaleString()}</span>
                </div>
                <span class="gd-pkg-usd">(${gig.packages.basic.priceUsd} USD)</span>
              </div>
              <p class="gd-pkg-desc">{gig.packages.basic.description}</p>

              <div class="gd-pkg-meta">
                <span><i class="fa-regular fa-clock mr-1.5 text-gray-700"></i><strong>{gig.packages.basic.deliveryDays}-day delivery</strong></span>
                <span><i class="fa-solid fa-rotate-right mr-1.5 text-gray-700"></i><strong>{gig.packages.basic.revisions}</strong></span>
              </div>

              <div class="gd-pkg-features">
                <strong>What's Included:</strong>
                <ul>
                  {gig.packages.basic.features.map((feat) => (
                    <li><i class="fa-solid fa-check text-emerald-600 mr-2"></i>{feat}</li>
                  ))}
                </ul>
              </div>

              <a
                href={`https://wa.me/${cleanPhone}?text=${whatsappMessage("Basic", gig.packages.basic.priceInr)}`}
                target="_blank"
                class="gd-btn-continue"
              >
                <span>Continue</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>

              <a
                href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent(`Hi, I want to discuss custom requirements for "${gig.title}".`)}`}
                target="_blank"
                class="gd-btn-contact"
              >
                <span>Contact Me</span>
                <i class="fa-solid fa-chevron-down text-xs"></i>
              </a>
            </div>

            <!-- Standard Tab Panel -->
            <div class="gd-tab-panel" id="panel-standard" style="display: none;">
              <div class="gd-pkg-badge">CUSTOMIZED FOR YOU</div>
              <div class="gd-pkg-header">
                <div class="gd-pkg-title-row">
                  <span class="gd-pkg-title">{gig.packages.standard.title}</span>
                  <span class="gd-pkg-price">₹{gig.packages.standard.priceInr.toLocaleString()}</span>
                </div>
                <span class="gd-pkg-usd">(${gig.packages.standard.priceUsd} USD)</span>
              </div>
