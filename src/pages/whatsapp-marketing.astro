---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WhatsAppChatSimulator from "../components/WhatsAppChatSimulator.astro";
import {
  WHATSAPP_FEATURES,
  INDUSTRY_SOLUTIONS,
  WHATSAPP_PRICING_PLANS,
} from "../data/whatsappMarketing";
import { SITE_NAME, SITE_URL, BOOK_CONSULTATION_URL } from "../consts";

const pageTitle = `WhatsApp AI Marketing Software & Automation Suite | ${SITE_NAME}`;
const pageDescription =
  "Automate customer engagement on WhatsApp with AI chatbots, visual drag-and-drop flow builder, bulk broadcast campaigns, ecommerce cart recovery, and official Meta Cloud API.";

const defaultIndustry = INDUSTRY_SOLUTIONS[0];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/whatsapp-marketing"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "WhatsappAi - AI Powered WhatsApp Marketing Solution",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Cloud, Web",
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        lowPrice: "0",
        highPrice: "79",
        offerCount: "4",
      },
      description: pageDescription,
      url: `${SITE_URL}/whatsapp-marketing`,
    },
  ]}
>
  <SiteHeader current="product" />

  <main class="wapp-main">
    <!-- ================= HERO SECTION ================= -->
    <section class="wapp-hero">
      <div class="wapp-hero__bg" aria-hidden="true">
        <span class="wapp-hero__orb wapp-hero__orb--1"></span>
        <span class="wapp-hero__orb wapp-hero__orb--2"></span>
        <div class="wapp-hero__grid-pattern"></div>
      </div>

      <div class="container wapp-hero__container">
        <div class="wapp-hero__content reveal">
          <div class="wapp-pill">
            <span class="wapp-pill__dot"></span>
            <span>Meta Official WhatsApp Cloud API Partner</span>
          </div>

          <h1 class="wapp-hero__title">
            Turn WhatsApp into Your <br />
            <span class="wapp-gradient-text">24/7 AI Sales &amp; Support Engine</span>
          </h1>

          <p class="wapp-hero__lead">
            Send targeted bulk broadcasts with 98% open rates, build visual no-code chatbots, recover abandoned ecommerce checkouts, and let personal AI agents handle inquiries automatically.
          </p>

          <div class="wapp-hero__actions">
            <a
              href="https://whatsappai.rakebig.com/register"
              target="_blank"
              rel="noopener noreferrer"
              class="wapp-btn wapp-btn--primary glow-follow"
            >
              <span>Start Free Trial</span>
              <svg viewBox="0 0 16 16" fill="currentColor">
                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
              </svg>
            </a>
            <a
              href="https://www.youtube.com/watch?v=YI2qPPP-3OY&list=PLjVLYmrlmjGdGJsFyEehnwz7hzawnfWoQ"
              target="_blank"
              rel="noopener noreferrer"
              class="wapp-btn wapp-btn--secondary"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="wapp-play-icon">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span>Watch Live Demo</span>
            </a>
            <a href="#industry-solutions" class="wapp-btn wapp-btn--ghost">
              <span>View Industry Solutions ↓</span>
            </a>
          </div>

          <div class="wapp-hero__badges">
            <div class="wapp-badge-item">
              <strong>98%</strong>
              <span>Message Open Rate</span>
            </div>
            <div class="wapp-badge-item">
              <strong>3.4x</strong>
              <span>Higher Conversion</span>
            </div>
            <div class="wapp-badge-item">
              <strong>&lt; 15s</strong>
              <span>AI Response Latency</span>
            </div>
            <div class="wapp-badge-item">
              <strong>0 Ban</strong>
              <span>Official Cloud API</span>
            </div>
          </div>
        </div>

        <!-- Hero Graphic: Live Interactive Preview Card -->
        <div class="wapp-hero__visual reveal">
          <div class="wapp-visual-frame">
            <div class="wapp-visual-header">
              <div class="wapp-visual-dots">
                <span></span><span></span><span></span>
              </div>
              <span class="wapp-visual-title">whatsappai.rakebig.com • Cloud Engine</span>
              <span class="wapp-visual-status">Live Connected</span>
            </div>

            <div class="wapp-visual-canvas">
              <!-- Visual Node Graph Simulator -->
              <div class="node-flow">
                <div class="node-card node-card--trigger">
                  <div class="node-card__header">
                    <span class="node-icon">⚡</span>
                    <strong>Trigger: Meta Ad / Keyword</strong>
                  </div>
                  <p class="node-card__body">User clicks WhatsApp Ad or texts <code>"GET OFFER"</code></p>
                </div>

                <div class="node-arrow">↓</div>

                <div class="node-card node-card--ai">
                  <div class="node-card__header">
                    <span class="node-icon">🤖</span>
                    <strong>Personal AI Knowledge Base</strong>
                  </div>
                  <p class="node-card__body">LLM evaluates intent, queries product catalog &amp; personalizes offer</p>
                </div>

                <div class="node-arrow">↓</div>

                <div class="node-branch">
                  <div class="node-card node-card--action">
                    <div class="node-card__header">
                      <span class="node-icon">🛍️</span>
                      <strong>Checkout Hook</strong>
                    </div>
                    <p class="node-card__body">Send dynamic checkout link + 10% coupon</p>
                  </div>

                  <div class="node-card node-card--sync">
                    <div class="node-card__header">
                      <span class="node-icon">🔄</span>
                      <strong>Perfex CRM Sync</strong>
                    </div>
                    <p class="node-card__body">Create lead, update deal stage &amp; assign agent</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CORE FEATURES GRID ================= -->
    <section class="wapp-features-sec" id="features">
      <div class="container">
        <div class="wapp-sec-header reveal">
          <span class="eyebrow">Enterprise WhatsApp Suite</span>
          <h2 class="wapp-sec-title">Everything You Need to Scale Customer Conversations</h2>
          <p class="wapp-sec-lead">
            Eliminate chaotic phone handoffs and fragile third-party scrapers. Built from the ground up on official Meta Cloud infrastructure.
          </p>
        </div>

        <div class="wapp-features-grid">
          {WHATSAPP_FEATURES.map((feature, idx) => (
            <div class="wapp-feature-card reveal" style={`animation-delay: ${idx * 0.1}s`}>
              <div class="wapp-feature-card__icon-wrap">
                {feature.icon === "flow" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                    <path d="M10 6.5h4M17.5 10v4M6.5 10v7a2 2 0 002 2h5.5"></path>
                  </svg>
                )}
                {feature.icon === "cart" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                )}
                {feature.icon === "brain" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-5.04zM14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-5.04z"></path>
                  </svg>
                )}
                {feature.icon === "broadcast" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  </svg>
                )}
                {feature.icon === "team" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {feature.icon === "api" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                )}
              </div>
              <h3 class="wapp-feature-card__title">{feature.title}</h3>
              <p class="wapp-feature-card__subtitle">{feature.subtitle}</p>
              <p class="wapp-feature-card__desc">{feature.description}</p>
              <ul class="wapp-feature-card__list">
                {feature.highlights.map((item) => (
                  <li>
                    <svg viewBox="0 0 16 16" fill="currentColor">
                      <path fill-rule="evenodd" d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= INTERACTIVE INDUSTRY SOLUTIONS TAB MENU ================= -->
    <section class="wapp-industry-sec" id="industry-solutions">
      <div class="container">
        <div class="wapp-sec-header reveal">
          <span class="eyebrow eyebrow--green">Industry Solutions</span>
          <h2 class="wapp-sec-title">Tailored WhatsApp AI Workflows for Your Exact Industry</h2>
          <p class="wapp-sec-lead">
            Select your vertical below to experience the live conversational flow and see how businesses in your niche automate leads, sales, and support.
          </p>
        </div>

        <!-- Industry Horizontal Tabs Bar -->
        <div class="wapp-ind-tabs-nav reveal">
          <div class="wapp-ind-tabs-scroller" role="tablist">
            {INDUSTRY_SOLUTIONS.map((ind, idx) => (
              <button
                type="button"
                role="tab"
                class={`wapp-ind-tab-btn ${idx === 0 ? "wapp-ind-tab-btn--active" : ""}`}
                data-industry-tab={ind.id}
                aria-selected={idx === 0 ? "true" : "false"}
              >
                <span class="wapp-ind-tab-icon">
                  {ind.icon === "bag" && "🛍️"}
                  {ind.icon === "health" && "🏥"}
                  {ind.icon === "home" && "🏢"}
                  {ind.icon === "edu" && "🎓"}
                  {ind.icon === "travel" && "🌴"}
                  {ind.icon === "finance" && "📈"}
                </span>
                <span class="wapp-ind-tab-text">{ind.name}</span>
                {ind.badge && <span class="wapp-ind-tab-badge">{ind.badge}</span>}
              </button>
            ))}
          </div>
        </div>

        <!-- Industry Interactive Showcase (Split: Left content & Right phone simulator) -->
        <div class="wapp-ind-showcase reveal">
          <!-- Left Panel: Details -->
          <div class="wapp-ind-panel">
            {INDUSTRY_SOLUTIONS.map((ind, idx) => (
              <div
                class={`wapp-ind-content ${idx === 0 ? "wapp-ind-content--active" : ""}`}
                data-industry-panel={ind.id}
              >
                <div class="wapp-ind-badge-row">
                  <span class="wapp-tag-pill">{ind.badge}</span>
                  <span class="wapp-verified-chip">Verified Solution Template</span>
                </div>

                <h3 class="wapp-ind-title">{ind.name}</h3>
                <p class="wapp-ind-tagline">{ind.tagline}</p>
                <p class="wapp-ind-desc">{ind.description}</p>

                <!-- Key Metrics -->
                <div class="wapp-ind-metrics">
                  {ind.metrics.map((m) => (
                    <div class="wapp-ind-metric-card">
                      <strong>{m.value}</strong>
                      <span>{m.label}</span>
                    </div>
                  ))}
                </div>

                <!-- Ready Workflows -->
                <div class="wapp-ind-workflows">
                  <h4>Pre-Built Production Workflows:</h4>
                  <ul>
                    {ind.workflows.map((wf) => (
                      <li>
                        <svg viewBox="0 0 16 16" fill="currentColor">
                          <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z"/>
                        </svg>
                        <span>{wf}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Action Button -->
                <div class="wapp-ind-actions">
                  <a
                    href={`https://whatsappai.rakebig.com/register?ref=${ind.id}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wapp-btn wapp-btn--primary"
                  >
                    Deploy {ind.name} Flow Free
                  </a>
                  <a href={BOOK_CONSULTATION_URL} target="_blank" rel="noopener noreferrer" class="wapp-btn wapp-btn--secondary">
                    Custom Architecture Consultation
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Right Panel: Live Mobile WhatsApp Simulator -->
          <div class="wapp-ind-simulator">
            <WhatsAppChatSimulator
              activeSolution={defaultIndustry}
              allSolutions={INDUSTRY_SOLUTIONS}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PRICING SECTION ================= -->
    <section class="wapp-pricing-sec" id="pricing">
      <div class="container">
        <div class="wapp-sec-header reveal">
          <span class="eyebrow">Transparent Pricing</span>
          <h2 class="wapp-sec-title">Simple, Predictable Plans for Every Stage</h2>
          <p class="wapp-sec-lead">
            Choose the perfect plan for your business size. Upgrade, downgrade, or cancel anytime. All plans run on official Meta Cloud APIs.
          </p>

          <!-- Monthly / Yearly Billing Toggle -->
          <div class="wapp-billing-toggle" data-billing-toggle>
            <span class="wapp-billing-label" data-billing-type="monthly">Monthly</span>
            <button type="button" class="wapp-toggle-switch" aria-label="Toggle Billing Frequency" id="pricing-toggle-btn">
              <span class="wapp-toggle-thumb"></span>
            </button>
            <span class="wapp-billing-label wapp-billing-label--active" data-billing-type="yearly">
              Yearly
              <em class="wapp-save-pill">Save 20%</em>
            </span>
          </div>
        </div>

        <!-- Pricing Cards Grid matching whatsappai.rakebig.com -->
        <div class="wapp-pricing-grid">
          {WHATSAPP_PRICING_PLANS.map((plan) => (
            <div class={`wapp-pricing-card ${plan.popular ? "wapp-pricing-card--popular" : ""} reveal`}>
              {plan.badge && (
                <div class="wapp-pricing-badge">
                  <span>{plan.badge}</span>
                </div>
              )}

              <div class="wapp-pricing-card__header">
                <h3 class="wapp-plan-name">{plan.name}</h3>
                <p class="wapp-plan-tagline">{plan.tagline}</p>
                <div class="wapp-plan-price">
                  <span class="wapp-price-val" data-monthly={plan.priceMonthly} data-yearly={plan.priceYearly}>
                    {plan.priceYearly}
                  </span>
                  <span class="wapp-price-term">/ month</span>
                </div>
              </div>

              <!-- Quick Specs Pills -->
              <div class="wapp-plan-specs">
                <div class="wapp-spec-chip">
                  <strong>{plan.contacts}</strong>
                </div>
                <div class="wapp-spec-chip">
                  <strong>{plan.campaigns}</strong>
                </div>
                <div class="wapp-spec-chip">
                  <strong>{plan.staff}</strong>
                </div>
              </div>

              <!-- Feature Checklist -->
              <ul class="wapp-plan-features">
                {plan.highlights.map((feat) => (
                  <li>
                    <svg viewBox="0 0 16 16" fill="currentColor">
                      <path fill-rule="evenodd" d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="wapp-pricing-card__footer">
                <a
                  href={plan.ctaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`wapp-btn wapp-btn--block ${plan.popular ? "wapp-btn--primary" : "wapp-btn--secondary"}`}
                >
                  Get Started with {plan.name}
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="wapp-pricing-note reveal">
          <p>
            💡 Need higher volumes, dedicated bare-metal servers, or custom Perfex CRM webhooks? <a href={BOOK_CONSULTATION_URL} target="_blank" rel="noopener noreferrer">Talk to our enterprise engineering team →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ================= FAQ SECTION ================= -->
    <section class="wapp-faq-sec">
      <div class="container wapp-faq__container">
        <div class="wapp-sec-header reveal">
          <span class="eyebrow">Frequently Asked Questions</span>
          <h2 class="wapp-sec-title">Common Questions About WhatsApp AI</h2>
        </div>

        <div class="wapp-faq-list reveal">
          <details class="wapp-faq-item" open>
            <summary class="wapp-faq-item__q">
              <span>Will my WhatsApp number get banned for sending bulk broadcasts?</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="wapp-faq-item__a">
              <p>No. We operate strictly on the <strong>Official Meta WhatsApp Cloud API</strong> with pre-approved message templates. Unlike unofficial scraping QR bots that get blacklisted within hours, our official API integration safeguards your brand reputation with zero ban risks.</p>
            </div>
          </details>

          <details class="wapp-faq-item">
            <summary class="wapp-faq-item__q">
              <span>Can I connect this with our Shopify store and Perfex CRM?</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="wapp-faq-item__a">
              <p>Yes, absolutely! We provide pre-built webhook endpoints for Shopify, WooCommerce, and Perfex CRM. When a cart is abandoned, an order is placed, or a new lead fills out a form, WhatsApp AI triggers the corresponding conversational flow instantly.</p>
            </div>
          </details>

          <details class="wapp-faq-item">
            <summary class="wapp-faq-item__q">
              <span>How does the Personal AI Assistant learn our company information?</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="wapp-faq-item__a">
              <p>You can upload your PDF brochures, paste your website documentation links, and define FAQ pairs. The system automatically converts your knowledge into vector embeddings. When a user asks a question, the assistant retrieves the exact answer in natural human language.</p>
            </div>
          </details>

          <details class="wapp-faq-item">
            <summary class="wapp-faq-item__q">
              <span>Can multiple support agents respond from the same WhatsApp number?</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="wapp-faq-item__a">
              <p>Yes. Our Shared Team Inbox supports up to 10,000 staff agents on one central WhatsApp number. You can assign chats to specific reps, leave private internal notes, set canned responses, and monitor resolution times in real time.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <section class="wapp-cta-sec">
      <div class="container">
        <div class="wapp-cta-card reveal">
          <div class="wapp-cta-content">
            <h2 class="wapp-cta-title">Ready to Automate Your WhatsApp Sales Funnel?</h2>
            <p class="wapp-cta-lead">
              Join thousands of fast-growing businesses scaling customer conversations with Rakebig's WhatsApp AI Suite.
            </p>
            <div class="wapp-cta-buttons">
              <a
                href="https://whatsappai.rakebig.com/register"
                target="_blank"
                rel="noopener noreferrer"
                class="wapp-btn wapp-btn--primary"
              >
                Start 14-Day Free Trial
              </a>
              <a
                href={BOOK_CONSULTATION_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="wapp-btn wapp-btn--secondary"
              >
                Schedule Team Demo
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script is:inline>
  // Industry Tab Switching
  const tabBtns = document.querySelectorAll('[data-industry-tab]');
  const panels = document.querySelectorAll('[data-industry-panel]');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-industry-tab');

      // Update button states
      tabBtns.forEach(b => {
        b.classList.remove('wapp-ind-tab-btn--active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('wapp-ind-tab-btn--active');
      btn.setAttribute('aria-selected', 'true');

      // Update panel visibility
      panels.forEach(p => {
        p.classList.remove('wapp-ind-content--active');
        if (p.getAttribute('data-industry-panel') === targetId) {
          p.classList.add('wapp-ind-content--active');
        }
      });

      // Update Phone Chat Simulator
      if (typeof window.updateWhatsAppSimulator === 'function') {
        window.updateWhatsAppSimulator(targetId);
      }
    });
  });

  // Billing Toggle (Monthly / Yearly)
  const toggleBtn = document.getElementById('pricing-toggle-btn');
  const priceValues = document.querySelectorAll('.wapp-price-val');
  let isYearly = true;

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isYearly = !isYearly;
      toggleBtn.classList.toggle('wapp-toggle-switch--monthly', !isYearly);

      priceValues.forEach(el => {
        const val = isYearly ? el.getAttribute('data-yearly') : el.getAttribute('data-monthly');
        el.textContent = val;
      });

      document.querySelectorAll('[data-billing-type]').forEach(lbl => {
        const type = lbl.getAttribute('data-billing-type');
        lbl.classList.toggle('wapp-billing-label--active', (isYearly && type === 'yearly') || (!isYearly && type === 'monthly'));
      });
    });
  }
</script>

<style>
  .wapp-main {
    background: #0d1117;
    color: #e6edf3;
    overflow-x: hidden;
  }

  /* ============ HERO SECTION ============ */
  .wapp-hero {
    position: relative;
    padding: 100px 0 80px 0;
    overflow: hidden;
  }

  .wapp-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .wapp-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.28;
  }

  .wapp-hero__orb--1 {
    top: -10%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: #00A884;
  }

  .wapp-hero__orb--2 {
    bottom: -15%;
    right: -10%;
    width: 650px;
    height: 650px;
    background: #2563eb;
  }

  .wapp-hero__grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 0%, transparent 75%);
  }

  .wapp-hero__container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 48px;
    position: relative;
    z-index: 2;
  }

  .wapp-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 168, 132, 0.12);
    border: 1px solid rgba(0, 168, 132, 0.35);
    color: #25D366;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .wapp-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25D366;
    animation: pillPulse 1.8s infinite;
  }

  .wapp-hero__title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 20px 0;
  }

  .wapp-gradient-text {
    background: linear-gradient(135deg, #25D366 0%, #00A884 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wapp-hero__lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 32px 0;
    max-width: 580px;
  }

  .wapp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
  }

  .wapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .wapp-btn--primary {
    background: #00A884;
    color: #ffffff;
    border: 1px solid #00A884;
    box-shadow: 0 10px 25px -5px rgba(0, 168, 132, 0.4);
  }

  .wapp-btn--primary:hover {
    background: #25D366;
    border-color: #25D366;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(37, 211, 102, 0.5);
  }

  .wapp-btn--primary svg {
    width: 16px;
    height: 16px;
  }

  .wapp-btn--secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
  }

  .wapp-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .wapp-play-icon {
    width: 18px;
    height: 18px;
    color: #25D366;
  }

  .wapp-btn--ghost {
    color: #94a3b8;
    background: transparent;
    padding: 12px 16px;
  }

  .wapp-btn--ghost:hover {
    color: #25D366;
  }

  .wapp-btn--block {
    width: 100%;
    justify-content: center;
  }

  .wapp-hero__badges {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .wapp-badge-item strong {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
  }

  .wapp-badge-item span {
    font-size: 0.76rem;
    color: #94a3b8;
  }

  /* Hero Visual Card */
  .wapp-visual-frame {
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .wapp-visual-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #0d1117;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .wapp-visual-dots {
    display: flex;
    gap: 6px;
  }

  .wapp-visual-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #30363d;
  }

  .wapp-visual-dots span:nth-child(1) { background: #ef4444; }
  .wapp-visual-dots span:nth-child(2) { background: #eab308; }
  .wapp-visual-dots span:nth-child(3) { background: #22c55e; }

  .wapp-visual-title {
    font-size: 0.78rem;
    color: #8b949e;
    font-family: monospace;
  }

  .wapp-visual-status {
    font-size: 0.7rem;
    font-weight: 600;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    padding: 2px 8px;
    border-radius: 12px;
  }

  .wapp-visual-canvas {
    padding: 24px;
    background: radial-gradient(circle at center, rgba(37, 211, 102, 0.04) 0%, transparent 70%);
  }

  .node-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .node-arrow {
    font-size: 1.2rem;
    color: #00A884;
    font-weight: 800;
  }

  .node-card {
    width: 100%;
    background: #21262d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .node-card__header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .node-icon {
    font-size: 1.1rem;
  }

  .node-card__body {
    font-size: 0.78rem;
    color: #8b949e;
    margin: 0;
  }

  .node-card__body code {
    background: #0d1117;
    color: #25D366;
    padding: 1px 5px;
    border-radius: 4px;
  }

  .node-branch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
  }

  /* ============ COMMON SECTION HEADERS ============ */
  .wapp-sec-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px auto;
  }

  .wapp-sec-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 12px 0 16px 0;
  }

  .wapp-sec-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  /* ============ FEATURES SECTION ============ */
  .wapp-features-sec {
    padding: 90px 0;
    background: #0d1117;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .wapp-feature-card {
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 28px;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .wapp-feature-card:hover {
    border-color: rgba(0, 168, 132, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }

  .wapp-feature-card__icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0, 168, 132, 0.12);
    color: #00A884;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .wapp-feature-card__icon-wrap svg {
    width: 24px;
    height: 24px;
  }

  .wapp-feature-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px 0;
  }

  .wapp-feature-card__subtitle {
    font-size: 0.86rem;
    font-weight: 600;
    color: #00A884;
    margin: 0 0 12px 0;
  }

  .wapp-feature-card__desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #8b949e;
    margin: 0 0 20px 0;
  }

  .wapp-feature-card__list {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 16px;
  }

  .wapp-feature-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.82rem;
    color: #c9d1d9;
    line-height: 1.4;
  }

  .wapp-feature-card__list svg {
    width: 14px;
    height: 14px;
    color: #00A884;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ============ INDUSTRY SOLUTIONS TAB SECTION ============ */
  .wapp-industry-sec {
    padding: 90px 0;
    background: #090d12;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-ind-tabs-nav {
    margin-bottom: 40px;
  }

  .wapp-ind-tabs-scroller {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
  }

  .wapp-ind-tabs-scroller::-webkit-scrollbar {
    display: none;
  }

  .wapp-ind-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    color: #8b949e;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .wapp-ind-tab-btn:hover {
    border-color: rgba(0, 168, 132, 0.4);
    color: #ffffff;
    background: #21262d;
  }

  .wapp-ind-tab-btn--active {
    background: #00A884;
    border-color: #00A884;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 168, 132, 0.35);
  }

  .wapp-ind-tab-badge {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.25);
    padding: 2px 7px;
    border-radius: 12px;
    text-transform: uppercase;
  }

  .wapp-ind-showcase {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  .wapp-ind-panel {
    min-width: 0;
  }

  .wapp-ind-content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .wapp-ind-content--active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .wapp-ind-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .wapp-tag-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: #00A884;
    background: rgba(0, 168, 132, 0.12);
    border: 1px solid rgba(0, 168, 132, 0.3);
    padding: 3px 10px;
    border-radius: 14px;
    text-transform: uppercase;
  }

  .wapp-verified-chip {
    font-size: 0.74rem;
    color: #8b949e;
  }

  .wapp-ind-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
  }

  .wapp-ind-tagline {
    font-size: 1.05rem;
    font-weight: 600;
    color: #38bdf8;
    margin: 0 0 16px 0;
  }

  .wapp-ind-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #8b949e;
    margin: 0 0 24px 0;
  }

  .wapp-ind-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }

  .wapp-ind-metric-card {
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 14px;
  }

  .wapp-ind-metric-card strong {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: #25D366;
    letter-spacing: -0.02em;
  }

  .wapp-ind-metric-card span {
    font-size: 0.74rem;
    color: #8b949e;
  }

  .wapp-ind-workflows h4 {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .wapp-ind-workflows ul {
    list-style: none;
    padding: 0;
    margin: 0 0 28px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wapp-ind-workflows li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.85rem;
    color: #c9d1d9;
  }

  .wapp-ind-workflows svg {
    width: 15px;
    height: 15px;
    color: #00A884;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .wapp-ind-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ============ PRICING SECTION ============ */
  .wapp-pricing-sec {
    padding: 90px 0;
    background: #0d1117;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-billing-toggle {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    background: #161b22;
    padding: 6px 16px;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .wapp-billing-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: #8b949e;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .wapp-billing-label--active {
    color: #ffffff;
  }

  .wapp-save-pill {
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 700;
    color: #25D366;
    background: rgba(37, 211, 102, 0.15);
    padding: 2px 7px;
    border-radius: 10px;
  }

  .wapp-toggle-switch {
    width: 44px;
    height: 24px;
    border-radius: 14px;
    background: #00A884;
    border: none;
    cursor: pointer;
    position: relative;
    padding: 2px;
    transition: background 0.2s ease;
  }

  .wapp-toggle-thumb {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(20px);
  }

  .wapp-toggle-switch--monthly .wapp-toggle-thumb {
    transform: translateX(0);
  }

  .wapp-toggle-switch--monthly {
    background: #30363d;
  }

  .wapp-pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .wapp-pricing-card {
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.25s ease;
  }

  .wapp-pricing-card:hover {
    border-color: rgba(0, 168, 132, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }

  .wapp-pricing-card--popular {
    border-color: #00A884;
    background: linear-gradient(180deg, rgba(0, 168, 132, 0.08) 0%, #161b22 60%);
    box-shadow: 0 0 0 1px #00A884, 0 20px 40px rgba(0, 168, 132, 0.2);
  }

  .wapp-pricing-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #00A884;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 12px;
    border-radius: 12px;
    white-space: nowrap;
  }

  .wapp-pricing-card__header {
    margin-bottom: 20px;
  }

  .wapp-plan-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px 0;
  }

  .wapp-plan-tagline {
    font-size: 0.8rem;
    line-height: 1.4;
    color: #8b949e;
    min-height: 38px;
    margin: 0 0 14px 0;
  }

  .wapp-plan-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .wapp-price-val {
    font-size: 2.3rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .wapp-price-term {
    font-size: 0.85rem;
    color: #8b949e;
  }

  .wapp-plan-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-spec-chip {
    font-size: 0.74rem;
    color: #c9d1d9;
    background: #0d1117;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .wapp-plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.82rem;
    color: #8b949e;
    line-height: 1.4;
  }

  .wapp-plan-features svg {
    width: 14px;
    height: 14px;
    color: #00A884;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .wapp-pricing-note {
    text-align: center;
    font-size: 0.92rem;
    color: #8b949e;
  }

  .wapp-pricing-note a {
    color: #00A884;
    text-decoration: underline;
    font-weight: 600;
  }

  /* ============ FAQ SECTION ============ */
  .wapp-faq-sec {
    padding: 80px 0;
    background: #090d12;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wapp-faq__container {
    max-width: 800px;
  }

  .wapp-faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .wapp-faq-item {
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .wapp-faq-item__q {
    padding: 18px 22px;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .wapp-faq-item__q::-webkit-details-marker {
    display: none;
  }

  .wapp-faq-item__q svg {
    width: 18px;
    height: 18px;
    color: #8b949e;
    transition: transform 0.2s ease;
  }

  .wapp-faq-item[open] .wapp-faq-item__q svg {
    transform: rotate(180deg);
    color: #00A884;
  }

  .wapp-faq-item__a {
    padding: 0 22px 20px 22px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #8b949e;
  }

  .wapp-faq-item__a strong {
    color: #ffffff;
  }

  /* ============ BOTTOM CTA ============ */
  .wapp-cta-sec {
    padding: 80px 0;
    background: #0d1117;
  }

  .wapp-cta-card {
    background: linear-gradient(135deg, rgba(0, 168, 132, 0.15) 0%, rgba(37, 211, 102, 0.05) 100%), #161b22;
    border: 1px solid rgba(0, 168, 132, 0.3);
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  .wapp-cta-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
