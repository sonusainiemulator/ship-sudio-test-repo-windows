---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AiCard from "../components/AiCard.astro";
import SolutionBlock from "../components/SolutionBlock.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { BOOK_CONSULTATION_URL } from "../consts";
import { solutions } from "../data/solutions";

const footerCols = [
  {
    title: "",
    links: [
      "Services",
      "Pricing",
      "Case Studies",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];
---

<Layout
  title="AI & Business Automation Solutions | Rakebig Services"
  description="Discover practical AI automation workflows, Perfex CRM automations, and custom software solutions designed to streamline business operations."
  canonicalPath="/solutions"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "AI & Business Automation Solutions",
      "description": "Practical AI automation workflows, Perfex CRM automations, and custom software solutions designed to streamline business operations.",
      "url": "https://www.rakebig.com/solutions"
    }
  ]}
>
  <SiteHeader current="solutions" />

  <main>
    <!-- ============ HERO ============ -->
    <section class="shero">
      <div class="shero__panel">
        <div class="shero__panel-bg" aria-hidden="true">
          <span class="shero__blob shero__blob--1"></span>
          <span class="shero__blob shero__blob--2"></span>
          <span class="shero__blob shero__blob--3"></span>
          <img class="shero__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" width="1920" height="1438" fetchpriority="high" decoding="async" />
        </div>
        <div class="shero__card reveal">
          <AiCard />
        </div>
      </div>
      <div class="container shero__inner">
        <div class="shero__text reveal-stagger">
          <span class="eyebrow eyebrow--mark">
            <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
            Solutions
          </span>
          <h1 class="shero__title">Turn Perfex CRM into<br />your growth engine.</h1>
          <p class="shero__desc">
            Dashboards tell you what happened. Rakebig builds the CRM and
            SaaS systems that act on it—unifying your sales, support
            tickets, and payments into one platform your team can actually
            run on.
          </p>
          <div class="shero__cta">
            <PrimaryButton
              label="Book a Consultation"
              href={BOOK_CONSULTATION_URL}
              bg="#0c0e1c"
              color="#ffffff"
              glow="rgba(206, 226, 242, 0.5)"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FEATURE BLOCKS ============ -->
    <section class="sblocks">
      <div class="container sblocks__inner reveal-stagger">
        <SolutionBlock
          eyebrow="Customize"
          title="Perfex CRM configured for how you sell"
          body="Rakebig customizes Perfex CRM with modules built for your process—workflow automation, staff payroll and commissions, and multi-tenant SaaS setup for agencies reselling under their own brand."
          panelBg="#cee2f2"
          panelBlob="#659cff"
          ctaHref="/services/perfex-crm-solutions"
        />
        <SolutionBlock
          eyebrow="Connect"
          title="Every channel unified in one platform"
          body="WhatsApp, IP telephony, and payment gateways—connected into one CRM so a lead, a call, and a payment all show up on the same timeline, not three different tools."
          reverse={true}
          panelBg="#c5eeef"
          panelBlob="#319393"
          ctaHref="/services/business-integrations"
        />
        <SolutionBlock
          eyebrow="Deploy"
          title="Deployed on infrastructure that doesn't fall over"
          body="When your CRM or SaaS platform ships, Rakebig sets up the servers, domains, SSL, and CI/CD pipelines behind it—then keeps monitoring so it stays online."
          panelBg="#e2e6f2"
          panelBlob="#8fa8e6"
          ctaHref="/services/cloud-deployment-devops"
        />
      </div>
    </section>

    <!-- ============ ALL SOLUTIONS CATALOG ============ -->
    <section class="sol-catalog">
      <div class="container">
        <div class="sol-catalog__head reveal">
          <span class="eyebrow eyebrow--mark">
            <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
            AI Solutions Catalog
          </span>
          <h2 class="sol-catalog__title">Autonomous AI systems built for real operations</h2>
          <p class="sol-catalog__desc">
            Explore our specialized AI applications, document extractors, and workflow pipelines built to scale company operations.
          </p>
        </div>

        <div class="sol-catalog__grid reveal-stagger">
          {solutions.map((s) => (
            <a href={`/solutions/${s.slug}`} class="sol-catalog-card">
              <div class="sol-catalog-card__top">
                <span class="sol-catalog-card__chip" style={`background:${s.tintColor};color:${s.accentColor}`}>
                  {s.category}
                </span>
                <span class="sol-catalog-card__arrow" aria-hidden="true">→</span>
              </div>
              <h3 class="sol-catalog-card__name">{s.name}</h3>
              <p class="sol-catalog-card__summary">{s.shortSummary}</p>
              <div class="sol-catalog-card__footer">
                <span class="sol-catalog-card__link">Explore solution →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Get your systems built right this quarter.</h2>
        <p class="cta__sub">
          Growing companies run their CRM, SaaS, and internal tools on
          Rakebig.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a Consultation" href={BOOK_CONSULTATION_URL} /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <SiteFooter />
</Layout>

<style>
  /* ---------- shared eyebrow marker ---------- */
  .eyebrow--mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ---------- HERO ---------- */
  .shero {
    position: relative;
    background: #eeeef4;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    min-height: max(820px, 90vh);
  }
  .shero__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52vw;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* lavender on the left drifting to blue on the right */
  .shero__panel-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 45% at 30% 28%, #e6ddf9 0%, transparent 70%),
      radial-gradient(60% 60% at 100% 92%, #bcccf4 0%, transparent 68%),
      linear-gradient(115deg, #ddd2f4 0%, #d3d4f0 48%, #c3d3f3 100%);
  }
  .shero__blob { position: absolute; border-radius: 50%; filter: blur(120px); }
  .shero__blob--1 { width: 55%; height: 55%; top: 2%; left: 6%; background: #e7ddfa; opacity: 0.75; }
  .shero__blob--2 { width: 60%; height: 60%; bottom: -14%; right: -10%; background: #a9c2f2; opacity: 0.7; }
  .shero__blob--3 { width: 38%; height: 40%; top: 26%; right: 24%; background: #efe9fc; opacity: 0.5; }
  .shero__noise {
    position: absolute;
    top: 42%; left: 55%;
    width: 150%;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    opacity: 0.9;
    pointer-events: none;
  }
  .shero__card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 360px;
    padding: 0 20px;
    align-self: center;
    /* nudge the card toward the upper-right, matching the master */
    margin-right: -4%;
  }
  .shero__card :global(.ai-card) { max-width: 360px; }
  .shero__inner { position: relative; width: 100%; }
  .shero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 460px;
    padding: 88px 0;
  }
  .shero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .shero__desc {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(12, 14, 28, 0.62);
    max-width: 400px;
  }
  .shero__cta { margin-top: 4px; }

  /* ---------- FEATURE BLOCKS ---------- */
  .sblocks { padding: 112px 0; }
  .sblocks__inner { display: flex; flex-direction: column; gap: 24px; }

  /* ---------- CTA (sage variant) ---------- */
  .cta { position: relative; background: #e8ebe1; padding: 120px 0; overflow: hidden; }
  .cta__blob { position: absolute; border-radius: 50%; filter: blur(90px); }
  .cta__blob--1 { width: 520px; height: 400px; top: -120px; left: -80px; background: rgba(255, 255, 255, 0.6); }
  .cta__blob--2 { width: 500px; height: 380px; bottom: -140px; right: -60px; background: rgba(200, 213, 187, 0.6); }
  .cta__noise {
    position: absolute;
    inset: 0;
    background-image: url("/assets/cta-noise-tile.png");
    background-repeat: repeat-x;
    background-position: center;
    background-size: 78% 100%;
    mix-blend-mode: screen;
    opacity: 0.7;
    pointer-events: none;
  }
  .cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  .cta__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 620px;
  }
  .cta__sub { font-size: 14px; line-height: 1.5; color: rgba(12, 14, 28, 0.6); max-width: 340px; }
  .cta__btn { margin-top: 4px; }

  /* ---------- FOOTER (shared with home) ---------- */
  .footer { padding: 80px 0 64px; border-top: 1px solid var(--color-line); }
  .footer__inner { display: flex; justify-content: space-between; gap: 60px; flex-wrap: wrap; }
  .footer__brand { font-size: 20px; }
  .footer__cols { display: flex; gap: 56px; flex-wrap: wrap; }
  .footer__col-title { margin-bottom: 16px; text-transform: lowercase; }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .footer__col a {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer__col a:hover { color: var(--color-ink); }

  /* ---------- SOLUTIONS CATALOG SECTION ---------- */
  .sol-catalog {
    padding: 96px 0 64px;
    background: #f8fafc;
    border-top: 1px solid #ebebeb;
    border-bottom: 1px solid #ebebeb;
  }
  .sol-catalog__head {
    max-width: 680px;
    margin-bottom: 48px;
  }
  .sol-catalog__title {
    font-family: var(--font-display, "Tobias TRIAL", serif);
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 12px 0 16px;
    color: var(--color-ink);
  }
  .sol-catalog__desc {
    font-size: 16.5px;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }
  .sol-catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .sol-catalog-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .sol-catalog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    border-color: #3b82f6;
  }
  .sol-catalog-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .sol-catalog-card__chip {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .sol-catalog-card__arrow {
    color: #3b82f6;
    font-weight: 700;
    font-size: 16px;
    transition: transform 0.2s ease;
  }
  .sol-catalog-card:hover .sol-catalog-card__arrow {
    transform: translateX(4px);
  }
  .sol-catalog-card__name {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #0f172a;
  }
  .sol-catalog-card__summary {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #64748b;
    flex-grow: 1;
  }
  .sol-catalog-card__footer {
    margin-top: 10px;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
  }
  .sol-catalog-card__link {
    font-size: 13px;
    font-weight: 600;
    color: #2563eb;
  }

  @media (max-width: 1024px) {
    .sol-catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .sol-catalog__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1000px) {
    .shero { display: flex; flex-direction: column; min-height: 0; }
    .shero__panel {
      position: static;
      order: 2;
      width: 100%;
      min-height: 420px;
      padding: 48px 0;
    }
    .shero__inner { order: 1; }
    .shero__text { max-width: none; padding: 64px 0 40px; }
    .shero__card { max-width: 340px; margin-right: 0; }
    .sblocks { padding: 72px 0; }
  }
  @media (max-width: 720px) {
    .footer__cols { gap: 32px; }
  }
</style>
