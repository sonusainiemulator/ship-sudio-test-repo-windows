                <span>{f}</span>
              </li>
            ))}
          </ul>
        </aside>

        <div class="features2__cards reveal-stagger">
          <ComparisonCard
            eyebrow="CAPTURE"
            title="Hear every customer, not just the loud ones"
            subtitle="Traditional tools tell you what happened. Loopwise tells you what to do about it."
            button={true}
