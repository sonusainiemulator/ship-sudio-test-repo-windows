            intelligence="Every touchpoint, every customer, unified in real time"
            panelBlob="#c8d5bb"
            btnGlow="#c8d5bb"
          />
          <ComparisonCard
            eyebrow="PRIORITIZE"
            title="Tagging that understands your product"
            subtitle="Traditional tools tell you what happened. Loopwise tells you what to do about it."
            button={true}
            traditional="Analysts hand-sorting feedback into generic buckets"
            intelligence="Auto-tagging that learns your taxonomy and sharpens over time"
            panelBlob="#cee2f2"
            btnGlow="#cee2f2"
          />
          <ComparisonCard
            title="From static reports to a living roadmap"
            traditional="Dashboards that show what happened weeks ago"
            intelligence="Signals that predict what's coming and trigger action on their own"
            panelBlob="#eddfff"
          />
          <ComparisonCard
