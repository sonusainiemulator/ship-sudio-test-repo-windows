---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProductPanel from "../components/ProductPanel.astro";
import FeatureRow from "../components/FeatureRow.astro";
import TeamCard from "../components/TeamCard.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ComparisonCard from "../components/ComparisonCard.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";

const footerCols = [
  {
    title: "",
    links: [
      "Services",
      "Pricing",
      "Case Studies",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];

const testimonials = [
  {
    company: "Northbeam Retail",
    name: "Priya Anand",
    role: "VP of Operations",
    avatar: "/assets/rectangle-240664309.png",
    quote:
      "Rakebig didn't hand us a deck—they customized our Perfex CRM to match our actual order process and wired WhatsApp straight into it. Ops stopped juggling four tools and started working from one screen.",
  },
  {
    company: "Halcyon Health",
    name: "Marcus Webb",
    role: "Chief Technology Officer",
    avatar: "https://randomuser.me/api/portraits/men/45.jpg",
    quote:
      "We'd tried two agencies who could only theme the CRM. Rakebig built us custom Perfex modules against our real patient workflow and had it live in six weeks.",
  },
  {
    company: "Vertex Logistics",
    name: "Elena Cho",
    role: "Director of Automation",
    avatar: "https://randomuser.me/api/portraits/women/44.jpg",
    quote:
      "The dispatch dashboard Rakebig built now handles routing decisions our team used to manage in spreadsheets. It's connected to our CRM, our calling system, and it just works.",
  },
  {
    company: "Meridian Bank",
    name: "David Okafor",
    role: "Head of Digital Transformation",
    avatar: "https://randomuser.me/api/portraits/men/33.jpg",
    quote:
      "Compliance review was our biggest blocker for any new system. Rakebig built the audit trail and permissions in from day one, so it shipped with sign-off instead of fighting for it after.",
  },
  {
    company: "Orbit Media",
    name: "Sofia Marin",
    role: "VP of Product",
    avatar: "https://randomuser.me/api/portraits/men/76.jpg",
    quote:
      "Every other vendor wanted to sell us a platform. Rakebig just built the thing—a multi-tenant SaaS product with billing, tenant management, and a dashboard our clients actually use.",
  },
  {
    company: "Summit Manufacturing",
    name: "Tom Rutherford",
    role: "Chief Operating Officer",
    avatar: "https://randomuser.me/api/portraits/women/65.jpg",
    quote:
      "Server issues used to mean a 2am phone call to whoever built the site. Now Rakebig's DevOps team catches it, fixes it, and we hear about it after it's already resolved.",
  },
];

// Five fictional clients, cycled across the 5×2 "trusted by" grid (10 cells)
const baseLogos = [
  { name: "Northbeam" },
  { name: "Halcyon" },
  { name: "Vertex" },
  { name: "Meridian" },
  { name: "Orbit" },
];
const trustedCells = [3, 0, 4, 1, 2, 2, 4, 0, 3, 1].map((i) => baseLogos[i]);
---

<Layout title="Rakebig — IT Services, Consulting & Perfex CRM SaaS Solutions">
  <SiteHeader current="home" />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="hero-bg__blob hero-bg__blob--1"></span>
        <span class="hero-bg__blob hero-bg__blob--2"></span>
        <span class="hero-bg__blob hero-bg__blob--3"></span>
        <span class="hero-bg__blob hero-bg__blob--4"></span>
        <img class="hero-bg__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" />
      </div>
      <div class="container hero-inner reveal-stagger">
        <span class="hero-badge">
          <span class="hero-badge__shine" aria-hidden="true"></span>
          <span class="hero-badge__text">New — Rakebig SaaS Studio</span>
        </span>

        <h1 class="hero-title text-left">
          Stop working around software.<br />
          Start running systems built for you.
        </h1>

        <div class="hero-lower">
          <p class="hero-desc">
            Rakebig designs, builds, and supports custom software, Perfex CRM,
            and SaaS platforms for growing businesses—so your team runs on
            systems built for how you actually work, not a template you have
            to work around.
          </p>
          <div class="hero-cta">
            <PrimaryButton
              label="Book a Consultation"
              bg="#0c0e1c"
              color="#ffffff"
              glow="rgba(206, 226, 242, 0.5)"
            />
            <PrimaryButton label="See our work" />
          </div>
        </div>

        <div class="hero-visual">
          <ProductPanel bg="#cee2f2" blob="#659cff" patternOpacity={0.5} />
        </div>

        <!-- Trusted by -->
        <div class="trusted">
          <p class="trusted__label">Trusted by teams at:</p>
          <div class="trusted__grid">
            {trustedCells.map((l) => (
              <div class="trusted__cell glow-follow" data-glow-rest="center">
                <span class="glow-follow__blob" aria-hidden="true"></span>
                <span class="trusted__logo trusted__wordmark">{l.name}</span>
                <a href="#" class="trusted__reveal" aria-label={`${l.name} — view case study`}>
                  View case study <span class="trusted__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PLATFORM / FEATURES ============ -->
    <section class="platform">
      <div class="container">
        <h2 class="platform__title reveal">
          The IT partner your whole company runs on
        </h2>

        <div class="feature-rows reveal-stagger">
          <FeatureRow
            eyebrow="CONSULT"
            title="Technical consulting that starts with your workflow"
            subtitle="We map your processes and systems before writing a line of code."
            description="Rakebig audits your current stack, workflows, and bottlenecks—then designs a technical roadmap for custom software, automation, or SaaS that actually fits how your team works."
            statValue="2 weeks"
            statLabel="from kickoff to a scoped roadmap"
            logo="Halcyon"
            panelBg="#eddfff"
            panelBlob="#659cff"
            btnGlow="#eddfff"
            statBlob="#eee4fb"
          />
          <FeatureRow
            eyebrow="BUILD"
            title="Perfex CRM and custom software, built to fit"
            subtitle="From CRM customization to full SaaS platforms, engineered for your stack."
            description="Our engineers build and customize Perfex CRM, Laravel and Vue applications, and multi-tenant SaaS platforms against your real data and workflows—not a generic template forced to fit."
            statValue="3x faster"
            statLabel="delivery vs. generic off-the-shelf setups"
            logo="Vertex"
            panelBg="#cee2f2"
            panelBlob="#659cff"
            reverse={true}
          />
          <FeatureRow
            eyebrow="SUPPORT"
            title="DevOps, hosting, and support that don't disappear"
            subtitle="We stay on to deploy, monitor, and extend what we build."
            description="Rakebig sets up your CI/CD pipelines, cloud infrastructure, domains, and SSL—then stays on as your DevOps and support partner as your systems grow."
            panelBg="#c5eeef"
            panelBlob="#c8d5bb"
          />
        </div>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="story">
      <div class="story-inner">
        <span class="eyebrow story__eyebrow reveal">
          <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
          why we started rakebig
        </span>
        <h2 class="story__title reveal">Most businesses run on software that almost fits.</h2>
        <p class="story__lead">
          Off-the-shelf CRMs get customized until they break. SaaS tools pile
          up until nobody remembers which one owns which data. The workflow
          every team actually follows lives in someone's head, not in any
          system anyone paid for.
        </p>
        <div class="story-reveal">
          <p>
            The problem was never a shortage of software. It's the distance
            between a tool that's 80% right and a system that's actually
            yours—the gap teams quietly work around every day.
          </p>
          <p>
            Every business runs a real process underneath the mess. Left
            unbuilt, it's tribal knowledge. Engineered properly, it's a
            system the whole team can rely on.
          </p>
          <p>
            The businesses pulling ahead don't wait for a platform to catch
            up to them. They get Perfex CRM configured for how they sell,
            their SaaS built for how they bill, and their integrations wired
            for how they actually communicate.
          </p>
          <p>
            That's the shift Rakebig is built for—from software you work
            around to software you work on.
          </p>
          <p>
            When a system finally fits, nobody has to be convinced it was
            worth building. The support tickets just stop.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ FEATURE COMPARISON (sticky nav + stacked cards) ============ -->
    <section class="features2">
      <div class="container features2__inner">
        <aside class="features2__nav reveal">
          <p class="features2__lead">
            Most IT vendors sell you a template. Rakebig builds you a system.
          </p>
          <ul class="feat-nav">
            {["Consult", "Build", "Integrate", "Support"].map((f, i) => (
              <li class={`feat-nav__item ${i === 0 ? "is-active" : ""}`}>
                <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </aside>

        <div class="features2__cards reveal-stagger">
          <ComparisonCard
            eyebrow="CONSULT"
            title="Advice grounded in how you actually work"
            subtitle="Most IT vendors sell you a template. Rakebig builds you a system."
            button={true}
            traditional="Generic recommendations from a sales deck"
            intelligence="A roadmap built from your real workflows, data, and stack"
            panelBlob="#c8d5bb"
            btnGlow="#c8d5bb"
          />
          <ComparisonCard
            eyebrow="BUILD"
            title="Perfex CRM that fits, not fights, your process"
            subtitle="Most IT vendors sell you a template. Rakebig builds you a system."
            button={true}
            traditional="Off-the-shelf CRM stretched until it breaks"
            intelligence="Perfex CRM customized and extended for your actual sales process"
            panelBlob="#cee2f2"
            btnGlow="#cee2f2"
          />
          <ComparisonCard
            title="From scattered tools to one connected system"
            traditional="WhatsApp, calling, and payments running in separate silos"
            intelligence="Every channel wired into one CRM, one dashboard, one source of truth"
            panelBlob="#eddfff"
          />
          <ComparisonCard
            eyebrow="SUPPORT"
            title="DevOps that doesn't end at handoff"
            subtitle="Most IT vendors sell you a template. Rakebig builds you a system."
            button={true}
            traditional="A deployment guide and a wave goodbye"
            intelligence="An embedded team that manages your CI/CD, hosting, and uptime"
            panelBlob="#c5eeef"
            btnGlow="#c5eeef"
          />
        </div>
      </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->
    <section class="stories">
      <div class="stories__bg" aria-hidden="true">
        <span class="stories__blob stories__blob--beige"></span>
        <span class="stories__blob stories__blob--teal"></span>
        <span class="stories__blob stories__blob--blue"></span>
        <img class="stories__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
      </div>

      <div class="container stories__inner">
        <div class="stories__head reveal">
          <h2 class="stories__title">How teams run on Rakebig</h2>
          <p class="stories__sub">
            Operations, sales, and engineering teams at growing companies run
            their CRM, SaaS, and internal tools on Rakebig.
          </p>
          <PrimaryButton label="Explore case studies" bg="#ffffff" glow="rgba(206, 226, 242, 0.9)" />
        </div>

        <div class="carousel reveal" data-carousel>
          {testimonials.map((t, i) => (
            <button class={`ctab ${i === 0 ? "is-open" : ""}`} type="button" data-i={i} aria-expanded={i === 0 ? "true" : "false"}>
              <span class="ctab__bg" aria-hidden="true">
                <img class="ctab__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
              </span>
              <span class="ctab__collapsed">
                <svg class="ctab__icon" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
                  <path d="M0 24V13.5C0 6 4.5 1 12 0L13 4C8 5.5 6 8 6 12H12V24H0ZM18 24V13.5C18 6 22.5 1 30 0L31 4C26 5.5 24 8 24 12H30V24H18Z"/>
                </svg>
                <span class="ctab__brand">{t.company}</span>
              </span>
              <div class="ctab__body">
                <div class="ctab__top">
                  <svg class="ctab__qi" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
                    <path d="M0 24V13.5C0 6 4.5 1 12 0L13 4C8 5.5 6 8 6 12H12V24H0ZM18 24V13.5C18 6 22.5 1 30 0L31 4C26 5.5 24 8 24 12H30V24H18Z"/>
                  </svg>
                  <blockquote class="ctab__quote">“{t.quote}”</blockquote>
                </div>
                <div class="ctab__foot">
                  <span class="ctab__company">{t.company}</span>
                  <div class="ctab__author">
                    <div class="ctab__meta">
                      <span class="ctab__name">{t.name}</span>
                      <span class="ctab__role">{t.role}</span>
                    </div>
                    {t.avatar ? (
                      <img class="ctab__avatar" src={t.avatar} alt={t.name} />
                    ) : (
                      <span class="ctab__avatar ctab__avatar--ph">{t.name.split(" ").map((n) => n[0]).join("")}</span>
                    )}
                  </div>
                </div>
              </div>
            </button>
          ))}
        </div>

        <div class="stories__dots" data-dots>
          {testimonials.map((t, i) => (
            <button
              type="button"
              class={`stories__dot ${i === 0 ? "is-active" : ""}`}
              data-i={i}
              aria-label={`Show ${t.company} testimonial`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ TEAMS (Supercharge) ============ -->
    <section class="teams">
      <div class="container">
        <div class="teams__head reveal">
          <h2 class="teams__title">
            Give every team a system built for how they work
          </h2>
          <p class="teams__sub">
            From operations to sales to engineering, everyone gets tools that
            fit the job—not a platform they have to work around.
          </p>
          <PrimaryButton label="See our work" bg="#efeff1" />
        </div>

        <div class="teams__grid reveal-stagger">
          <TeamCard
            label="Operations"
            body="Cut the manual busywork between tools and catch process breakdowns before they cost you a customer."
            bg="#cfe1c1"
            blob="#c8d5bb"
          />
          <TeamCard
            label="Engineering"
            body="Ship on Laravel, Vue, and Flutter with CI/CD already wired—not another stack to maintain solo."
            bg="#cbd8f5"
            blob="#7392ff"
          />
          <TeamCard
            label="Leadership"
            body="Watch support tickets drop and throughput climb as every workflow finally has a home."
            bg="#c3d3f2"
            blob="#4f74e6"
          />
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Get your systems built right this quarter.</h2>
        <p class="cta__sub">
          Growing companies run their CRM, SaaS, and internal tools on
          Rakebig.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a Consultation" /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container footer__inner reveal">
      <a href="#" class="wordmark footer__brand">
        <svg class="wordmark__mark" viewBox="0 0 22 22" aria-hidden="true">
          <rect width="22" height="22" rx="6" fill="currentColor" />
          <text x="11" y="12" text-anchor="middle" dominant-baseline="central" font-family="var(--font-display)" font-size="13" font-weight="500" fill="#ffffff">R</text>
        </svg>
        Rakebig
      </a>
      <div class="footer__cols">
        {footerCols.map((col) => (
          <div class="footer__col">
            {col.title && <p class="footer__col-title eyebrow">{col.title}</p>}
            <ul>
              {col.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Scroll-spy: highlight the FEATURE #N nav item for the card crossing viewport center.
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".features2__cards .cmp-card")
  );
  const navItems = Array.from(
    document.querySelectorAll<HTMLElement>(".feat-nav__item")
  );
  if (cards.length && navItems.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            navItems.forEach((n, i) => n.classList.toggle("is-active", i === idx));
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    cards.forEach((c) => spy.observe(c));
  }

  // Story: scroll-linked word reveal — faded words brighten to full as they scroll up.
  const revealWrap = document.querySelector<HTMLElement>(".story-reveal");
  if (revealWrap && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    revealWrap.querySelectorAll("p").forEach((p) => {
      const words = (p.textContent ?? "").trim().split(/\s+/);
      p.innerHTML = words.map((w) => `<span class="rw">${w}</span>`).join(" ");
    });
    const rw = Array.from(revealWrap.querySelectorAll<HTMLElement>(".rw"));
    let ticking = false;
    const paint = () => {
      ticking = false;
      const vh = window.innerHeight;
      const startY = vh * 0.88; // words below this line are faded
      const endY = vh * 0.42; // words above this line are full
      for (const w of rw) {
        const r = w.getBoundingClientRect();
        const y = r.top + r.height / 2;
        let p = (startY - y) / (startY - endY);
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        w.style.opacity = (0.12 + 0.88 * p).toFixed(3);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    paint();
  }

  // Testimonials accordion: expand a tab (or its dot) and close the others; sync both.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const tabs = Array.from(carousel.querySelectorAll<HTMLElement>(".ctab"));
    const dots = Array.from(
      carousel.parentElement?.querySelectorAll<HTMLElement>(".stories__dot") ?? []
    );
    const open = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle("is-open", j === i);
        t.setAttribute("aria-expanded", String(j === i));
      });
      dots.forEach((d, j) => d.classList.toggle("is-active", j === i));
    };
    tabs.forEach((tab, i) => tab.addEventListener("click", () => open(i)));
    dots.forEach((dot, i) => dot.addEventListener("click", () => open(i)));
  });
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding: 72px 0 64px;
    background: var(--color-panel);
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero-bg__blob {
    position: absolute;
    border-radius: 50%;
    background: var(--color-blue);
    filter: blur(150px);
    opacity: 0.9;
  }
  .hero-bg__blob--1 { width: 640px; height: 560px; top: 4%; right: 30%; }
  .hero-bg__blob--2 { width: 1000px; height: 420px; top: -12%; left: -18%; opacity: 0.7; }
  .hero-bg__blob--3 { width: 380px; height: 340px; top: -10%; right: -6%; }
  .hero-bg__blob--4 { width: 420px; height: 360px; bottom: 8%; left: -14%; opacity: 0.7; }
  .hero-bg__noise {
    position: absolute;
    top: 22%; right: -14%;
    width: 820px;
    max-width: 62%;
    mix-blend-mode: screen;
    opacity: 0.9;
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; }
  .hero-badge {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #e9f1fa 0%, #dde9f6 100%);
    border: 1px solid #fff;
    box-shadow: 0 2px 8px rgba(12, 14, 28, 0.06);
    border-radius: 4px;
    padding: 8px 12px;
    overflow: hidden;
  }
  .hero-badge__text {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  /* thin white highlight that sweeps left <-> right */
  .hero-badge__shine {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 160%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    filter: blur(7px);
    animation: badge-shine 7s ease-in-out infinite alternate;
  }
  @keyframes badge-shine {
    0%   { transform: translate(-50%, -50%) translateX(-62px); }
    100% { transform: translate(-50%, -50%) translateX(62px); }
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 30px 0;
    max-width: 1000px;
  }
  .hero-lower {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 360px;
  }
  .hero-desc {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(12, 14, 28, 0.6);
  }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge__shine { animation: none; }
  }

  .hero-visual { margin: 44px 0; }

  /* Trusted */
  .trusted { margin-top: 20px; }
  .trusted__label {
    font-size: 14px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.48);
    margin-bottom: 10px;
  }
  .trusted__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }
  .trusted__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    background: rgba(255, 255, 255, 0.6);
    padding: 16px;
    overflow: hidden;
    /* cursor-follow glow tuning for the grid cells */
    --glow-color: rgba(206, 226, 242, 0.9);
    --glow-size: 150px;
  }
  /* glow hidden at rest, revealed + following the cursor on hover */
  .trusted__cell .glow-follow__blob {
    z-index: 0;
    opacity: 0;
    transition: transform var(--glow-ease, 0.3s) ease-out, opacity 0.25s ease;
  }
  .trusted__cell:hover .glow-follow__blob,
  .trusted__cell:focus-within .glow-follow__blob { opacity: 1; }
  .trusted__logo {
    position: relative;
    z-index: 1;
    opacity: 0.75;
    max-width: 100%;
    transition: opacity 0.2s ease;
  }
  .trusted__wordmark {
