import ProductPanel from "../components/ProductPanel.astro";
import FeatureRow from "../components/FeatureRow.astro";
import TeamCard from "../components/TeamCard.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ComparisonCard from "../components/ComparisonCard.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";

const footerCols = [
  {
    title: "",
    links: [
      "Product",
      "Pricing",
      "Customers",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];

const testimonials = [
  {
    company: "Apollo.io",
    logo: "/assets/apolloioidtgvxmayv1-1.svg",
    icon: "/assets/apollo-mark.svg",
    name: "Jesse Walker",
    role: "Head of Insights & User Advocacy",
    avatar: "/assets/rectangle-240664309.png",
    quote:
      "Loopwise gives every team a live view of what customers are asking for and whose job it is to answer. Prioritization went from a monthly argument to a five-minute look at the board.",
  },
  {
    company: "Linear",
    logo: "/assets/linearlogo0-1.svg",
    icon: "/assets/si-linear.svg",
    name: "Nan Yu",
    role: "Head of Product",
    avatar: "https://randomuser.me/api/portraits/men/45.jpg",
    quote:
      "Thousands of scattered signals now roll up into one honest picture of what users need. Every release we ship moves a number we actually care about.",
  },
  {
    company: "Notion",
    logo: "/assets/logosvg.svg",
    icon: "/assets/si-notion.svg",
    name: "Camille Ricketts",
    role: "VP of Marketing",
    avatar: "https://randomuser.me/api/portraits/women/44.jpg",
    quote:
      "Loopwise flags a theme while it's still small enough to fix. We catch churn signals weeks earlier, and the right team hears about it without anyone forwarding a thread.",
  },
  {
    company: "Perplexity",
    logo: "/assets/frame-2018778295.svg",
    icon: "/assets/si-perplexity.svg",
