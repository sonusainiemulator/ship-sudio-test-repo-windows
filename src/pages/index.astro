          <p class="trusted__label">Trusted by teams at:</p>
          <div class="trusted__grid">
            {trustedCells.map((l) => (
              <div class="trusted__cell glow-follow" data-glow-rest="center">
                <span class="glow-follow__blob" aria-hidden="true"></span>
                <img class="trusted__logo" src={l.src} alt={l.alt} style={`height:${l.h}px`} />
