        <span class="hero-bg__blob hero-bg__blob--2"></span>
        <span class="hero-bg__blob hero-bg__blob--3"></span>
        <span class="hero-bg__blob hero-bg__blob--4"></span>
        <img class="hero-bg__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" />
      </div>
      <div class="container hero-inner reveal-stagger">
        <span class="hero-badge">
          <span class="hero-badge__shine" aria-hidden="true"></span>
          <span class="hero-badge__text">New — Loopwise Signal Engine</span>
        </span>

        <h1 class="hero-title text-left">
          Stop collecting feedback.<br />
          Start closing loops.
        </h1>

        <div class="hero-lower">
          <p class="hero-desc">
            Loopwise captures every customer signal, decides what actually
            matters, and routes it to the team that can act—so you close the
            loop in hours, not quarters.
          </p>
          <div class="hero-cta">
            <PrimaryButton
              label="Book a demo"
              bg="#0c0e1c"
              color="#ffffff"
              glow="rgba(206, 226, 242, 0.5)"
            />
            <PrimaryButton label="See it in action" />
          </div>
        </div>

        <div class="hero-visual">
          <ProductPanel bg="#cee2f2" blob="#659cff" patternOpacity={0.5} />
        </div>

        <!-- Trusted by -->
