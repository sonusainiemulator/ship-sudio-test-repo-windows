      </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->
    <section class="stories">
      <div class="stories__bg" aria-hidden="true">
        <span class="stories__blob stories__blob--beige"></span>
        <span class="stories__blob stories__blob--teal"></span>
        <span class="stories__blob stories__blob--blue"></span>
        <img class="stories__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
      </div>

      <div class="container stories__inner">
        <div class="stories__head reveal">
          <h2 class="stories__title">How teams close the loop with Loopwise</h2>
          <p class="stories__sub">
            Product, support, and CX teams at fast-growing companies run their
            feedback on Loopwise.
          </p>
          <PrimaryButton label="Explore customer stories" bg="#ffffff" glow="rgba(206, 226, 242, 0.9)" />
        </div>

        <div class="carousel reveal" data-carousel>
          {testimonials.map((t, i) => (
            <button class={`ctab ${i === 0 ? "is-open" : ""}`} type="button" data-i={i} aria-expanded={i === 0 ? "true" : "false"}>
              <span class="ctab__bg" aria-hidden="true">
                <img class="ctab__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
              </span>
              <span class="ctab__collapsed">
                <img class="ctab__icon" src={t.icon} alt="" />
                <span class="ctab__brand">{t.company}</span>
              </span>
              <div class="ctab__body">
                <div class="ctab__top">
                  <img class="ctab__qi" src={t.icon} alt={t.company} />
                  <blockquote class="ctab__quote">“{t.quote}”</blockquote>
                </div>
                <div class="ctab__foot">
                  <span class="ctab__company">{t.company}</span>
                  <div class="ctab__author">
                    <div class="ctab__meta">
                      <span class="ctab__name">{t.name}</span>
                      <span class="ctab__role">{t.role}</span>
                    </div>
                    {t.avatar ? (
                      <img class="ctab__avatar" src={t.avatar} alt={t.name} />
                    ) : (
                      <span class="ctab__avatar ctab__avatar--ph">{t.name.split(" ").map((n) => n[0]).join("")}</span>
                    )}
                  </div>
                </div>
              </div>
            </button>
          ))}
        </div>

        <div class="stories__dots" data-dots>
          {testimonials.map((t, i) => (
            <button
              type="button"
              class={`stories__dot ${i === 0 ? "is-active" : ""}`}
              data-i={i}
              aria-label={`Show ${t.company} testimonial`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ TEAMS (Supercharge) ============ -->
    <section class="teams">
      <div class="container">
        <div class="teams__head reveal">
          <h2 class="teams__title">
            Give every team the customer's voice
          </h2>
          <p class="teams__sub">
            From product to support to leadership, everyone works from the same
            live signal—and the same closed loop.
          </p>
          <PrimaryButton label="See it in action" bg="#efeff1" />
        </div>

        <div class="teams__grid reveal-stagger">
          <TeamCard
            label="Customer experience"
            body="Catch friction early and fix root causes—not the same complaint on repeat."
            bg="#cfe1c1"
            blob="#c8d5bb"
          />
          <TeamCard
            label="Product"
            body="Build from what customers actually ask for, ranked by reach and revenue."
            bg="#cbd8f5"
            blob="#7392ff"
          />
          <TeamCard
            label="Leadership"
            body="Watch retention and NPS climb as every loop closes a little faster."
            bg="#c3d3f2"
            blob="#4f74e6"
          />
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Close your first loop this week.</h2>
        <p class="cta__sub">
          Teams at Perplexity, Notion, and Linear close the loop on customer
          feedback with Loopwise.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a demo" /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container footer__inner reveal">
      <a href="#" class="wordmark footer__brand">
        <span class="wordmark__mark" aria-hidden="true"></span>
        Loopwise
      </a>
      <div class="footer__cols">
        {footerCols.map((col) => (
          <div class="footer__col">
            {col.title && <p class="footer__col-title eyebrow">{col.title}</p>}
            <ul>
              {col.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Scroll-spy: highlight the FEATURE #N nav item for the card crossing viewport center.
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".features2__cards .cmp-card")
  );
  const navItems = Array.from(
    document.querySelectorAll<HTMLElement>(".feat-nav__item")
  );
  if (cards.length && navItems.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            navItems.forEach((n, i) => n.classList.toggle("is-active", i === idx));
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    cards.forEach((c) => spy.observe(c));
  }

  // Story: scroll-linked word reveal — faded words brighten to full as they scroll up.
  const revealWrap = document.querySelector<HTMLElement>(".story-reveal");
  if (revealWrap && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    revealWrap.querySelectorAll("p").forEach((p) => {
      const words = (p.textContent ?? "").trim().split(/\s+/);
      p.innerHTML = words.map((w) => `<span class="rw">${w}</span>`).join(" ");
    });
    const rw = Array.from(revealWrap.querySelectorAll<HTMLElement>(".rw"));
    let ticking = false;
    const paint = () => {
      ticking = false;
      const vh = window.innerHeight;
      const startY = vh * 0.88; // words below this line are faded
      const endY = vh * 0.42; // words above this line are full
      for (const w of rw) {
        const r = w.getBoundingClientRect();
        const y = r.top + r.height / 2;
        let p = (startY - y) / (startY - endY);
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        w.style.opacity = (0.12 + 0.88 * p).toFixed(3);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    paint();
  }

  // Testimonials accordion: expand a tab (or its dot) and close the others; sync both.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const tabs = Array.from(carousel.querySelectorAll<HTMLElement>(".ctab"));
    const dots = Array.from(
      carousel.parentElement?.querySelectorAll<HTMLElement>(".stories__dot") ?? []
    );
    const open = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle("is-open", j === i);
        t.setAttribute("aria-expanded", String(j === i));
      });
      dots.forEach((d, j) => d.classList.toggle("is-active", j === i));
    };
    tabs.forEach((tab, i) => tab.addEventListener("click", () => open(i)));
    dots.forEach((dot, i) => dot.addEventListener("click", () => open(i)));
  });
</script>

<style>
  /* ---------- NAV ---------- */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .wordmark__mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--color-ink);
    display: inline-block;
  }
  .nav-links {
    display: flex;
    gap: 22px;
    list-style: none;
  }
  .nav-links a {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--color-ink); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-login {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
  }
  .nav-login:hover { background: var(--color-panel); }
  .nav-demo {
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
    background: var(--color-panel);
    border: 1px solid #fff;
  }
  .nav-demo:hover { background: #e6e6ea; }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding: 72px 0 64px;
    background: var(--color-panel);
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero-bg__blob {
    position: absolute;
    border-radius: 50%;
    background: var(--color-blue);
    filter: blur(150px);
    opacity: 0.9;
  }
  .hero-bg__blob--1 { width: 640px; height: 560px; top: 4%; right: 30%; }
  .hero-bg__blob--2 { width: 1000px; height: 420px; top: -12%; left: -18%; opacity: 0.7; }
  .hero-bg__blob--3 { width: 380px; height: 340px; top: -10%; right: -6%; }
  .hero-bg__blob--4 { width: 420px; height: 360px; bottom: 8%; left: -14%; opacity: 0.7; }
  .hero-bg__noise {
    position: absolute;
    top: 22%; right: -14%;
    width: 820px;
    max-width: 62%;
    mix-blend-mode: screen;
    opacity: 0.9;
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; }
  .hero-badge {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #e9f1fa 0%, #dde9f6 100%);
    border: 1px solid #fff;
    box-shadow: 0 2px 8px rgba(12, 14, 28, 0.06);
    border-radius: 4px;
    padding: 8px 12px;
    overflow: hidden;
  }
  .hero-badge__text {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  /* thin white highlight that sweeps left <-> right */
  .hero-badge__shine {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 160%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    filter: blur(7px);
    animation: badge-shine 7s ease-in-out infinite alternate;
  }
  @keyframes badge-shine {
    0%   { transform: translate(-50%, -50%) translateX(-62px); }
    100% { transform: translate(-50%, -50%) translateX(62px); }
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
