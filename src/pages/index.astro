---
import Layout from "../layouts/Layout.astro";
import ProductPanel from "../components/ProductPanel.astro";
import FeatureRow from "../components/FeatureRow.astro";
import TeamCard from "../components/TeamCard.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ComparisonCard from "../components/ComparisonCard.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";

const footerCols = [
  {
    title: "",
    links: [
      "Services",
      "Pricing",
      "Case Studies",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];

const testimonials = [
  {
    company: "Northbeam Retail",
    name: "Priya Anand",
    role: "VP of Operations",
    avatar: "/assets/rectangle-240664309.png",
    quote:
      "Cortexa didn't hand us a deck—they shipped an agent that reconciles our inventory feed every night without anyone touching it. Ops went from firefighting discrepancies to reviewing an already-clean report.",
  },
  {
    company: "Halcyon Health",
    name: "Marcus Webb",
    role: "Chief Technology Officer",
    avatar: "https://randomuser.me/api/portraits/men/45.jpg",
    quote:
      "We'd tried two other vendors who could only demo. Cortexa built against our actual EHR integration and had a working agent in production inside six weeks.",
  },
  {
    company: "Vertex Logistics",
    name: "Elena Cho",
    role: "Director of Automation",
    avatar: "https://randomuser.me/api/portraits/women/44.jpg",
    quote:
      "The dispatch agent Cortexa built now handles routing decisions our team used to spend two hours a day on. It just runs, and it's right more often than we were.",
  },
  {
    company: "Meridian Bank",
    name: "David Okafor",
    role: "Head of Digital Transformation",
    avatar: "https://randomuser.me/api/portraits/men/33.jpg",
    quote:
      "Compliance review was our biggest blocker for AI. Cortexa built the guardrails in from day one, so the agent shipped with sign-off instead of fighting for it after the fact.",
  },
  {
    company: "Orbit Media",
    name: "Sofia Marin",
    role: "VP of Product",
    avatar: "https://randomuser.me/api/portraits/men/76.jpg",
    quote:
      "Every other agency wanted to sell us a platform. Cortexa just built the thing—an agent that drafts our campaign reports before the team even asks for them.",
  },
  {
    company: "Summit Manufacturing",
    name: "Tom Rutherford",
    role: "Chief Operating Officer",
    avatar: "https://randomuser.me/api/portraits/women/65.jpg",
    quote:
      "Downtime used to mean scrolling through logs by hand. Now the agent flags the anomaly, pulls the maintenance history, and pages the right technician automatically.",
