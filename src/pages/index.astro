          <FeatureRow
            eyebrow="CAPTURE"
            title="Every signal in one place"
            subtitle="Tickets, reviews, calls, and surveys—captured and tagged the moment they land."
            description="Loopwise plugs into 50+ tools and pulls every customer conversation into one stream, enriched with account, plan, and revenue context—so nothing important slips through the cracks again."
            statValue="12x faster"
            statLabel="triage vs. hand-sorting feedback"
            logoSrc="/assets/logosvg.svg"
            panelBg="#eddfff"
            panelBlob="#659cff"
            btnGlow="#eddfff"
            statBlob="#eee4fb"
          />
          <FeatureRow
            eyebrow="PRIORITIZE"
            title="Always know what to build next"
            subtitle="Loopwise ranks every request by reach, revenue, and momentum."
            description="See which themes are accelerating, which accounts they touch, and exactly what they're worth—so prioritization stops being a debate and roadmap calls become obvious."
            statValue="3x more"
            statLabel="requests shipped each quarter"
            logo="Canva"
            panelBg="#cee2f2"
            panelBlob="#659cff"
            reverse={true}
          />
          <FeatureRow
            eyebrow="CLOSE"
            title="Close the loop on autopilot"
            subtitle="Route each theme to its owner and tell customers the moment you ship."
            description="Loopwise learns your product taxonomy and team structure, then sends every insight to the person who can act—and reopens the conversation with customers as soon as it's resolved."
            panelBg="#c5eeef"
            panelBlob="#c8d5bb"
          />
        </div>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="story">
      <div class="story-inner">
        <span class="eyebrow story__eyebrow reveal">
          <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
          why we built loopwise
