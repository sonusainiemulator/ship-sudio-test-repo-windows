];

// Five fictional clients, cycled across the 5×2 "trusted by" grid (10 cells)
const baseLogos = [
  { name: "Northbeam" },
  { name: "Halcyon" },
  { name: "Vertex" },
  { name: "Meridian" },
  { name: "Orbit" },
];
const trustedCells = [3, 0, 4, 1, 2, 2, 4, 0, 3, 1].map((i) => baseLogos[i]);
---

<Layout title="Cortexa — AI Agency for Systems That Actually Ship">
  <!-- ============ NAV ============ -->
  <header class="nav-wrap">
    <nav class="nav container">
      <a href="#" class="wordmark" aria-label="Cortexa home">
        <span class="wordmark__mark" aria-hidden="true"></span>
        Cortexa
      </a>
      <ul class="nav-links">
        <li><a href="/product">Services</a></li>
        <li><a href="/solutions">Industries</a></li>
      </ul>
      <div class="nav-actions">
        <a href="#" class="nav-login">Client Login</a>
        <a href="#" class="nav-demo">Book a Consultation</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="hero-bg__blob hero-bg__blob--1"></span>
        <span class="hero-bg__blob hero-bg__blob--2"></span>
        <span class="hero-bg__blob hero-bg__blob--3"></span>
        <span class="hero-bg__blob hero-bg__blob--4"></span>
        <img class="hero-bg__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" />
      </div>
      <div class="container hero-inner reveal-stagger">
        <span class="hero-badge">
          <span class="hero-badge__shine" aria-hidden="true"></span>
          <span class="hero-badge__text">New — Cortexa Agent Studio</span>
        </span>

        <h1 class="hero-title text-left">
          Stop experimenting with AI.<br />
          Start shipping outcomes.
        </h1>

        <div class="hero-lower">
          <p class="hero-desc">
            Cortexa designs, builds, and deploys custom AI agents and
            automation for ambitious teams—so you move from pilot to
            production and see real ROI in weeks, not quarters.
          </p>
          <div class="hero-cta">
            <PrimaryButton
              label="Book a Consultation"
              bg="#0c0e1c"
              color="#ffffff"
              glow="rgba(206, 226, 242, 0.5)"
            />
            <PrimaryButton label="See our work" />
          </div>
        </div>

        <div class="hero-visual">
          <ProductPanel bg="#cee2f2" blob="#659cff" patternOpacity={0.5} />
        </div>

        <!-- Trusted by -->
        <div class="trusted">
          <p class="trusted__label">Trusted by teams at:</p>
          <div class="trusted__grid">
            {trustedCells.map((l) => (
              <div class="trusted__cell glow-follow" data-glow-rest="center">
                <span class="glow-follow__blob" aria-hidden="true"></span>
                <span class="trusted__logo trusted__wordmark">{l.name}</span>
                <a href="#" class="trusted__reveal" aria-label={`${l.name} — view case study`}>
                  View case study <span class="trusted__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PLATFORM / FEATURES ============ -->
    <section class="platform">
      <div class="container">
        <h2 class="platform__title reveal">
          The AI delivery system your whole company runs on
        </h2>

        <div class="feature-rows reveal-stagger">
          <FeatureRow
            eyebrow="AUDIT"
            title="Every workflow, mapped and scored"
            subtitle="We map your operations end-to-end and score each one for AI automation potential."
            description="Cortexa runs a structured audit across your tools, teams, and data—surfacing the highest-leverage places to deploy AI, ranked by effort and impact, so you know exactly where to start."
            statValue="2 weeks"
            statLabel="from kickoff to a scored roadmap"
            logo="Halcyon"
            panelBg="#eddfff"
            panelBlob="#659cff"
            btnGlow="#eddfff"
            statBlob="#eee4fb"
          />
          <FeatureRow
            eyebrow="BUILD"
            title="Ship agents that work in production"
            subtitle="Custom-built AI agents engineered for your stack, not a generic template."
            description="Our engineers embed with your team to design, build, and harden agents against your real data and edge cases—so what ships to production actually holds up under load."
            statValue="3x faster"
            statLabel="time-to-production vs. in-house builds"
            logo="Vertex"
            panelBg="#cee2f2"
            panelBlob="#659cff"
            reverse={true}
          />
          <FeatureRow
            eyebrow="SCALE"
            title="Scale without breaking a single workflow"
            subtitle="We monitor, retrain, and extend every agent we ship."
            description="Cortexa stays on as your AI systems team—watching performance, catching drift, and extending each agent to new workflows as your business grows."
            panelBg="#c5eeef"
            panelBlob="#c8d5bb"
          />
        </div>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="story">
      <div class="story-inner">
        <span class="eyebrow story__eyebrow reveal">
          <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
          why we started cortexa
        </span>
        <h2 class="story__title reveal">Most AI pilots die before they reach production.</h2>
        <p class="story__lead">
          Companies have never had more AI tools—and never shipped less real
          automation. Proofs of concept pile up in decks. Pilots stall in
          Slack threads. The one agent that could save a team ten hours a
          week sits in a sandbox nobody ever promoted to production.
        </p>
        <div class="story-reveal">
          <p>
            The problem was never the technology. It's the distance between a
            demo that works once and a system that works every time—the gap
            that never quite closes.
          </p>
          <p>
            Every workflow carries the shape of an agent inside it. Left
            alone it's just manual work. Engineered properly, it becomes
            leverage your team keeps for good.
          </p>
          <p>
            The teams pulling ahead treat AI as infrastructure, not a side
            project. They scope narrow, ship fast, and measure what changed—
            not what's theoretically possible.
          </p>
          <p>
            That's the shift Cortexa is built for—from AI experiments to AI
            systems, from slide decks to shipped software.
          </p>
          <p>
            When an agent quietly saves a team real hours every week, nobody
            has to be convinced AI was worth it. They already feel it.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ FEATURE COMPARISON (sticky nav + stacked cards) ============ -->
    <section class="features2">
      <div class="container features2__inner">
        <aside class="features2__nav reveal">
          <p class="features2__lead">
            Most AI vendors sell you a demo. Cortexa ships you a system.
          </p>
          <ul class="feat-nav">
            {["Audit", "Build", "Deploy", "Scale"].map((f, i) => (
              <li class={`feat-nav__item ${i === 0 ? "is-active" : ""}`}>
                <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </aside>

        <div class="features2__cards reveal-stagger">
          <ComparisonCard
            eyebrow="AUDIT"
            title="Find the AI, not just the buzzwords"
            subtitle="Most AI vendors sell you a demo. Cortexa ships you a system."
            button={true}
            traditional="Generic AI recommendations from a slide deck"
            intelligence="A scored roadmap built from your actual workflows and data"
            panelBlob="#c8d5bb"
            btnGlow="#c8d5bb"
          />
          <ComparisonCard
            eyebrow="BUILD"
            title="Engineering that understands your stack"
            subtitle="Most AI vendors sell you a demo. Cortexa ships you a system."
            button={true}
            traditional="Off-the-shelf tools bolted onto your existing process"
            intelligence="Custom agents built against your APIs, data, and edge cases"
            panelBlob="#cee2f2"
            btnGlow="#cee2f2"
          />
          <ComparisonCard
            title="From proof-of-concept to production system"
            traditional="Pilots that impress in a demo, then quietly stall"
            intelligence="Agents hardened, monitored, and owned all the way to launch"
            panelBlob="#eddfff"
          />
          <ComparisonCard
            eyebrow="SCALE"
            title="Support that doesn't disappear after launch"
            subtitle="Most AI vendors sell you a demo. Cortexa ships you a system."
            button={true}
            traditional="A handoff document and a wave goodbye"
            intelligence="An embedded team that monitors, retrains, and extends every agent"
            panelBlob="#c5eeef"
            btnGlow="#c5eeef"
          />
        </div>
      </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->
    <section class="stories">
      <div class="stories__bg" aria-hidden="true">
        <span class="stories__blob stories__blob--beige"></span>
        <span class="stories__blob stories__blob--teal"></span>
        <span class="stories__blob stories__blob--blue"></span>
        <img class="stories__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
      </div>

      <div class="container stories__inner">
        <div class="stories__head reveal">
          <h2 class="stories__title">How teams ship real AI with Cortexa</h2>
          <p class="stories__sub">
            Operations, engineering, and leadership teams at fast-growing
            companies build their AI systems on Cortexa.
          </p>
          <PrimaryButton label="Explore case studies" bg="#ffffff" glow="rgba(206, 226, 242, 0.9)" />
        </div>

        <div class="carousel reveal" data-carousel>
          {testimonials.map((t, i) => (
            <button class={`ctab ${i === 0 ? "is-open" : ""}`} type="button" data-i={i} aria-expanded={i === 0 ? "true" : "false"}>
              <span class="ctab__bg" aria-hidden="true">
                <img class="ctab__noise" src="/assets/cymatic-pattern-1757560466832-1920x1438.png" alt="" />
              </span>
              <span class="ctab__collapsed">
                <svg class="ctab__icon" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
                  <path d="M0 24V13.5C0 6 4.5 1 12 0L13 4C8 5.5 6 8 6 12H12V24H0ZM18 24V13.5C18 6 22.5 1 30 0L31 4C26 5.5 24 8 24 12H30V24H18Z"/>
                </svg>
                <span class="ctab__brand">{t.company}</span>
              </span>
              <div class="ctab__body">
                <div class="ctab__top">
                  <svg class="ctab__qi" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
                    <path d="M0 24V13.5C0 6 4.5 1 12 0L13 4C8 5.5 6 8 6 12H12V24H0ZM18 24V13.5C18 6 22.5 1 30 0L31 4C26 5.5 24 8 24 12H30V24H18Z"/>
                  </svg>
                  <blockquote class="ctab__quote">“{t.quote}”</blockquote>
                </div>
                <div class="ctab__foot">
                  <span class="ctab__company">{t.company}</span>
                  <div class="ctab__author">
                    <div class="ctab__meta">
                      <span class="ctab__name">{t.name}</span>
                      <span class="ctab__role">{t.role}</span>
                    </div>
                    {t.avatar ? (
                      <img class="ctab__avatar" src={t.avatar} alt={t.name} />
                    ) : (
                      <span class="ctab__avatar ctab__avatar--ph">{t.name.split(" ").map((n) => n[0]).join("")}</span>
                    )}
                  </div>
                </div>
              </div>
            </button>
          ))}
        </div>

        <div class="stories__dots" data-dots>
          {testimonials.map((t, i) => (
            <button
              type="button"
              class={`stories__dot ${i === 0 ? "is-active" : ""}`}
              data-i={i}
              aria-label={`Show ${t.company} testimonial`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ TEAMS (Supercharge) ============ -->
    <section class="teams">
      <div class="container">
        <div class="teams__head reveal">
          <h2 class="teams__title">
            Give every team its own AI leverage
          </h2>
          <p class="teams__sub">
            From operations to engineering to leadership, everyone gets
            agents built for how they actually work.
          </p>
          <PrimaryButton label="See our work" bg="#efeff1" />
        </div>

        <div class="teams__grid reveal-stagger">
          <TeamCard
            label="Operations"
            body="Cut manual busywork and catch process breakdowns before they cost you a customer."
            bg="#cfe1c1"
            blob="#c8d5bb"
          />
          <TeamCard
            label="Engineering"
            body="Ship agents that plug into your stack—not another dashboard nobody opens."
            bg="#cbd8f5"
            blob="#7392ff"
          />
          <TeamCard
            label="Leadership"
            body="Watch cost-per-workflow drop and throughput climb as every automation goes live."
            bg="#c3d3f2"
            blob="#4f74e6"
          />
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Ship your first agent this month.</h2>
        <p class="cta__sub">
          Teams at fast-growing companies build production AI with Cortexa.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a Consultation" /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container footer__inner reveal">
      <a href="#" class="wordmark footer__brand">
        <span class="wordmark__mark" aria-hidden="true"></span>
        Cortexa
      </a>
      <div class="footer__cols">
        {footerCols.map((col) => (
          <div class="footer__col">
            {col.title && <p class="footer__col-title eyebrow">{col.title}</p>}
            <ul>
              {col.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Scroll-spy: highlight the FEATURE #N nav item for the card crossing viewport center.
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".features2__cards .cmp-card")
  );
  const navItems = Array.from(
    document.querySelectorAll<HTMLElement>(".feat-nav__item")
  );
  if (cards.length && navItems.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            navItems.forEach((n, i) => n.classList.toggle("is-active", i === idx));
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    cards.forEach((c) => spy.observe(c));
  }

  // Story: scroll-linked word reveal — faded words brighten to full as they scroll up.
  const revealWrap = document.querySelector<HTMLElement>(".story-reveal");
  if (revealWrap && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    revealWrap.querySelectorAll("p").forEach((p) => {
      const words = (p.textContent ?? "").trim().split(/\s+/);
      p.innerHTML = words.map((w) => `<span class="rw">${w}</span>`).join(" ");
    });
    const rw = Array.from(revealWrap.querySelectorAll<HTMLElement>(".rw"));
    let ticking = false;
    const paint = () => {
      ticking = false;
      const vh = window.innerHeight;
      const startY = vh * 0.88; // words below this line are faded
      const endY = vh * 0.42; // words above this line are full
      for (const w of rw) {
        const r = w.getBoundingClientRect();
        const y = r.top + r.height / 2;
        let p = (startY - y) / (startY - endY);
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        w.style.opacity = (0.12 + 0.88 * p).toFixed(3);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    paint();
  }

  // Testimonials accordion: expand a tab (or its dot) and close the others; sync both.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const tabs = Array.from(carousel.querySelectorAll<HTMLElement>(".ctab"));
    const dots = Array.from(
      carousel.parentElement?.querySelectorAll<HTMLElement>(".stories__dot") ?? []
    );
    const open = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle("is-open", j === i);
        t.setAttribute("aria-expanded", String(j === i));
      });
      dots.forEach((d, j) => d.classList.toggle("is-active", j === i));
    };
    tabs.forEach((tab, i) => tab.addEventListener("click", () => open(i)));
    dots.forEach((dot, i) => dot.addEventListener("click", () => open(i)));
  });
</script>

<style>
  /* ---------- NAV ---------- */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .wordmark__mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--color-ink);
    display: inline-block;
  }
  .nav-links {
    display: flex;
    gap: 22px;
    list-style: none;
  }
  .nav-links a {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--color-ink); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-login {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
  }
  .nav-login:hover { background: var(--color-panel); }
  .nav-demo {
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
    background: var(--color-panel);
    border: 1px solid #fff;
  }
  .nav-demo:hover { background: #e6e6ea; }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding: 72px 0 64px;
    background: var(--color-panel);
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero-bg__blob {
    position: absolute;
    border-radius: 50%;
    background: var(--color-blue);
    filter: blur(150px);
    opacity: 0.9;
  }
  .hero-bg__blob--1 { width: 640px; height: 560px; top: 4%; right: 30%; }
  .hero-bg__blob--2 { width: 1000px; height: 420px; top: -12%; left: -18%; opacity: 0.7; }
  .hero-bg__blob--3 { width: 380px; height: 340px; top: -10%; right: -6%; }
  .hero-bg__blob--4 { width: 420px; height: 360px; bottom: 8%; left: -14%; opacity: 0.7; }
  .hero-bg__noise {
    position: absolute;
    top: 22%; right: -14%;
    width: 820px;
    max-width: 62%;
    mix-blend-mode: screen;
    opacity: 0.9;
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; }
  .hero-badge {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #e9f1fa 0%, #dde9f6 100%);
    border: 1px solid #fff;
    box-shadow: 0 2px 8px rgba(12, 14, 28, 0.06);
    border-radius: 4px;
    padding: 8px 12px;
    overflow: hidden;
  }
  .hero-badge__text {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  /* thin white highlight that sweeps left <-> right */
  .hero-badge__shine {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 160%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    filter: blur(7px);
    animation: badge-shine 7s ease-in-out infinite alternate;
  }
  @keyframes badge-shine {
    0%   { transform: translate(-50%, -50%) translateX(-62px); }
    100% { transform: translate(-50%, -50%) translateX(62px); }
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 30px 0;
    max-width: 1000px;
  }
  .hero-lower {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 360px;
  }
  .hero-desc {
