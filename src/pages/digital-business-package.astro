  </main>

  <SiteFooter />
</Layout>

<script>
  // Handle Hero WhatsApp Lead Form Submission
  const form = document.getElementById('heroLeadForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('leadFullName') as HTMLInputElement;
      const phoneInput = document.getElementById('leadPhoneNumber') as HTMLInputElement;
      const businessInput = document.getElementById('leadBusinessName') as HTMLInputElement;

      const name = nameInput ? nameInput.value : '';
      const phone = phoneInput ? phoneInput.value : '';
      const business = businessInput ? businessInput.value : '';

      const targetWhatsAppNumber = "917827408866";
      const message = `*🔥 New Offer Booking Request 🔥*\n\n` +
                      `*Name:* ${encodeURIComponent(name)}\n` +
                      `*Phone:* ${encodeURIComponent(phone)}\n` +
                      `*Business:* ${encodeURIComponent(business)}\n\n` +
                      `*Package:* Digital Setup Package @ ₹5,999`;

      const waUrl = `https://wa.me/${targetWhatsAppNumber}?text=${message}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
