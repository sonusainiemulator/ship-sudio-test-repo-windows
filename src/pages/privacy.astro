---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import { SITE_NAME, SITE_URL, SUPPORT_EMAIL, SUPPORT_PHONE, TECH_SUPPORT_PHONE, BOOK_CONSULTATION_URL } from "../consts";

const lastUpdated = "March 21, 2026";
const effectiveDate = "January 1, 2026";

const pageTitle = `Privacy Policy | ${SITE_NAME}`;
const pageDescription =
  "Privacy Policy of Rakebig Services — detailing how we collect, safeguard, and process personal information, including Razorpay payment data protection and DPDP compliance.";

const sections = [
  { id: "overview", title: "1. Overview & Data Controller" },
  { id: "information-collected", title: "2. Information We Collect" },
  { id: "payment-security", title: "3. Razorpay Payment Gateway & Security" },
  { id: "how-we-use", title: "4. How We Use Collected Data" },
  { id: "data-sharing", title: "5. Third-Party Disclosures & Sub-Processors" },
  { id: "cookies", title: "6. Cookies & Tracking Technologies" },
  { id: "data-retention", title: "7. Data Retention & Safeguards" },
  { id: "your-rights", title: "8. User Rights (DPDP Act Compliance)" },
  { id: "international-transfers", title: "9. Cross-Border Data Transfers" },
  { id: "children", title: "10. Children's Privacy" },
  { id: "grievance-officer", title: "11. Grievance Redressal & Officer Details" },
  { id: "policy-updates", title: "12. Policy Updates & Contact" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/privacy"
>
  <SiteHeader />

  <main class="legal-page">
    <!-- ============ HERO ============ -->
    <header class="legal-hero">
      <div class="container legal-hero__inner">
        <nav class="legal-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Privacy Policy</li>
          </ol>
        </nav>

        <div class="legal-hero__badge">
          <span class="legal-chip">Data Protection</span>
          <span class="legal-badge-dot" aria-hidden="true"></span>
          <span class="legal-meta-text">DPDP Act & Razorpay PCI-DSS Compliant</span>
        </div>

        <h1 class="legal-hero__title">Privacy Policy</h1>
        <p class="legal-hero__lead">
          At <strong>{SITE_NAME}</strong>, we are committed to safeguarding your privacy and ensuring the utmost
          confidentiality of your commercial data and financial transactions.
        </p>

        <div class="legal-meta-bar">
          <div class="legal-meta-item">
            <span class="legal-meta-label">Effective Date</span>
            <span class="legal-meta-value">{effectiveDate}</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Last Updated</span>
            <span class="legal-meta-value">{lastUpdated}</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Data Controller</span>
            <span class="legal-meta-value">{SITE_NAME}</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Payment Security</span>
            <span class="legal-meta-value">Razorpay (Zero Card Storage)</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ============ BODY / CONTENT ============ -->
    <section class="legal-content">
      <div class="container legal-layout">
        <!-- Sticky Table of Contents -->
        <aside class="legal-sidebar">
          <div class="legal-toc-card">
            <h2 class="legal-toc-title">Privacy Sections</h2>
            <ul class="legal-toc-list">
              {sections.map((sec) => (
                <li>
                  <a href={`#${sec.id}`} class="legal-toc-link">
                    {sec.title}
                  </a>
                </li>
              ))}
            </ul>

            <div class="legal-toc-cta">
              <p>Concerned about your project's data privacy or need a customized enterprise NDA?</p>
              <a href={`mailto:${SUPPORT_EMAIL}`} class="legal-toc-btn">
                Contact Privacy Desk
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Prose -->
        <article class="legal-prose">
          <!-- 1. OVERVIEW -->
          <section id="overview" class="legal-section">
            <h2>1. Overview & Data Controller</h2>
            <p>
              This Privacy Policy explains how <strong>{SITE_NAME}</strong> ("we," "us," or "our"), operating the website
              <strong>{SITE_URL}</strong>, collects, processes, protects, and stores information when you browse our site, engage us
              for custom Perfex CRM development, commission SaaS platforms, implement AI automation workflows, or make electronic payments
              via our payment gateway partner, <strong>Razorpay</strong>.
            </p>
            <p>
              We adhere to the provisions of the <strong>Information Technology Act, 2000</strong>, the Information Technology (Reasonable
              Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011, and the <strong>Digital Personal
              Data Protection (DPDP) Act, 2023</strong> of India.
            </p>
          </section>

          <!-- 2. INFORMATION WE COLLECT -->
          <section id="information-collected" class="legal-section">
            <h2>2. Information We Collect</h2>
            <p>
              We collect only the minimum necessary personal and technical data required to evaluate your requirements, deliver software
              services, execute milestone contracts, and fulfill statutory tax invoicing obligations:
            </p>

            <h3>2.1 Personal & Business Contact Information</h3>
            <ul>
              <li><strong>Contact Particulars:</strong> First and last name, business email address, direct phone number, and WhatsApp contact details.</li>
              <li><strong>Company Details:</strong> Business name, industry domain, company website URL, and registered physical billing address.</li>
              <li><strong>Commercial Identification:</strong> GSTIN (Goods and Services Tax Identification Number), PAN, or national corporate identification numbers for issuing compliant tax invoices in India.</li>
            </ul>

            <h3>2.2 Project Specifications & Technical Access Credentials</h3>
            <ul>
              <li>Technical specifications, database schemas, feature roadmaps, and workflow documentation submitted during project consultations.</li>
              <li>Server SSH keys, staging credentials, Git repository invitations, or third-party API tokens (e.g., WhatsApp Business API, OpenAI keys) provided exclusively under non-disclosure agreements to enable software deployment.</li>
            </ul>

            <h3>2.3 Automatically Collected Device & Diagnostic Data</h3>
            <ul>
              <li>Internet Protocol (IP) address, approximate geographic location (city/country level), operating system, browser type, device identifiers, and timestamped server access logs.</li>
            </ul>
          </section>

          <!-- 3. RAZORPAY PAYMENT GATEWAY & SECURITY -->
          <section id="payment-security" class="legal-section">
            <h2>3. Razorpay Payment Gateway & Payment Security</h2>
            <p>
              We maintain the highest security standards for all electronic financial transactions conducted on our site.
            </p>

            <div class="legal-callout legal-callout--blue">
              <div class="legal-callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="legal-callout__body">
                <strong>Razorpay Payment Security Disclosures (PCI-DSS Level 1)</strong>
                <p>
                  All online payments for software services, CRM modules, retainers, and consultations are processed securely through
                  <strong>Razorpay Software Private Limited ("Razorpay")</strong>.
                </p>
                <p>
                  <strong>{SITE_NAME} does NOT collect, store, or process sensitive payment credentials</strong>—such as full 16-digit credit
                  or debit card numbers, Card Verification Values (CVV/CVC), net banking passwords, or UPI PINs—on our servers or databases.
                </p>
              </div>
            </div>

            <h3>3.1 How Razorpay Safeguards Your Financial Data</h3>
            <ul>
              <li><strong>Tokenization & Encryption:</strong> When you execute a transaction via Razorpay, your payment details are transmitted directly through bank-grade 256-bit SSL/TLS encryption to Razorpay's PCI-DSS Level 1 certified vault.</li>
              <li><strong>Accepted Modes:</strong> Razorpay supports Unified Payments Interface (UPI via Google Pay, PhonePe, Paytm, BHIM), major Credit and Debit Cards (Visa, Mastercard, RuPay, American Express), Net Banking across 50+ major banks, and verified digital wallets.</li>
              <li><strong>Transaction Confirmation:</strong> Upon successful transaction clearance, Razorpay transmits only an encrypted transaction token, transaction ID, payment method descriptor (e.g., "UPI" or "Visa ending in 1234"), and authorization status to our system to generate your formal receipt.</li>
              <li><strong>Regulatory Compliance:</strong> Razorpay operates in full compliance with Reserve Bank of India (RBI) payment aggregator regulations, including card-on-file tokenization rules.</li>
            </ul>
          </section>

          <!-- 4. HOW WE USE COLLECTED DATA -->
          <section id="how-we-use" class="legal-section">
            <h2>4. How We Use Collected Data</h2>
            <p>
              We process personal information strictly on lawful grounds—specifically for the performance of our commercial contracts,
              compliance with legal obligations, and our legitimate business interests in delivering reliable software:
            </p>
            <ul>
              <li><strong>Service Delivery:</strong> To build, customize, and maintain your Perfex CRM, web applications, Flutter mobile apps, SaaS platforms, and AI automations.</li>
              <li><strong>Commercial Invoicing:</strong> To issue official Statements of Work, calculate milestone charges, generate GST-compliant invoices, and track payment status via Razorpay.</li>
              <li><strong>Client Communication:</strong> To schedule kickoff calls, provide development sprint updates, deliver technical documentation, and respond to support enquiries.</li>
              <li><strong>Security & Operational Integrity:</strong> To prevent fraudulent orders, detect unauthorized API usage, debug system crashes, and ensure system uptime.</li>
              <li><strong>Statutory Compliance:</strong> To maintain mandatory accounting ledgers, tax filings, and legal records as required by Indian law.</li>
            </ul>
          </section>

          <!-- 5. THIRD-PARTY DISCLOSURES & SUB-PROCESSORS -->
          <section id="data-sharing" class="legal-section">
            <h2>5. Third-Party Disclosures & Sub-Processors</h2>
            <p>
              <strong>We do not sell, rent, lease, or trade your personal information to third parties, advertisers, or data brokers.</strong>
            </p>
            <p>
              We share data exclusively with trusted third-party service providers who assist us in operating our business under strict
              confidentiality agreements:
            </p>

            <div class="legal-table-wrap">
              <table class="legal-table">
                <thead>
                  <tr>
                    <th>Service Provider</th>
                    <th>Category</th>
                    <th>Purpose & Protection Standard</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Razorpay</strong></td>
                    <td>Payment Gateway</td>
                    <td>Processes card, UPI, and net banking payments securely (PCI-DSS Level 1 certified).</td>
                  </tr>
                  <tr>
                    <td><strong>Cloudflare / Hetzner / AWS</strong></td>
                    <td>Hosting & Infrastructure</td>
                    <td>Encrypted server hosting, DDoS protection, and SSL/TLS certificate delivery.</td>
                  </tr>
                  <tr>
                    <td><strong>WhatsApp / Meta API</strong></td>
                    <td>Messaging Infrastructure</td>
                    <td>Facilitates two-way automated client updates and CRM notifications upon customer request.</td>
                  </tr>
                  <tr>
                    <td><strong>OpenAI / Anthropic</strong></td>
                    <td>AI Model Providers</td>
                    <td>Powers specialized AI agent parsing and data extraction under non-training enterprise API terms.</td>
                  </tr>
                  <tr>
                    <td><strong>Cal.com</strong></td>
                    <td>Consultation Scheduling</td>
                    <td>Allows prospective clients to schedule technical scoping sessions.</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p>
              We may also disclose information if required to do so by applicable law, court summons, or regulatory authorities in India,
              or to protect the legal rights, safety, or property of {SITE_NAME} and our users.
            </p>
          </section>

          <!-- 6. COOKIES -->
          <section id="cookies" class="legal-section">
            <h2>6. Cookies & Tracking Technologies</h2>
            <p>
              Cookies are small text files placed on your device to enhance site navigation and remember user preferences.
            </p>
            <ul>
              <li><strong>Strictly Necessary Cookies:</strong> Essential for core website navigation, load balancing, security verification, and rendering responsive layouts.</li>
              <li><strong>Functional & Preference Cookies:</strong> Remember your navigation choices, theme preferences, and interface interactions.</li>
              <li><strong>Analytical Cookies:</strong> Help us anonymously evaluate aggregate traffic patterns and identify broken links to optimize user experience.</li>
            </ul>
            <p>
              You can instruct your web browser to refuse all cookies or notify you when a cookie is being sent. However, certain dynamic
              features of our marketing site or customer portals may function with reduced performance if cookies are disabled.
            </p>
          </section>

          <!-- 7. DATA RETENTION -->
          <section id="data-retention" class="legal-section">
            <h2>7. Data Retention & Safeguards</h2>
            <h3>7.1 Retention Duration</h3>
            <p>
              We retain personal information only for as long as necessary to fulfill the purposes for which it was collected, including:
            </p>
            <ul>
              <li><strong>Active Projects:</strong> For the complete duration of the custom development agreement plus the 30-day warranty window.</li>
              <li><strong>Financial & Tax Records:</strong> Invoices, transaction logs, and Razorpay payment confirmation IDs are retained for at least seven (7) years in compliance with statutory Indian Income Tax and GST regulations.</li>
              <li><strong>Staging & API Credentials:</strong> Staging passwords, SSH keys, or test tokens provided by the Client are securely deleted or rotated within thirty (30) days following final deployment sign-off.</li>
            </ul>

            <h3>7.2 Security Safeguards</h3>
            <p>
              We implement comprehensive technical and organizational safeguards:
            </p>
            <ul>
              <li>End-to-end TLS 1.3 / SSL encryption for all data in transit across our digital surfaces.</li>
              <li>Access controls governed by the principle of least privilege, requiring multi-factor authentication (2FA) for all engineer accounts.</li>
              <li>Encrypted off-site backups and routine vulnerability patches for cloud staging servers.</li>
            </ul>
          </section>

          <!-- 8. USER RIGHTS -->
          <section id="your-rights" class="legal-section">
            <h2>8. User Rights (DPDP Act Compliance)</h2>
            <p>
              In accordance with the <strong>Digital Personal Data Protection (DPDP) Act, 2023</strong> and applicable privacy frameworks,
              you possess the following rights regarding your personal data:
            </p>
            <ul>
              <li><strong>Right to Access:</strong> You may request a summary of the personal data we hold about you and details of how it is processed.</li>
              <li><strong>Right to Correction & Updating:</strong> You may request the rectification of any inaccurate or incomplete personal information.</li>
              <li><strong>Right to Erasure ("Right to be Forgotten"):</strong> You may request the deletion of your personal data, subject to legal or statutory record-keeping exemptions (e.g., GST tax invoices).</li>
              <li><strong>Right of Grievance Redressal:</strong> You have the right to register a grievance with our designated Grievance Officer regarding any aspect of data processing.</li>
              <li><strong>Right to Withdraw Consent:</strong> Where processing is based on consent, you may withdraw your consent at any time by contacting our privacy desk.</li>
            </ul>
            <p>
              To exercise any of these rights, submit a verified request to <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
              We will verify your identity and respond within thirty (30) calendar days.
            </p>
          </section>

          <!-- 9. CROSS-BORDER DATA TRANSFERS -->
          <section id="international-transfers" class="legal-section">
            <h2>9. Cross-Border Data Transfers</h2>
            <p>
              {SITE_NAME} operates primarily from India and serves international clients across over 25 countries. If you are accessing our
              services from outside India (such as the United States, United Kingdom, European Union, or UAE), please note that your information
              will be transferred to, processed, and stored on servers located in India and global cloud data centers (e.g., AWS / Cloudflare).
              We ensure adequate contractual safeguards are implemented to protect your data wherever it is processed.
            </p>
          </section>

          <!-- 10. CHILDREN'S PRIVACY -->
          <section id="children" class="legal-section">
            <h2>10. Children's Privacy</h2>
            <p>
              Our website and commercial engineering services are intended strictly for business enterprises, professionals, and individuals
              who are at least eighteen (18) years of age. We do not knowingly collect or solicit personal information from minors. If we discover
              that personal data from a child under 18 has been collected without parental consent, we will take immediate steps to delete such data.
            </p>
          </section>

          <!-- 11. GRIEVANCE OFFICER -->
          <section id="grievance-officer" class="legal-section">
            <h2>11. Grievance Redressal & Officer Details</h2>
            <p>
              In compliance with the <strong>Information Technology Act, 2000</strong> and the rules made thereunder, as well as the
              <strong>Digital Personal Data Protection Act, 2023</strong>, the name and contact details of the Grievance Officer for
              <strong>{SITE_NAME}</strong> are provided below:
            </p>

            <div class="legal-callout legal-callout--purple">
              <div class="legal-callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div class="legal-callout__body">
                <strong>Designated Grievance Redressal Officer</strong>
                <p>
                  <strong>Entity:</strong> {SITE_NAME} (rakebig.com)<br />
                  <strong>Attention:</strong> Grievance Redressal Desk<br />
                  <strong>Official Grievance Email:</strong> <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a><br />
                  <strong>Direct Telephone:</strong> <a href={`tel:${SUPPORT_PHONE.replace(/[^0-9+]/g, '')}`}>{SUPPORT_PHONE}</a><br />
                  <strong>Tech Support Helpline:</strong> <a href={`tel:${TECH_SUPPORT_PHONE.replace(/[^0-9+]/g, '')}`}>{TECH_SUPPORT_PHONE}</a> (Mon–Sat, 10–7 IST)<br />
                  <strong>Alternate Contact:</strong> <a href="mailto:contact@rakebig.in">contact@rakebig.in</a><br />
                  <strong>Response Timeline:</strong> Grievance acknowledgement within 48 hours; resolution within thirty (30) days from receipt.
                </p>
              </div>
            </div>
          </section>

          <!-- 12. POLICY UPDATES -->
          <section id="policy-updates" class="legal-section">
            <h2>12. Policy Updates & Contact</h2>
            <p>
              We may update this Privacy Policy periodically to reflect changes in our service offerings, regulatory guidelines, or payment
              processing updates with Razorpay. When changes are made, the "Last Updated" date at the top of this document will be revised.
              Your continued engagement with {SITE_NAME} following any modifications constitutes your acknowledgment and acceptance of the revised policy.
            </p>
            <p>
              If you have any questions regarding this Privacy Policy, please contact our support team at
              <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
            </p>
          </section>
        </article>
      </div>
    </section>

    <!-- ============ BOTTOM CTA ============ -->
    <section class="legal-bottom-cta">
      <div class="container legal-bottom-cta__inner reveal">
        <h2>Have questions about security or compliance?</h2>
        <p>Our team is available to review custom NDA requirements or provide architecture security reviews.</p>
        <div class="legal-bottom-cta__actions">
          <PrimaryButton label="Book a consultation" href={BOOK_CONSULTATION_URL} bg="#0c0e1c" color="#ffffff" />
          <a href="/terms" class="legal-ghost-link">View Terms & Conditions →</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Same visual design system as terms.astro */
  .legal-page { background: #ffffff; color: var(--color-ink); }

  .legal-hero {
    padding: 48px 0 64px;
    background: radial-gradient(85% 120% at 100% 0%, #def2f4 0%, transparent 60%),
                linear-gradient(180deg, #f0f7f8 0%, #ffffff 100%);
    border-bottom: 1px solid var(--color-line);
  }

  .legal-hero__inner { max-width: 920px; }

  .legal-crumbs ol {
    display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 20px; padding: 0; font-size: 13px; color: rgba(12, 14, 28, 0.55);
  }
  .legal-crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .legal-crumbs li + li::before { content: "/"; color: rgba(12, 14, 28, 0.3); }
  .legal-crumbs a { color: rgba(12, 14, 28, 0.65); text-decoration: none; transition: color 0.15s ease; }
  .legal-crumbs a:hover { color: var(--color-ink); }
  .legal-crumbs li[aria-current] { color: rgba(12, 14, 28, 0.9); font-weight: 500; }

  .legal-hero__badge { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 18px; }

  .legal-chip {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: #1e7070; background: rgba(49, 147, 147, 0.12); border: 1px solid rgba(49, 147, 147, 0.3); padding: 5px 10px; border-radius: 6px;
  }

  .legal-badge-dot { width: 4px; height: 4px; border-radius: 50%; background: #319393; }
  .legal-meta-text { font-size: 12.5px; font-weight: 500; color: #3b4256; }

  .legal-hero__title {
    font-family: var(--font-display); font-size: clamp(36px, 4.5vw, 54px); font-weight: 400; line-height: 1.1; letter-spacing: -0.025em; color: var(--color-ink); margin: 0 0 18px;
  }

  .legal-hero__lead {
    font-size: clamp(16px, 1.8vw, 18.5px); line-height: 1.6; color: #4b5568; margin: 0 0 32px; max-width: 760px;
  }
  .legal-hero__lead strong { color: var(--color-ink); }

  .legal-meta-bar {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; padding: 18px 24px;
    background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(12, 14, 28, 0.08); border-radius: 12px; box-shadow: 0 4px 20px -8px rgba(12, 14, 28, 0.05);
  }

  .legal-meta-item { display: flex; flex-direction: column; gap: 4px; }
  .legal-meta-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #718096; }
  .legal-meta-value { font-size: 13.5px; font-weight: 600; color: var(--color-ink); }

  /* Content Layout */
  .legal-content { padding: 72px 0 96px; }
  .legal-layout { display: grid; grid-template-columns: 280px 1fr; gap: 56px; align-items: flex-start; }

  .legal-sidebar { position: sticky; top: 96px; }
  .legal-toc-card { background: #fafafc; border: 1px solid var(--color-line); border-radius: 16px; padding: 24px; }
  .legal-toc-title { font-family: var(--font-body); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin: 0 0 16px; }
  .legal-toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .legal-toc-link { font-size: 13.5px; color: #4a5568; text-decoration: none; display: block; padding: 4px 0; line-height: 1.4; transition: color 0.15s ease, transform 0.15s ease; }
  .legal-toc-link:hover { color: #2f6bff; transform: translateX(3px); }
  .legal-toc-cta { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--color-line); }
  .legal-toc-cta p { font-size: 12.5px; color: #64748b; line-height: 1.5; margin: 0 0 12px; }
  .legal-toc-btn { display: inline-block; width: 100%; text-align: center; font-size: 12.5px; font-weight: 600; color: #2f6bff; background: #eef3ff; border: 1px solid rgba(47, 107, 255, 0.25); padding: 8px 12px; border-radius: 8px; text-decoration: none; transition: background 0.15s ease, color 0.15s ease; }
  .legal-toc-btn:hover { background: #2f6bff; color: #ffffff; }

  .legal-prose { max-width: 820px; }
  .legal-section { padding-bottom: 48px; margin-bottom: 48px; border-bottom: 1px solid var(--color-line); scroll-margin-top: 110px; }
  .legal-section:last-of-type { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .legal-section h2 { font-family: var(--font-display); font-size: clamp(24px, 2.6vw, 30px); font-weight: 400; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 18px; }
  .legal-section h3 { font-family: var(--font-body); font-size: 17px; font-weight: 700; color: var(--color-ink); margin: 24px 0 12px; }
  .legal-prose p { font-size: 15.5px; line-height: 1.7; color: #3f4756; margin: 0 0 18px; }
  .legal-prose a { color: #2f6bff; text-decoration: underline; text-underline-offset: 3px; transition: color 0.15s ease; }
  .legal-prose a:hover { color: #1948b8; }
  .legal-prose ul { margin: 0 0 20px; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; }
  .legal-prose li { font-size: 15px; line-height: 1.65; color: #3f4756; }
  .legal-prose li strong { color: var(--color-ink); }

  /* Table styling */
