---
import Layout from "../layouts/Layout.astro";
import ProductPanel from "../components/ProductPanel.astro";
import PanelSplit from "../components/PanelSplit.astro";
import UseCaseCard from "../components/UseCaseCard.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";
import AiCard from "../components/AiCard.astro";

const heroLogos = [
  { src: "/assets/webflowlogosvg.svg", alt: "Webflow", h: 21 },
  { src: "/assets/hingeidj958bdhp2.svg", alt: "Hinge", h: 22 },
  { src: "/assets/linearlogo0-1.svg", alt: "Linear", h: 26 },
  { src: "/assets/frame-2018778295.svg", alt: "Perplexity", h: 26 },
  { src: "/assets/hingeidj958bdhp2.svg", alt: "Hinge", h: 22 },
];

// "Save time" grid — first row (4 up), second row (3 up)
const useCasesTop = [
  { label: "Product", body: "Build from what customers actually ask for, ranked by reach and revenue.", bg: "#cdbef5", blob: "#7f52bf" },
  { label: "Customer experience", body: "Spot friction early and fix root causes—not the same complaint on repeat.", bg: "#d7f0ec", blob: "#319393" },
  { label: "Support", body: "Stop re-answering the same ticket. Route systemic issues to the team that owns them.", bg: "#dcefe9", blob: "#c8d5bb" },
  { label: "Voice of customer", body: "Be the reason your company consistently beats retention and NPS goals.", bg: "#cbd8f5", blob: "#659cff" },
];
const useCasesBottom = [
  { label: "Sales", body: "Walk into every renewal knowing what the account asked for—and what shipped.", bg: "#cdbef5", blob: "#7f52bf" },
  { label: "Marketing", body: "Turn closed loops into stories: launches, changelogs, and win-back campaigns.", bg: "#d7f0ec", blob: "#319393" },
  { label: "Leadership", body: "Watch retention and NPS climb as every loop closes a little faster.", bg: "#cbd8f5", blob: "#659cff" },
];

const benefits = [
  { label: "Rebuild trust at scale", body: "Customers see their voice directly shape product decisions—and stick around because of it." },
  { label: "Recover and retain revenue", body: "Re-engage at-risk accounts, convert detractors, and win back churned users the moment their issue ships." },
  { label: "Automate the follow-through", body: "Free your team from hours of manual follow-up without losing control of a single message." },
  { label: "Prove the value", body: "Measure sentiment lift, NPS movement, and revenue recovered from every loop closed." },
];

const loopSteps = [
  { title: "Detect resolutions automatically", body: "Track when linked Jira or Linear issues are marked complete." },
  { title: "Aggregate context instantly", body: "Pull every related ticket, conversation, and account signal into one unified view." },
  { title: "Review & approve with control", body: "Your team approves every outbound message before it reaches a customer." },
  { title: "Deliver at scale", body: "Send personalized close-the-loop updates across every channel at once." },
  { title: "Measure the impact", body: "Quantify sentiment lift, NPS movement, and revenue recovered from every loop closed." },
];

const footerCols = [
  {
    title: "",
    links: [
      "Product",
      "Pricing",
      "Customers",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];
---

<Layout title="Loopwise — See the customer behind every signal">
  <!-- ============ NAV ============ -->
  <header class="nav-wrap">
    <nav class="nav container">
      <a href="/" class="wordmark" aria-label="Loopwise home">
        <span class="wordmark__mark" aria-hidden="true"></span>
        Loopwise
      </a>
      <ul class="nav-links">
        <li><a href="/product" aria-current="page">Product</a></li>
        <li><a href="/solutions">Solutions</a></li>
      </ul>
      <div class="nav-actions">
        <a href="#" class="nav-login">Log in</a>
        <a href="#" class="nav-demo">Book a demo</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="phero">
      <div class="phero__panel">
        <div class="phero__panel-bg" aria-hidden="true">
          <span class="phero__blob phero__blob--1"></span>
          <span class="phero__blob phero__blob--2"></span>
          <span class="phero__blob phero__blob--3"></span>
          <img class="phero__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" />
        </div>
        <div class="phero__card reveal">
          <AiCard />
        </div>
      </div>
      <div class="container phero__inner">
        <div class="phero__text reveal-stagger">
          <span class="eyebrow eyebrow--mark">
            <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
            Signal Engine
          </span>
          <h1 class="phero__title">See the customer<br />behind every signal</h1>
          <p class="phero__desc">
            A ticket on its own is just noise. Loopwise ties every signal to
            the account behind it—who they are, what they pay, what they’ve
            asked for before—so each piece of feedback arrives ready to act on.
          </p>
          <div class="phero__cta">
            <MagneticArrowCta label="Book a demo" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ LOGO STRIP ============ -->
    <section class="lstrip">
      <div class="lstrip__grid reveal-stagger">
        {heroLogos.map((l) => (
          <div class="lstrip__cell glow-follow" data-glow-rest="center">
            <span class="glow-follow__blob" aria-hidden="true"></span>
            <img class="lstrip__logo" src={l.src} alt={l.alt} style={`height:${l.h}px`} />
          </div>
        ))}
      </div>
    </section>

    <!-- ============ PANEL SPLITS ============ -->
    <section class="splits">
      <div class="container splits__inner reveal-stagger">
        <PanelSplit
          eyebrow="Connect"
          title="Connect every signal to business reality"
          body="Feedback never stands alone. Loopwise links each signal to the users, accounts, and revenue behind it—so a spike in complaints reads as three enterprise renewals at risk, not just a bigger number on a chart."
          panelBg="#cee2f2"
          panelBlob="#659cff"
        />
        <PanelSplit
          eyebrow="Model"
          title="A model that mirrors how your business works"
          body="Define the things that matter to you—agents, stores, personas, campaigns—and Loopwise organizes every signal around them, getting sharper with each piece of feedback it sees."
          reverse={true}
          panelBg="#eddfff"
          panelBlob="#7f52bf"
        />
      </div>
    </section>

    <!-- ============ USE CASES ============ -->
    <section class="usecases">
      <div class="container">
        <div class="usecases__head reveal">
          <span class="eyebrow eyebrow--mark">
            <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
              <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Use cases
          </span>
          <h2 class="usecases__title">Stop hand-sorting feedback.<br />Start acting on it.</h2>
          <p class="usecases__sub">
            Loopwise tags every signal against your own taxonomy and routes it
            to the team that owns it—so triage disappears and every team works
            from the customer's actual words.
          </p>
        </div>

        <div class="usecases__grid usecases__grid--4 reveal-stagger">
          {useCasesTop.map((c) => (
            <UseCaseCard label={c.label} body={c.body} bg={c.bg} blob={c.blob} />
          ))}
        </div>
        <div class="usecases__grid usecases__grid--3 reveal-stagger">
          {useCasesBottom.map((c) => (
            <UseCaseCard label={c.label} body={c.body} bg={c.bg} blob={c.blob} wide={true} />
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CUSTOMER STORY ============ -->
    <section class="cstory">
      <div class="cstory__bg" aria-hidden="true"></div>
      <div class="container cstory__inner reveal-stagger">
        <span class="eyebrow eyebrow--mark cstory__eyebrow">
          <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
            <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          Customer story
        </span>
        <blockquote class="cstory__quote">
          “Loopwise gives every team a live view of what customers are asking
          for and whose job it is to answer. Prioritization went from a monthly
          argument to a five-minute look at the board.”
        </blockquote>
        <div class="cstory__foot">
          <div class="cstory__author">
            <img class="cstory__avatar" src="/assets/rectangle-240664309.png" alt="Jesse Walker" />
            <div class="cstory__meta">
              <span class="cstory__name">Jesse Walker</span>
              <span class="cstory__role">Head of Insights &amp; User Advocacy,</span>
            </div>
          </div>
          <span class="cstory__company">Apollo.io</span>
        </div>
        <div class="cstory__cta">
          <PrimaryButton
            label="See how Apollo.io closes the loop with Loopwise"
            bg="#ffffff"
            glow="rgba(206, 226, 242, 0.9)"
          />
        </div>
      </div>
    </section>

    <!-- ============ KEY BENEFITS ============ -->
    <section class="benefits">
      <div class="container">
        <div class="benefits__head reveal">
          <span class="eyebrow eyebrow--mark">
            <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
              <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Why Loopwise
          </span>
          <h2 class="benefits__title">What a closed loop earns you</h2>
          <p class="benefits__sub">
            Every loop you close pays out twice—customers who feel heard, and
            a team that stops guessing what to build next.
          </p>
        </div>

        <div class="benefits__grid reveal-stagger">
          {benefits.map((b) => (
            <div class="benefit">
              <span class="benefit__label eyebrow">
                <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
                {b.label}
              </span>
              <p class="benefit__body">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ HOW CLOSE THE LOOP WORKS ============ -->
    <section class="loop">
      <div class="loop__bg" aria-hidden="true"></div>
      <div class="container">
        <div class="loop__head reveal">
          <h2 class="loop__title">How Loopwise closes the loop</h2>
          <p class="loop__sub">
            From detecting a fix to telling every customer who asked for it,
            Loopwise handles the follow-through—and your team stays in control
            of every message that goes out.
          </p>
        </div>

        <div class="loop__grid reveal-stagger">
          <div class="loop__visual">
            <ProductPanel bg="#c5eeef" blob="#c8d5bb" patternOpacity={0.5} />
          </div>
          <ul class="loop__list" data-loop>
            {loopSteps.map((s, i) => (
              <li class={`loop__item ${i === 0 ? "is-open" : ""}`}>
                <button class="loop__row" type="button" data-i={i} aria-expanded={i === 0 ? "true" : "false"}>
                  <span class="loop__num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="loop__label">{s.title}</span>
                </button>
                <div class="loop__panel">
                  <div class="loop__panel-inner">
                    <p>{s.body}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ PANEL SPLITS (repeat) ============ -->
    <section class="splits splits--tail">
      <div class="container splits__inner reveal-stagger">
        <PanelSplit
          eyebrow="Route"
          title="Every insight lands with its owner"
          body="Loopwise learns your team structure and sends each theme to the person who can act on it—no forwarded threads, no lost context, no wondering whose job it is."
          panelBg="#cee2f2"
          panelBlob="#659cff"
        />
        <PanelSplit
          eyebrow="Close"
          title="Tell customers the moment you ship"
          body="When a linked issue resolves, Loopwise drafts the follow-up, you approve it, and every customer who asked hears the news—at scale, in your voice."
          reverse={true}
          panelBg="#eddfff"
          panelBlob="#7f52bf"
        />
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Close your first loop this week.</h2>
        <p class="cta__sub">
          Teams at Perplexity, Notion, and Linear close the loop on customer
          feedback with Loopwise.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a demo" /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container footer__inner reveal">
      <a href="/" class="wordmark footer__brand">
        <span class="wordmark__mark" aria-hidden="true"></span>
        Loopwise
      </a>
      <div class="footer__cols">
        {footerCols.map((col) => (
          <div class="footer__col">
            {col.title && <p class="footer__col-title eyebrow">{col.title}</p>}
            <ul>
              {col.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Loop accordion: open one step at a time; first is open by default.
  document.querySelectorAll<HTMLElement>("[data-loop]").forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".loop__item"));
    const rows = Array.from(list.querySelectorAll<HTMLElement>(".loop__row"));
    const open = (i: number) => {
      items.forEach((it, j) => {
        const isOpen = j === i;
        it.classList.toggle("is-open", isOpen);
        it.querySelector(".loop__row")?.setAttribute("aria-expanded", String(isOpen));
      });
    };
    rows.forEach((row, i) => row.addEventListener("click", () => open(i)));
  });
</script>

<style>
  /* ---------- NAV (shared with home) ---------- */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .wordmark__mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--color-ink);
    display: inline-block;
  }
  .nav-links { display: flex; gap: 22px; list-style: none; }
  .nav-links a {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--color-ink); }
  .nav-links a[aria-current="page"] { color: var(--color-ink); font-weight: 500; }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-login {
    font-size: 14px;
    color: rgba(12, 14, 28, 0.6);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
  }
  .nav-login:hover { background: var(--color-panel); }
  .nav-demo {
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
    background: var(--color-panel);
    border: 1px solid #fff;
  }
  .nav-demo:hover { background: #e6e6ea; }

  /* ---------- shared eyebrow marker ---------- */
  .eyebrow--mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eyebrow--mark .tkt { width: 20px; height: 14px; color: rgba(12, 14, 28, 0.55); flex-shrink: 0; }

  /* ---------- HERO ---------- */
  .phero {
    position: relative;
    background: #efeef4;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    min-height: max(820px, 90vh);
  }
  /* Full-bleed gradient panel on the right — no white frame, bleeds to the
     right viewport edge. The static AI card floats centred inside it. */
  .phero__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50vw;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .phero__panel-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 30%, #e9defb 0%, transparent 70%),
      radial-gradient(70% 55% at 45% 105%, #d6c5f2 0%, transparent 70%),
      linear-gradient(160deg, #ddd0f6 0%, #d2c1ef 55%, #cbb9ec 100%);
  }
  .phero__blob { position: absolute; border-radius: 50%; filter: blur(120px); }
  .phero__blob--1 { width: 60%; height: 55%; top: 4%; left: 8%; background: #e7dcfa; opacity: 0.8; }
  .phero__blob--2 { width: 55%; height: 55%; bottom: -10%; right: -8%; background: #c7b4ee; opacity: 0.7; }
  .phero__blob--3 { width: 40%; height: 40%; top: 30%; right: 22%; background: #efe7fc; opacity: 0.55; }
  .phero__noise {
    position: absolute;
    top: 50%; left: 50%;
    width: 150%;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    opacity: 0.9;
    pointer-events: none;
  }
  .phero__card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 360px;
    padding: 0 20px;
  }
  .phero__card :global(.ai-card) { max-width: 360px; }
  .phero__inner { position: relative; width: 100%; }
  .phero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
    max-width: 440px;
    padding: 96px 0;
  }
  .phero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .phero__desc {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(12, 14, 28, 0.62);
    max-width: 400px;
  }
  .phero__cta { margin-top: 4px; }

  /* ---------- LOGO STRIP ---------- */
  .lstrip { border-bottom: 1px solid var(--color-line); }
  .lstrip__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .lstrip__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px;
    border-right: 1px solid var(--color-line);
    --glow-color: rgba(206, 226, 242, 0.9);
    --glow-size: 150px;
  }
  .lstrip__cell:last-child { border-right: none; }
  .lstrip__cell .glow-follow__blob { z-index: 0; opacity: 0; transition: transform 0.3s ease-out, opacity 0.25s ease; }
  .lstrip__cell:hover .glow-follow__blob { opacity: 1; }
  .lstrip__logo { position: relative; z-index: 1; opacity: 0.55; max-width: 100%; transition: opacity 0.2s ease; }
  .lstrip__cell:hover .lstrip__logo { opacity: 0.85; }

  /* ---------- PANEL SPLITS ---------- */
  .splits { padding: 112px 0; }
  .splits--tail { padding-top: 40px; }
  .splits__inner { display: flex; flex-direction: column; gap: 128px; }

  /* ---------- USE CASES ---------- */
  .usecases { padding: 40px 0 112px; }
  .usecases__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 560px;
    margin-bottom: 48px;
  }
  .usecases__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .usecases__sub { font-size: 14px; line-height: 1.5; color: rgba(12, 14, 28, 0.6); max-width: 440px; }
  .usecases__grid { display: grid; gap: 8px; }
  .usecases__grid--4 { grid-template-columns: repeat(4, 1fr); margin-bottom: 8px; }
  .usecases__grid--3 { grid-template-columns: repeat(3, 1fr); }

  /* ---------- CUSTOMER STORY ---------- */
  .cstory {
    position: relative;
    overflow: hidden;
    padding: 128px 0;
  }
  .cstory__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 12% 40%, rgba(206, 226, 242, 0.55), transparent 60%),
      radial-gradient(55% 90% at 92% 60%, rgba(206, 226, 242, 0.45), transparent 60%),
      linear-gradient(180deg, #fff 0%, #eef3fa 45%, #fff 100%);
    pointer-events: none;
  }
  .cstory__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    max-width: 900px;
  }
  .cstory__eyebrow { color: rgba(12, 14, 28, 0.55); }
  .cstory__quote {
    font-family: var(--font-body);
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: #2b2f42;
    max-width: 820px;
  }
  .cstory__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 820px;
  }
  .cstory__author { display: flex; align-items: center; gap: 14px; }
  .cstory__avatar { width: 44px; height: 44px; border-radius: 4px; object-fit: cover; }
  .cstory__meta { display: flex; flex-direction: column; gap: 2px; }
  .cstory__name { font-size: 16px; font-weight: 500; color: var(--color-ink); }
  .cstory__role { font-size: 14px; color: rgba(12, 14, 28, 0.55); }
  .cstory__company { font-size: 18px; color: var(--color-ink); letter-spacing: -0.01em; white-space: nowrap; }
  /* the CTA is a PrimaryButton; widen its gap so the arrow sits at the far right */
