---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProductPanel from "../components/ProductPanel.astro";
import PanelSplit from "../components/PanelSplit.astro";
import UseCaseCard from "../components/UseCaseCard.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import MagneticArrowCta from "../components/MagneticArrowCta.astro";
import AiCard from "../components/AiCard.astro";

const heroLogos = [
  { name: "Northbeam" },
  { name: "Vertex" },
  { name: "Halcyon" },
  { name: "Meridian" },
  { name: "Orbit" },
];

// Eight service lines — first row (4 up), second row (3 up)
const useCasesTop = [
  { label: "IT Services & Consulting", body: "Custom software development, business process automation, and technical consulting scoped to your actual roadmap.", bg: "#cdbef5", blob: "#7f52bf" },
  { label: "Perfex CRM Solutions", body: "Custom modules, multi-tenant SaaS setup, workflow automation, and integrations built on top of Perfex CRM.", bg: "#d7f0ec", blob: "#319393" },
  { label: "Web Application Development", body: "Laravel and Vue.js platforms, custom business portals, admin panels, and real-time dashboards.", bg: "#dcefe9", blob: "#c8d5bb" },
  { label: "Mobile App Development", body: "Flutter apps for Android and iOS, CRM companion apps, and business automation on the go.", bg: "#cbd8f5", blob: "#659cff" },
];
const useCasesBottom = [
  { label: "SaaS Solutions", body: "Multi-tenant architecture, subscription and payment systems, tenant management, and custom SaaS dashboards.", bg: "#cdbef5", blob: "#7f52bf" },
  { label: "Business Integrations", body: "WhatsApp, IP telephony, payment gateways, and third-party APIs wired into automated workflows and notifications.", bg: "#d7f0ec", blob: "#319393" },
  { label: "DevOps, Cloud & Infrastructure", body: "Docker, Jenkins, GitHub Actions, Coolify, and aaPanel—plus domains, SSL, email, and hosting handled end to end.", bg: "#cbd8f5", blob: "#659cff" },
];

const benefits = [
  { label: "Reclaim real hours", body: "Teams get back the hours lost to manual work and disconnected tools—hours that go straight back into higher-value output." },
  { label: "Ship without the guesswork", body: "We scope, build, and test against your real data and workflows, so what launches is what your team actually needs." },
  { label: "Keep control of every system", body: "Every integration and automation runs inside permissions and guardrails your team sets and reviews." },
  { label: "Prove the value", body: "Track hours saved, tickets resolved, and uptime for every system we ship and support." },
];

const loopSteps = [
  { title: "Discover your workflow", body: "Map the manual steps, tools, and data behind the process worth building for." },
  { title: "Scope the system", body: "Define exactly what it does, what it integrates with, and who owns what." },
  { title: "Build on proven stacks", body: "Engineer the CRM, web app, or SaaS platform on Laravel, Vue, or Flutter—built against your APIs and edge cases." },
  { title: "Test before it ships", body: "Run it against real scenarios and your team's review before it ever reaches production." },
  { title: "Deploy and support", body: "Ship it with CI/CD, monitor it in production, and stay on as your DevOps and support partner." },
];

const footerCols = [
  {
    title: "",
    links: [
      "Services",
      "Pricing",
      "Case Studies",
      "About us",
      "Privacy Policy",
      "Terms of Service",
    ],
  },
];
---

<Layout title="Rakebig Services — IT Services | Consulting | Perfex CRM SaaS Solutions">
  <SiteHeader current="product" />

  <main>
    <!-- ============ HERO ============ -->
    <section class="phero">
      <div class="phero__panel">
        <div class="phero__panel-bg" aria-hidden="true">
          <span class="phero__blob phero__blob--1"></span>
          <span class="phero__blob phero__blob--2"></span>
          <span class="phero__blob phero__blob--3"></span>
          <img class="phero__noise" src="/assets/cymatic-pattern-1757619368429-1920x1438-3.png" alt="" />
        </div>
        <div class="phero__card reveal">
          <AiCard />
        </div>
      </div>
      <div class="container phero__inner">
        <div class="phero__text reveal-stagger">
          <span class="eyebrow eyebrow--mark">
            <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
            Services
          </span>
          <h1 class="phero__title">IT services, Perfex CRM,<br />and SaaS—built to fit</h1>
          <p class="phero__desc">
            A generic CRM is just noise. Rakebig builds and customizes the
            systems behind it—your Perfex CRM, your SaaS platform, your
            integrations—so every tool arrives ready to run your business.
          </p>
          <div class="phero__cta">
            <MagneticArrowCta label="Book a Consultation" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ LOGO STRIP ============ -->
    <section class="lstrip">
      <div class="lstrip__grid reveal-stagger">
        {heroLogos.map((l) => (
          <div class="lstrip__cell glow-follow" data-glow-rest="center">
            <span class="glow-follow__blob" aria-hidden="true"></span>
            <span class="lstrip__logo lstrip__wordmark">{l.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ PANEL SPLITS ============ -->
    <section class="splits">
      <div class="container splits__inner reveal-stagger">
        <PanelSplit
          eyebrow="Customize"
          title="Perfex CRM built around your sales process"
          body="A default CRM install is just a starting point. Rakebig customizes Perfex CRM end to end—custom modules, workflow automation, and multi-tenant SaaS setup—so it matches how your team actually sells and supports."
          panelBg="#cee2f2"
          panelBlob="#659cff"
        />
        <PanelSplit
          eyebrow="Architect"
          title="SaaS platforms architected to scale"
          body="Define what matters to you—tenants, billing, roles, dashboards—and Rakebig architects the multi-tenant SaaS platform around them, built on Laravel and Vue for the long run."
          reverse={true}
          panelBg="#eddfff"
          panelBlob="#7f52bf"
        />
      </div>
    </section>

    <!-- ============ SERVICES GRID ============ -->
    <section class="usecases">
      <div class="container">
        <div class="usecases__head reveal">
          <span class="eyebrow eyebrow--mark">
            <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
              <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Services
          </span>
          <h2 class="usecases__title">Seven ways we plug into your business.<br />One team behind all of them.</h2>
          <p class="usecases__sub">
            Rakebig covers the full stack behind your business—CRM, software,
            integrations, and the infrastructure that keeps it running.
          </p>
        </div>

        <div class="usecases__grid usecases__grid--4 reveal-stagger">
          {useCasesTop.map((c) => (
            <UseCaseCard label={c.label} body={c.body} bg={c.bg} blob={c.blob} />
          ))}
        </div>
        <div class="usecases__grid usecases__grid--3 reveal-stagger">
          {useCasesBottom.map((c) => (
            <UseCaseCard label={c.label} body={c.body} bg={c.bg} blob={c.blob} wide={true} />
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CUSTOMER STORY ============ -->
    <section class="cstory">
      <div class="cstory__bg" aria-hidden="true"></div>
      <div class="container cstory__inner reveal-stagger">
        <span class="eyebrow eyebrow--mark cstory__eyebrow">
          <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
            <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          Customer story
        </span>
        <blockquote class="cstory__quote">
          “Rakebig didn't hand us a deck—they customized our Perfex CRM to
          match our actual order process and wired WhatsApp straight into
          it. Ops stopped juggling four tools and started working from one
          screen.”
        </blockquote>
        <div class="cstory__foot">
          <div class="cstory__author">
            <img class="cstory__avatar" src="/assets/rectangle-240664309.png" alt="Priya Anand" />
            <div class="cstory__meta">
              <span class="cstory__name">Priya Anand</span>
              <span class="cstory__role">VP of Operations,</span>
            </div>
          </div>
          <span class="cstory__company">Northbeam Retail</span>
        </div>
        <div class="cstory__cta">
          <PrimaryButton
            label="See how Northbeam Retail runs on Rakebig"
            bg="#ffffff"
            glow="rgba(206, 226, 242, 0.9)"
          />
        </div>
      </div>
    </section>

    <!-- ============ KEY BENEFITS ============ -->
    <section class="benefits">
      <div class="container">
        <div class="benefits__head reveal">
          <span class="eyebrow eyebrow--mark">
            <svg class="tkt" viewBox="0 0 22 16" fill="none" aria-hidden="true">
              <path d="M2 4.5A1.5 1.5 0 013.5 3h15A1.5 1.5 0 0120 4.5v1a1.5 1.5 0 000 3v2A1.5 1.5 0 0118.5 12h-15A1.5 1.5 0 012 10.5v-2a1.5 1.5 0 000-3v-1z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8.5 6.3l5 3.4M13.5 6.3l-5 3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Why Rakebig
          </span>
          <h2 class="benefits__title">What a system built to fit earns you</h2>
          <p class="benefits__sub">
            Every system we build pays out twice—hours back for your team,
            and infrastructure that keeps compounding.
          </p>
        </div>

        <div class="benefits__grid reveal-stagger">
          {benefits.map((b) => (
            <div class="benefit">
              <span class="benefit__label eyebrow">
                <img class="ring-mark" src="/assets/frame.svg" alt="" width="24" height="24" />
                {b.label}
              </span>
              <p class="benefit__body">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ HOW RAKEBIG DELIVERS ============ -->
    <section class="loop">
      <div class="loop__bg" aria-hidden="true"></div>
      <div class="container">
        <div class="loop__head reveal">
          <h2 class="loop__title">How Rakebig delivers a project</h2>
          <p class="loop__sub">
            From first workshop to a system your team owns, Rakebig handles
            the engineering—and you stay in control of every decision along
            the way.
          </p>
        </div>

        <div class="loop__grid reveal-stagger">
          <div class="loop__visual">
            <ProductPanel bg="#c5eeef" blob="#c8d5bb" patternOpacity={0.5} />
          </div>
          <ul class="loop__list" data-loop>
            {loopSteps.map((s, i) => (
              <li class={`loop__item ${i === 0 ? "is-open" : ""}`}>
                <button class="loop__row" type="button" data-i={i} aria-expanded={i === 0 ? "true" : "false"}>
                  <span class="loop__num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="loop__label">{s.title}</span>
                </button>
                <div class="loop__panel">
                  <div class="loop__panel-inner">
                    <p>{s.body}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ PANEL SPLITS (repeat) ============ -->
    <section class="splits splits--tail">
      <div class="container splits__inner reveal-stagger">
        <PanelSplit
          eyebrow="Connect"
          title="Every channel wired into one system"
          body="WhatsApp, IP calling, payment gateways, and third-party APIs—Rakebig connects them all into your CRM or SaaS platform, so no channel runs in a silo."
          panelBg="#cee2f2"
          panelBlob="#659cff"
        />
        <PanelSplit
          eyebrow="Deploy"
          title="From workshop to production, on your timeline"
          body="When a system is ready, Rakebig deploys it with Docker, Jenkins, or GitHub Actions, sets up your domains and SSL, and stays on to monitor how it performs in the real world."
          reverse={true}
          panelBg="#eddfff"
          panelBlob="#7f52bf"
        />
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
      <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
      <div class="cta__noise" aria-hidden="true"></div>
      <div class="container cta__inner reveal-stagger">
        <h2 class="cta__title">Get your systems built right this quarter.</h2>
        <p class="cta__sub">
          Growing companies run their CRM, SaaS, and internal tools on
          Rakebig.
        </p>
        <div class="cta__btn"><MagneticArrowCta label="Book a Consultation" /></div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="container footer__inner reveal">
      <a href="/" class="wordmark footer__brand">
        <svg class="wordmark__mark" viewBox="0 0 22 22" aria-hidden="true">
          <rect width="22" height="22" rx="6" fill="currentColor" />
          <text x="11" y="12" text-anchor="middle" dominant-baseline="central" font-family="var(--font-display)" font-size="13" font-weight="500" fill="#ffffff">R</text>
        </svg>
        Rakebig
      </a>
      <div class="footer__cols">
        {footerCols.map((col) => (
          <div class="footer__col">
            {col.title && <p class="footer__col-title eyebrow">{col.title}</p>}
            <ul>
              {col.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Loop accordion: open one step at a time; first is open by default.
  document.querySelectorAll<HTMLElement>("[data-loop]").forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".loop__item"));
    const rows = Array.from(list.querySelectorAll<HTMLElement>(".loop__row"));
    const open = (i: number) => {
      items.forEach((it, j) => {
        const isOpen = j === i;
        it.classList.toggle("is-open", isOpen);
        it.querySelector(".loop__row")?.setAttribute("aria-expanded", String(isOpen));
      });
    };
    rows.forEach((row, i) => row.addEventListener("click", () => open(i)));
  });
</script>

<style>
  /* ---------- shared eyebrow marker ---------- */
  .eyebrow--mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eyebrow--mark .tkt { width: 20px; height: 14px; color: rgba(12, 14, 28, 0.55); flex-shrink: 0; }

  /* ---------- HERO ---------- */
  .phero {
    position: relative;
    background: #efeef4;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    min-height: max(820px, 90vh);
  }
  /* Full-bleed gradient panel on the right — no white frame, bleeds to the
     right viewport edge. The static AI card floats centred inside it. */
  .phero__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50vw;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .phero__panel-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 30%, #e9defb 0%, transparent 70%),
      radial-gradient(70% 55% at 45% 105%, #d6c5f2 0%, transparent 70%),
      linear-gradient(160deg, #ddd0f6 0%, #d2c1ef 55%, #cbb9ec 100%);
  }
  .phero__blob { position: absolute; border-radius: 50%; filter: blur(120px); }
  .phero__blob--1 { width: 60%; height: 55%; top: 4%; left: 8%; background: #e7dcfa; opacity: 0.8; }
  .phero__blob--2 { width: 55%; height: 55%; bottom: -10%; right: -8%; background: #c7b4ee; opacity: 0.7; }
  .phero__blob--3 { width: 40%; height: 40%; top: 30%; right: 22%; background: #efe7fc; opacity: 0.55; }
  .phero__noise {
    position: absolute;
    top: 50%; left: 50%;
    width: 150%;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    opacity: 0.9;
    pointer-events: none;
  }
  .phero__card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 360px;
    padding: 0 20px;
  }
  .phero__card :global(.ai-card) { max-width: 360px; }
  .phero__inner { position: relative; width: 100%; }
  .phero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
    max-width: 440px;
    padding: 96px 0;
  }
  .phero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .phero__desc {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(12, 14, 28, 0.62);
    max-width: 400px;
  }
  .phero__cta { margin-top: 4px; }

  /* ---------- LOGO STRIP ---------- */
  .lstrip { border-bottom: 1px solid var(--color-line); }
  .lstrip__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .lstrip__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px;
    border-right: 1px solid var(--color-line);
    --glow-color: rgba(206, 226, 242, 0.9);
    --glow-size: 150px;
  }
  .lstrip__cell:last-child { border-right: none; }
  .lstrip__cell .glow-follow__blob { z-index: 0; opacity: 0; transition: transform 0.3s ease-out, opacity 0.25s ease; }
  .lstrip__cell:hover .glow-follow__blob { opacity: 1; }
  .lstrip__logo { position: relative; z-index: 1; opacity: 0.55; max-width: 100%; transition: opacity 0.2s ease; }
  .lstrip__cell:hover .lstrip__logo { opacity: 0.85; }
  .lstrip__wordmark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  /* ---------- PANEL SPLITS ---------- */
  .splits { padding: 112px 0; }
  .splits--tail { padding-top: 40px; }
  .splits__inner { display: flex; flex-direction: column; gap: 128px; }

  /* ---------- SERVICES GRID ---------- */
  .usecases { padding: 40px 0 112px; }
  .usecases__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 560px;
    margin-bottom: 48px;
  }
  .usecases__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .usecases__sub { font-size: 14px; line-height: 1.5; color: rgba(12, 14, 28, 0.6); max-width: 440px; }
  .usecases__grid { display: grid; gap: 8px; }
  .usecases__grid--4 { grid-template-columns: repeat(4, 1fr); margin-bottom: 8px; }
  .usecases__grid--3 { grid-template-columns: repeat(3, 1fr); }

  /* ---------- CUSTOMER STORY ---------- */
  .cstory {
    position: relative;
    overflow: hidden;
    padding: 128px 0;
  }
  .cstory__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 12% 40%, rgba(206, 226, 242, 0.55), transparent 60%),
      radial-gradient(55% 90% at 92% 60%, rgba(206, 226, 242, 0.45), transparent 60%),
      linear-gradient(180deg, #fff 0%, #eef3fa 45%, #fff 100%);
    pointer-events: none;
  }
  .cstory__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    max-width: 900px;
  }
  .cstory__eyebrow { color: rgba(12, 14, 28, 0.55); }
  .cstory__quote {
    font-family: var(--font-body);
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: #2b2f42;
    max-width: 820px;
  }
  .cstory__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 820px;
  }
  .cstory__author { display: flex; align-items: center; gap: 14px; }
  .cstory__avatar { width: 44px; height: 44px; border-radius: 4px; object-fit: cover; }
  .cstory__meta { display: flex; flex-direction: column; gap: 2px; }
  .cstory__name { font-size: 16px; font-weight: 500; color: var(--color-ink); }
  .cstory__role { font-size: 14px; color: rgba(12, 14, 28, 0.55); }
  .cstory__company { font-size: 18px; color: var(--color-ink); letter-spacing: -0.01em; white-space: nowrap; }
  /* the CTA is a PrimaryButton; widen its gap so the arrow sits at the far right */
  .cstory__cta :global(.pbtn) {
    gap: 40px;
    padding: 16px 20px;
    font-size: 15px;
    box-shadow: 0 2px 10px rgba(12, 14, 28, 0.06);
  }

  /* ---------- KEY BENEFITS ---------- */
  .benefits { padding: 112px 0; }
  .benefits__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 560px;
    margin-bottom: 48px;
  }
  .benefits__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .benefits__sub { font-size: 14px; line-height: 1.5; color: rgba(12, 14, 28, 0.6); max-width: 440px; }
  .benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: rgba(12, 14, 28, 0.015);
    border: 1px solid var(--color-line);
  }
  .benefit {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 28px 32px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .benefit:nth-child(2n) { border-right: none; }
  .benefit:nth-last-child(-n + 2) { border-bottom: none; }
  .benefit__label { display: inline-flex; align-items: center; gap: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink); }
  .benefit__body { font-size: 15px; line-height: 1.45; color: rgba(12, 14, 28, 0.6); }

  /* ---------- HOW RAKEBIG DELIVERS ---------- */
  .loop {
    position: relative;
    overflow: hidden;
    padding: 112px 0;
  }
