---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import { SITE_NAME, SITE_URL, SUPPORT_EMAIL, SUPPORT_PHONE, TECH_SUPPORT_PHONE, BOOK_CONSULTATION_URL } from "../consts";

const lastUpdated = "March 21, 2026";
const effectiveDate = "January 1, 2026";

const pageTitle = `Cancellation & Refund Policy | ${SITE_NAME}`;
const pageDescription =
  "Official Cancellation and Refund Policy of Rakebig Services — clear guidelines for software projects, Perfex CRM modules, monthly retainers, and Razorpay refund turnaround.";

const sections = [
  { id: "overview", title: "1. Policy Overview" },
  { id: "digital-nature", title: "2. Nature of Digital & Custom Services" },
  { id: "cancellation", title: "3. Project Cancellation Terms" },
  { id: "refund-eligibility", title: "4. Refund Eligibility & Milestone Guidelines" },
  { id: "retainers", title: "5. Retainers, Subscriptions & Dedicated Squads" },
  { id: "razorpay-process", title: "6. Razorpay Refund Processing & Turnaround" },
  { id: "disputes", title: "7. Raising Disputes & Chargebacks" },
  { id: "contact-support", title: "8. How to Request a Cancellation or Refund" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/refund"
>
  <SiteHeader />

  <main class="legal-page">
    <!-- ============ HERO ============ -->
    <header class="legal-hero">
      <div class="container legal-hero__inner">
        <nav class="legal-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Cancellation & Refund Policy</li>
          </ol>
        </nav>

        <div class="legal-hero__badge">
          <span class="legal-chip">Billing Policy</span>
          <span class="legal-badge-dot" aria-hidden="true"></span>
          <span class="legal-meta-text">Merchant Verified & Razorpay Compliant</span>
        </div>

        <h1 class="legal-hero__title">Cancellation & Refund Policy</h1>
        <p class="legal-hero__lead">
          We believe in transparent, honest commercial relationships. This policy details our cancellation procedures,
          refund criteria, and automated settlement timelines for services provided by <strong>{SITE_NAME}</strong>.
        </p>

        <div class="legal-meta-bar">
          <div class="legal-meta-item">
            <span class="legal-meta-label">Effective Date</span>
            <span class="legal-meta-value">{effectiveDate}</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Last Updated</span>
            <span class="legal-meta-value">{lastUpdated}</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Refund Settlement</span>
            <span class="legal-meta-value">5–7 Business Days</span>
          </div>
          <div class="legal-meta-item">
            <span class="legal-meta-label">Payment Gateway</span>
            <span class="legal-meta-value">Razorpay Source Credit</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ============ BODY / CONTENT ============ -->
    <section class="legal-content">
      <div class="container legal-layout">
        <!-- Sticky Sidebar -->
        <aside class="legal-sidebar">
          <div class="legal-toc-card">
            <h2 class="legal-toc-title">Policy Directory</h2>
            <ul class="legal-toc-list">
              {sections.map((sec) => (
                <li>
                  <a href={`#${sec.id}`} class="legal-toc-link">
                    {sec.title}
                  </a>
                </li>
              ))}
            </ul>

            <div class="legal-toc-cta">
              <p>Need urgent assistance with an invoice or billing query?</p>
              <a href={`mailto:${SUPPORT_EMAIL}`} class="legal-toc-btn">
                Contact Billing Team
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Prose -->
        <article class="legal-prose">
          <!-- 1. OVERVIEW -->
          <section id="overview" class="legal-section">
            <h2>1. Policy Overview</h2>
            <p>
              At <strong>{SITE_NAME}</strong> (<strong>{SITE_URL}</strong>), we provide high-caliber custom software engineering,
              Perfex CRM solutions, web/mobile app development, AI automation workflows, and cloud DevOps infrastructure.
            </p>
            <p>
              Because our solutions are built to order against specific architectural requirements, we establish clear, fair
              milestone-based contracts. This Cancellation and Refund Policy forms an integral part of our
              <a href="/terms">Terms & Conditions</a>.
            </p>
          </section>

          <!-- 2. DIGITAL NATURE -->
          <section id="digital-nature" class="legal-section">
            <h2>2. Nature of Digital & Custom Services</h2>
            <p>
              All deliverables furnished by {SITE_NAME} consist of intangible electronic assets, specialized engineering labor,
              custom architectural designs, and software source code delivered electronically.
            </p>
            <ul>
              <li><strong>No Physical Shipping:</strong> We do not produce or deliver physical goods. All deliveries are made electronically via Git repositories, cloud deployments, or encrypted digital links.</li>
              <li><strong>Irrevocable Engineering Work:</strong> Software development involves dedicated engineering time and computing resources allocated specifically to your project. Therefore, work performed and approved milestones are non-refundable once delivered.</li>
            </ul>
          </section>

          <!-- 3. PROJECT CANCELLATION -->
          <section id="cancellation" class="legal-section">
            <h2>3. Project Cancellation Terms</h2>
            <p>
              Clients may request project cancellation under the following conditions:
            </p>

            <div class="legal-callout legal-callout--blue">
              <div class="legal-callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="15" y1="9" x2="9" y2="15" stroke="currentColor" stroke-width="2"/><line x1="9" y1="9" x2="15" y2="15" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div class="legal-callout__body">
                <strong>How to Cancel a Project</strong>
                <p>
                  Cancellation requests must be formally submitted in writing via email to <strong>{SUPPORT_EMAIL}</strong>
                  stating your Project Reference ID, invoice number, and rationale for cancellation.
                </p>
              </div>
            </div>

            <ul>
              <li><strong>Cancellation Prior to Work Kickoff:</strong> If a Client requests cancellation within forty-eight (48) hours of contract signing and before any technical onboarding, architectural scoping, or coding has commenced, the Client is entitled to a <strong>100% refund</strong> of the deposit paid, minus any non-refundable banking/payment processing fees incurred.</li>
              <li><strong>Cancellation During Active Sprints:</strong> If cancellation occurs after work has commenced, {SITE_NAME} will calculate the prorated value of completed deliverables, committed developer hours, and third-party provisioning costs. Any unutilized portion of the advance deposit will be refunded.</li>
              <li><strong>Delivered & Accepted Milestones:</strong> Once a functional milestone has been reviewed, deployed to staging/production, or signed off by the Client, payments allocated to that milestone are fully earned and non-refundable.</li>
            </ul>
          </section>

          <!-- 4. REFUND ELIGIBILITY -->
          <section id="refund-eligibility" class="legal-section">
            <h2>4. Refund Eligibility & Milestone Guidelines</h2>
            <p>
              To ensure fairness for both parties, refund requests are evaluated according to the following criteria:
            </p>

            <div class="legal-table-wrap">
              <table class="legal-table">
                <thead>
                  <tr>
                    <th>Service Scenario</th>
                    <th>Eligibility Status</th>
                    <th>Resolution Window</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Pre-Kickoff Cancellation</strong></td>
                    <td>100% Refund (minus payment gateway fees)</td>
                    <td>Within 48 hours of payment</td>
                  </tr>
                  <tr>
                    <td><strong>In-Flight Milestone Cancellation</strong></td>
                    <td>Prorated Refund of unearned deposit balance</td>
                    <td>Within 5–7 business days</td>
                  </tr>
                  <tr>
                    <td><strong>Approved & Delivered Code</strong></td>
                    <td>Non-refundable (covered by 30-day bug warranty)</td>
                    <td>Remedied via warranty fixes</td>
                  </tr>
                  <tr>
                    <td><strong>Duplicate or Erroneous Transaction</strong></td>
                    <td>100% Full Refund via Razorpay</td>
                    <td>Reported within 7 calendar days</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 5. RETAINERS & DEDICATED SQUADS -->
          <section id="retainers" class="legal-section">
            <h2>5. Retainers, Subscriptions & Dedicated Squads</h2>
            <p>
              For ongoing maintenance agreements, DevOps retainers, and dedicated developer teams:
            </p>
            <ul>
              <li><strong>Notice Period:</strong> Maintenance retainers and dedicated team subscriptions may be cancelled with fourteen (14) calendar days' written notice prior to the start of the subsequent monthly billing cycle.</li>
              <li><strong>Current Billing Period:</strong> Retainer fees for the currently active billing cycle are non-refundable once the cycle has begun, as engineering availability and server monitoring resources are reserved exclusively for the Client.</li>
              <li><strong>AI Widget Subscription:</strong> Subscriptions for our hosted AI Widget service can be cancelled at any time through your customer portal, effective at the end of the current billing month.</li>
            </ul>
          </section>

          <!-- 6. RAZORPAY REFUND PROCESSING -->
          <section id="razorpay-process" class="legal-section">
            <h2>6. Razorpay Refund Processing & Turnaround</h2>
            <p>
              All approved refunds are handled through our integrated payment infrastructure:
            </p>

            <div class="legal-callout legal-callout--purple">
              <div class="legal-callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><rect x="1" y="4" width="22" height="16" rx="2" stroke="currentColor" stroke-width="2"/><line x1="1" y1="10" x2="23" y2="10" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div class="legal-callout__body">
                <strong>Razorpay Direct-to-Source Settlement</strong>
                <p>
                  Whenever a refund is authorized by {SITE_NAME}, the transaction is routed directly back to the original payment source
                  (e.g., your bank account, credit/debit card, or UPI VPA) via <strong>Razorpay</strong>.
                </p>
                <p>
                  <strong>Settlement Timeline:</strong> The refund will typically reflect in your account within <strong>5 to 7 business days</strong>,
                  depending on your bank's clearance cycles.
                </p>
              </div>
            </div>

            <ul>
              <li><strong>UPI Payments:</strong> Refunds for payments made via Google Pay, PhonePe, Paytm, or BHIM are typically credited within 24 to 48 banking hours.</li>
              <li><strong>Credit / Debit Cards:</strong> Refunds for Visa, Mastercard, RuPay, or Amex card transactions typically appear on your statement within 5 to 7 working days.</li>
              <li><strong>Net Banking:</strong> Direct bank account transfers generally settle within 3 to 7 working days as governed by the respective bank's clearing process.</li>
            </ul>
          </section>

          <!-- 7. DISPUTES & CHARGEBACKS -->
          <section id="disputes" class="legal-section">
            <h2>7. Raising Disputes & Chargebacks</h2>
            <p>
              We encourage open communication and proactive dispute resolution. If you have an issue with any deliverable, timeline, or invoice:
            </p>
            <ol>
              <li>Contact our billing desk at <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> before initiating a bank chargeback.</li>
              <li>Our project management and billing directors will review your ticket and schedule a resolution call within forty-eight (48) hours.</li>
              <li>If work does not conform to the written SOW specifications, we will either remediate the deliverables under our warranty policy or issue an agreed adjustment credit.</li>
            </ol>
          </section>

          <!-- 8. CONTACT SUPPORT -->
          <section id="contact-support" class="legal-section">
            <h2>8. How to Request a Cancellation or Refund</h2>
            <p>
              To initiate an inquiry or submit a formal cancellation request, please contact our billing department:
            </p>

            <div class="legal-contact-card">
              <div class="legal-contact-row">
                <span class="legal-contact-k">Brand Name:</span>
                <span class="legal-contact-v">{SITE_NAME}</span>
              </div>
              <div class="legal-contact-row">
                <span class="legal-contact-k">Billing & Refund Email:</span>
                <span class="legal-contact-v"><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></span>
              </div>
              <div class="legal-contact-row">
                <span class="legal-contact-k">Direct Telephone:</span>
                <span class="legal-contact-v"><a href={`tel:${SUPPORT_PHONE.replace(/[^0-9+]/g, '')}`}>{SUPPORT_PHONE}</a></span>
              </div>
              <div class="legal-contact-row">
                <span class="legal-contact-k">Tech Support Helpline:</span>
                <span class="legal-contact-v"><a href={`tel:${TECH_SUPPORT_PHONE.replace(/[^0-9+]/g, '')}`}>{TECH_SUPPORT_PHONE}</a> (Mon–Sat, 10–7 IST)</span>
              </div>
              <div class="legal-contact-row">
                <span class="legal-contact-k">Response Guarantee:</span>
                <span class="legal-contact-v">Within 24–48 business hours</span>
              </div>
              <div class="legal-contact-row">
                <span class="legal-contact-k">Required Information:</span>
                <span class="legal-contact-v">Invoice Number, Razorpay Payment ID, and Reason for Request</span>
              </div>
            </div>
          </section>
        </article>
      </div>
    </section>

    <!-- ============ BOTTOM CTA ============ -->
    <section class="legal-bottom-cta">
      <div class="container legal-bottom-cta__inner reveal">
        <h2>Questions about billing or milestone structures?</h2>
        <p>Book a free consultation and get a clearly scoped, fixed-price quote with transparent terms.</p>
        <div class="legal-bottom-cta__actions">
          <PrimaryButton label="Book a consultation" href={BOOK_CONSULTATION_URL} bg="#0c0e1c" color="#ffffff" />
          <a href="/terms" class="legal-ghost-link">View Terms & Conditions →</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Aligned with terms & privacy layout */
  .legal-page { background: #ffffff; color: var(--color-ink); }

  .legal-hero {
    padding: 48px 0 64px;
    background: radial-gradient(85% 120% at 100% 0%, #feece8 0%, transparent 60%),
                linear-gradient(180deg, #fdf4f2 0%, #ffffff 100%);
    border-bottom: 1px solid var(--color-line);
  }

  .legal-hero__inner { max-width: 920px; }

  .legal-crumbs ol {
    display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 20px; padding: 0; font-size: 13px; color: rgba(12, 14, 28, 0.55);
  }
  .legal-crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .legal-crumbs li + li::before { content: "/"; color: rgba(12, 14, 28, 0.3); }
  .legal-crumbs a { color: rgba(12, 14, 28, 0.65); text-decoration: none; transition: color 0.15s ease; }
  .legal-crumbs a:hover { color: var(--color-ink); }
  .legal-crumbs li[aria-current] { color: rgba(12, 14, 28, 0.9); font-weight: 500; }

  .legal-hero__badge { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 18px; }

  .legal-chip {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: #b3391b; background: rgba(230, 126, 34, 0.12); border: 1px solid rgba(230, 126, 34, 0.35); padding: 5px 10px; border-radius: 6px;
  }

  .legal-badge-dot { width: 4px; height: 4px; border-radius: 50%; background: #e67e22; }
  .legal-meta-text { font-size: 12.5px; font-weight: 500; color: #3b4256; }

  .legal-hero__title {
    font-family: var(--font-display); font-size: clamp(36px, 4.5vw, 54px); font-weight: 400; line-height: 1.1; letter-spacing: -0.025em; color: var(--color-ink); margin: 0 0 18px;
  }

  .legal-hero__lead {
    font-size: clamp(16px, 1.8vw, 18.5px); line-height: 1.6; color: #4b5568; margin: 0 0 32px; max-width: 760px;
  }
  .legal-hero__lead strong { color: var(--color-ink); }

  .legal-meta-bar {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; padding: 18px 24px;
    background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(12, 14, 28, 0.08); border-radius: 12px; box-shadow: 0 4px 20px -8px rgba(12, 14, 28, 0.05);
  }

  .legal-meta-item { display: flex; flex-direction: column; gap: 4px; }
  .legal-meta-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #718096; }
  .legal-meta-value { font-size: 13.5px; font-weight: 600; color: var(--color-ink); }

  /* Content Layout */
  .legal-content { padding: 72px 0 96px; }
  .legal-layout { display: grid; grid-template-columns: 280px 1fr; gap: 56px; align-items: flex-start; }

  .legal-sidebar { position: sticky; top: 96px; }
  .legal-toc-card { background: #fafafc; border: 1px solid var(--color-line); border-radius: 16px; padding: 24px; }
  .legal-toc-title { font-family: var(--font-body); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin: 0 0 16px; }
  .legal-toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .legal-toc-link { font-size: 13.5px; color: #4a5568; text-decoration: none; display: block; padding: 4px 0; line-height: 1.4; transition: color 0.15s ease, transform 0.15s ease; }
  .legal-toc-link:hover { color: #2f6bff; transform: translateX(3px); }
  .legal-toc-cta { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--color-line); }
  .legal-toc-cta p { font-size: 12.5px; color: #64748b; line-height: 1.5; margin: 0 0 12px; }
  .legal-toc-btn { display: inline-block; width: 100%; text-align: center; font-size: 12.5px; font-weight: 600; color: #2f6bff; background: #eef3ff; border: 1px solid rgba(47, 107, 255, 0.25); padding: 8px 12px; border-radius: 8px; text-decoration: none; transition: background 0.15s ease, color 0.15s ease; }
  .legal-toc-btn:hover { background: #2f6bff; color: #ffffff; }

  .legal-prose { max-width: 820px; }
  .legal-section { padding-bottom: 48px; margin-bottom: 48px; border-bottom: 1px solid var(--color-line); scroll-margin-top: 110px; }
  .legal-section:last-of-type { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .legal-section h2 { font-family: var(--font-display); font-size: clamp(24px, 2.6vw, 30px); font-weight: 400; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 18px; }
  .legal-prose p { font-size: 15.5px; line-height: 1.7; color: #3f4756; margin: 0 0 18px; }
  .legal-prose a { color: #2f6bff; text-decoration: underline; text-underline-offset: 3px; transition: color 0.15s ease; }
  .legal-prose a:hover { color: #1948b8; }
  .legal-prose ul, .legal-prose ol { margin: 0 0 20px; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; }
  .legal-prose li { font-size: 15px; line-height: 1.65; color: #3f4756; }
  .legal-prose li strong { color: var(--color-ink); }

  /* Table styling */
  .legal-table-wrap { overflow-x: auto; margin: 24px 0; border: 1px solid var(--color-line); border-radius: 12px; }
  .legal-table { width: 100%; border-collapse: collapse; font-size: 14px; text-align: left; }
  .legal-table th { background: #f8fafc; padding: 12px 16px; font-weight: 600; color: #475569; border-bottom: 1px solid var(--color-line); }
  .legal-table td { padding: 14px 16px; border-bottom: 1px solid var(--color-line); color: #334155; line-height: 1.5; }
  .legal-table tr:last-child td { border-bottom: none; }

  /* Callouts */
  .legal-callout { display: flex; gap: 16px; padding: 20px 22px; border-radius: 14px; margin: 24px 0; }
  .legal-callout--blue { background: #f0f5ff; border: 1px solid #c7dcff; color: #1a365d; }
  .legal-callout--purple { background: #f7f3ff; border: 1px solid #dec7ff; color: #321d5a; }
  .legal-callout__icon { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: #ffffff; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); }
  .legal-callout--blue .legal-callout__icon { color: #2f6bff; }
  .legal-callout--purple .legal-callout__icon { color: #7f52bf; }
  .legal-callout__icon svg { width: 18px; height: 18px; }
  .legal-callout__body { display: grid; gap: 6px; }
  .legal-callout__body strong { font-size: 14.5px; font-weight: 700; }
  .legal-callout__body p { font-size: 13.5px; line-height: 1.55; margin: 0; color: inherit; opacity: 0.9; }

  /* Contact Card */
  .legal-contact-card { display: grid; gap: 10px; padding: 22px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin-top: 18px; }
  .legal-contact-row { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 14.5px; }
  .legal-contact-k { font-weight: 600; color: #475569; min-width: 180px; }
  .legal-contact-v { color: var(--color-ink); }

  /* Bottom CTA */
  .legal-bottom-cta { padding: 80px 0; background: #fbfafc; border-top: 1px solid var(--color-line); }
  .legal-bottom-cta__inner { max-width: 720px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .legal-bottom-cta h2 { font-family: var(--font-display); font-size: clamp(28px, 3.5vw, 40px); font-weight: 400; letter-spacing: -0.02em; margin: 0; color: var(--color-ink); }
  .legal-bottom-cta p { font-size: 16px; color: #64748b; margin: 0 0 10px; max-width: 540px; line-height: 1.6; }
  .legal-bottom-cta__actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; justify-content: center; }
  .legal-ghost-link { font-size: 14.5px; font-weight: 600; color: var(--color-ink); text-decoration: none; padding: 10px 18px; border-radius: 8px; transition: color 0.15s ease, background 0.15s ease; }
  .legal-ghost-link:hover { background: #ebebeb; color: #000; }

  @media (max-width: 990px) {
    .legal-layout { grid-template-columns: 1fr; gap: 40px; }
    .legal-sidebar { position: static; }
    .legal-toc-card { max-height: 300px; overflow-y: auto; }
  }

  @media (max-width: 640px) {
    .legal-hero { padding: 32px 0 48px; }
    .legal-meta-bar { grid-template-columns: 1fr 1fr; }
  }
</style>
